@@ -0,0 +1,72 @@
+// perf_stats.h -- measured performance (WINAPK_PERF), off unless asked for.
+//
+// WINAPK_PERF=1 logs one line a second ("[perf] ..."): frame rate and frame
+// times from the app's own swaps, where its frame time went on the host side
+// (the swap itself, the frame cap's wait, waits for the Direct3D 11 GL lock,
+// shader compiles and links, ASTC decodes and their uploads), the process's
+// CPU and its busiest threads by name, and the GPU's 3D engine as Windows
+// counts it for this process. WINAPK_PERF=overlay also shows it on screen.
+//
+// Keys while it is on: F9 shows or hides the overlay; F8 starts a capture and,
+// pressed again (or after WINAPK_PERF_CAPTURE seconds, default 30), ends it with
+// a summary ("[perf] capture #n ..."): average, median, 95th/99th percentile
+// and worst frame time, 1% low, hitches. WINAPK_PERF_CAPTURE_AT=<s> starts one
+// by itself <s> seconds after the first frame (scripted runs).
+// WINAPK_PERF_FILE=<path> appends the lines to that file as well.
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+namespace winapk::host::perf {
+
+enum Counter {
+    kShaderCompile,  // glCompileShader
+    kShaderLink,     // glLinkProgram
+    kProgramBinary,  // glProgramBinary (the app's own shader cache)
+    kAstc,           // ASTC blocks decoded to RGBA (astc_host.cpp)
+    kTexUpload,      // an emulated ASTC upload, decode included
+    kSwap,           // eglSwapBuffers into ANGLE: present, and the GPU's backpressure
+    kCapWait,        // WINAPK_FPS_CAP's wait
+    kVideoPump,      // the video player's draw at the frame's end
+    kCounterCount
+};
+
+bool on();
+uint64_t ticks();  // QueryPerformanceCounter
+void add(Counter c, uint64_t dt_ticks);
+
+struct Scope {
+    explicit Scope(Counter c) : c_(c), t0_(on() ? ticks() : 0) {}
+    ~Scope() {
+        if (t0_) add(c_, ticks() - t0_);
+    }
+    Scope(const Scope&) = delete;
+    Scope& operator=(const Scope&) = delete;
+
+private:
+    Counter c_;
+    uint64_t t0_;
+};
+
+// At each of the app's swaps (render thread, its context current): the frame
+// interval; app_w x app_h is what the app drew, win_w x win_h the window.
+void frame(int app_w, int app_h, int win_w, int win_h);
+
+// The app's swaps to its window so far, counted always (WINAPK_PERF or not):
+// the input side paces gestures by the game's frames.
+void count_swap();
+uint64_t app_swaps();
+
+// The GL renderer and version strings, asked once on the render thread.
+void note_renderer(const char* renderer, const char* version);
+
+// The overlay's text when it is shown (one line per '\n'), and a number that
+// changes whenever the text does.
+bool overlay_shown();
+std::string overlay_text(unsigned* version);
+
+// F9 / F8 from the window; true when taken.
+bool key(unsigned vk);
+
+}  // namespace winapk::host::perf
