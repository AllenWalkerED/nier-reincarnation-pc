-bool code_range(uint64_t pc, uint64_t* lo, uint64_t* hi) {
-    AcquireSRWLockShared(&g_ranges_lock);
-    bool found = false;
-    for (const Range& r : g_ranges) {
-        if (pc >= r.lo && pc < r.hi) {
-            *lo = r.lo;
-            *hi = r.hi;
-            found = true;
-            break;
-        }
-    }
-    ReleaseSRWLockShared(&g_ranges_lock);
-    return found;
-}
