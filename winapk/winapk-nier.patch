+// (VirtualQuery, GetMappedFileName): no loader lock, which the hung thread
+// may hold. Guest code the runtime's own linker mapped is not an image: it is
+// given as its region's base and offset, for the log's load lines.
+bool name_address(uint64_t a, char* out, size_t n, bool code_only) {
+    MEMORY_BASIC_INFORMATION mbi{};
+    if (!a || !VirtualQuery(reinterpret_cast<const void*>(a), &mbi, sizeof(mbi)) || mbi.State != MEM_COMMIT) return false;
+    const DWORD exec = PAGE_EXECUTE | PAGE_EXECUTE_READ | PAGE_EXECUTE_READWRITE | PAGE_EXECUTE_WRITECOPY;
+    if (code_only && !(mbi.Protect & exec)) return false;
+    const auto base = reinterpret_cast<uint64_t>(mbi.AllocationBase);
+    if (mbi.Type == MEM_IMAGE) {
+        wchar_t path[MAX_PATH];
+        const DWORD len = K32GetMappedFileNameW(GetCurrentProcess(), mbi.AllocationBase, path, MAX_PATH);
+        const wchar_t* name = path;
+        for (DWORD i = 0; i < len; ++i) {
+            if (path[i] == L'\\') name = path + i + 1;
+        }
+        char narrow_name[MAX_PATH];
+        size_t k = 0;
+        for (; name < path + len && k + 1 < sizeof narrow_name; ++name) narrow_name[k++] = *name < 128 ? static_cast<char>(*name) : '?';
+        narrow_name[k] = 0;
+        std::snprintf(out, n, "%s+0x%llx", len ? narrow_name : "image", static_cast<unsigned long long>(a - base));
+    } else {
+        std::snprintf(out, n, "code@0x%llx+0x%llx", static_cast<unsigned long long>(base),
+                      static_cast<unsigned long long>(a - base));
+    }
