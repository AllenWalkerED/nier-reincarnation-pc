+    va_start(a, fmt);
+    const int n = std::vsnprintf(buf, sizeof buf - 1, fmt, a);
+    va_end(a);
+    if (n <= 0) return;
+    const DWORD len = static_cast<DWORD>(std::min<int>(n, sizeof buf - 2));
+    buf[len] = '\n';
+    DWORD written = 0;
+    WriteFile(GetStdHandle(STD_ERROR_HANDLE), buf, len + 1, &written, nullptr);
