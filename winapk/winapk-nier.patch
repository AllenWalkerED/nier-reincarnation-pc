+struct SysvCallFrame {
+    uint64_t gpr[6];         // rdi rsi rdx rcx r8 r9
+    uint64_t fpr[8];         // xmm0..xmm7, low 64 bits
+    const uint64_t* stack;   // words for the callee's stack arguments
+    uint64_t nstack;
+    uint64_t rax, rdx, xmm0, xmm1;
