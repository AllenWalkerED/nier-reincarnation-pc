+const jchar* path16_copy(const std::u16string& s, const jchar* original) {
+    jchar* copy = static_cast<jchar*>(std::malloc((s.size() + 1) * sizeof(jchar)));
+    std::memcpy(copy, s.data(), s.size() * sizeof(jchar));
+    copy[s.size()] = 0;
+    std::lock_guard<std::mutex> hold(g_path16_lock);
+    g_path16_copies[copy] = original;
+    return copy;
