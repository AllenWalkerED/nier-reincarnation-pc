+WINAPK_GUEST_ABI const GLubyte * guest_glGetString(GLenum name) {  // hand-written: renderer override, emulated extensions
+    // WINAPK_GL_RENDERER / WINAPK_GL_VENDOR: the strings the app sees instead
+    // of ANGLE's (diagnosis: another GPU's name on this one).
+    if (name == GL_RENDERER || name == GL_VENDOR) {
+        const char* o = std::getenv(name == GL_RENDERER ? "WINAPK_GL_RENDERER" : "WINAPK_GL_VENDOR");
+        if (o && *o) return reinterpret_cast<const GLubyte*>(o);
+    }
+    const GLubyte* s = glGetString(name);
+    if (name != GL_EXTENSIONS || !s || !guest_ext::changed()) return s;
+    return reinterpret_cast<const GLubyte*>(guest_ext::list().joined.c_str());
+}
+WINAPK_GUEST_ABI const GLubyte * guest_glGetStringi(GLenum name, GLuint index) {
+    if (name == GL_EXTENSIONS && guest_ext::changed()) {
+        const auto& names = guest_ext::list().names;
+        return index < names.size() ? reinterpret_cast<const GLubyte*>(names[index].c_str()) : nullptr;
+    }
+    return glGetStringi(name, index);
+}
