+            const DWORD left = spent >= ms ? 0 : static_cast<DWORD>(ms - spent);
+            if (left <= slice) {
+                slice = left;
+                last = true;
+            }
+        }
+        slot.waiting_on.store(addr);
+        if (slot.pending.load()) {
