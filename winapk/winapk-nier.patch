+                std::lock_guard<std::mutex> hold(g_stats_lock);  // interrupt_thread reads the list
+                ts.jits.push_back(std::move(jit));
+            } else {
+                ts.jit_failed = true;
+            }
+        }
+        if (ts.jits_running < ts.jits.size()) {
+            JitEngine& jit = *ts.jits[ts.jits_running];
+            ++ts.jits_running;
+            const bool outer = ts.innermost_jit;
+            ts.innermost_jit = true;
+            jit.run(ts.cpu);
+            ts.innermost_jit = outer;
+            --ts.jits_running;
+            return;
+        }
+    }
+    const bool outer = ts.innermost_jit;
+    ts.innermost_jit = false;
+    run(ts.cpu);
+    ts.innermost_jit = outer;
