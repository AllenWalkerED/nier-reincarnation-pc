+// WINAPK_ANGLE_ADAPTER=nvidia|amd|intel|<hex PCI vendor id>: the adapter
+// ANGLE's Direct3D 11 backend uses, by LUID (EGL_ANGLE_platform_angle_d3d_luid).
+// Without it Windows picks, which on a laptop with two GPUs is the integrated one.
+bool chosen_adapter(LUID* luid) {
+    const char* want = std::getenv("WINAPK_ANGLE_ADAPTER");
+    if (!want || !*want) return false;
+    UINT vendor = std::strcmp(want, "nvidia") == 0  ? 0x10DE
+                  : std::strcmp(want, "amd") == 0   ? 0x1002
+                  : std::strcmp(want, "intel") == 0 ? 0x8086
+                                                    : static_cast<UINT>(std::strtoul(want, nullptr, 16));
+    HMODULE dxgi = LoadLibraryW(L"dxgi.dll");
+    using Create = HRESULT(WINAPI*)(REFIID, void**);
+    auto create = dxgi ? reinterpret_cast<Create>(GetProcAddress(dxgi, "CreateDXGIFactory1")) : nullptr;
+    IDXGIFactory1* factory = nullptr;
+    if (!create || FAILED(create(__uuidof(IDXGIFactory1), reinterpret_cast<void**>(&factory)))) return false;
+    // Of that maker's adapters, the one with the most memory of its own: a PC
+    // with an integrated and a discrete GPU of one maker (a Ryzen APU and a
+    // Radeon card, Intel graphics and an Arc card) lists the integrated first.
+    bool found = false;
+    SIZE_T best = 0;
+    wchar_t name[128] = {};
+    IDXGIAdapter1* adapter = nullptr;
+    for (UINT i = 0; factory->EnumAdapters1(i, &adapter) != DXGI_ERROR_NOT_FOUND; ++i) {
+        DXGI_ADAPTER_DESC1 desc;
+        if (SUCCEEDED(adapter->GetDesc1(&desc)) && desc.VendorId == vendor &&
+            !(desc.Flags & DXGI_ADAPTER_FLAG_SOFTWARE) && (!found || desc.DedicatedVideoMemory > best)) {
+            *luid = desc.AdapterLuid;
+            best = desc.DedicatedVideoMemory;
+            found = true;
+            wcsncpy(name, desc.Description, 127);
+        }
+        adapter->Release();
+    }
+    if (found) std::fprintf(stderr, "[win.apk] GL: ANGLE on adapter %ls (WINAPK_ANGLE_ADAPTER=%s)\n", name, want);
+    factory->Release();
+    if (!found) std::fprintf(stderr, "[win.apk] GL: no adapter matches WINAPK_ANGLE_ADAPTER=%s\n", want);
+    return found;
+}
+
+// Vulkan compatibility (WINAPK_VK_COMPAT): the features newer drivers expose
+// that this ANGLE would use; the player's ANGLE_FEATURE_OVERRIDES_DISABLED
+// and _ENABLED are kept and added to.
+//
+// On the GeForce RTX 50 series (Blackwell) the menus draw and the 3D does
+// not, while the same driver draws both on the RTX 40, 30 and on other GPUs:
+// what fails is what only 3D uses, the depth buffer. So besides the newer
+// features, the depth path goes back to the one ANGLE takes on drivers
+// without them (the guest's side of it is in guest_gl.inc, vk_compat):
+//   * depth/stencil state baked into pipelines, not set dynamically. A
+//     supports* feature alone does not stop it: Vulkan 1.3 has the extended
+//     dynamic state in core, so each use*DynamicState is turned off too;
+//   * GL's [-1, 1] depth range done in the vertex shader instead of by
+//     VK_EXT_depth_clip_control, and no VK_EXT_depth_clamp_zero_one;
+//   * no VK_*_load_store_op_none (the store ops of invalidated or read-only
+//     depth);
+//   * clears inside a render pass drawn, not vkCmdClearAttachments.
+//
+// None of these depth-path parts is on unless asked for with
+// WINAPK_VK_COMPAT_<PART>=1 (vk_compat_part): on an RTX 3060, leaving out
+// depth clip control (CLIP) turned the 3D black, so they are for testing
+// only. The guest's parts are DEPTH32F, INVALIDATE and HIDECLIP (guest_gl.inc).
+const char kVkCompatFeatures[] =
+    "supportsGraphicsPipelineLibrary:supportsHostImageCopy:supportsDynamicRendering:preferDynamicRendering:"
