+
+// The copy's JVM chars (or null when there were none), and true, for a copy.
+bool path16_release(const jchar* chars, const jchar** original) {
+    std::lock_guard<std::mutex> hold(g_path16_lock);
+    auto it = g_path16_copies.find(chars);
