+        return e && e[0] == '1';
+    }();
+    return on;
+}
+
+// FXAA after Timothy Lottes' (NVIDIA) algorithm, the compact form many
+// renderers use: the luma of the four diagonal neighbours finds an edge's
+// direction, and the pixel is blended along it.
+const char kFxaaVertex[] = R"(#version 300 es
+out vec2 uv;
+void main() {
+    vec2 p = vec2(float((gl_VertexID << 1) & 2), float(gl_VertexID & 2));
+    uv = p;
+    gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
+})";
+const char kFxaaFragment[] = R"(#version 300 es
+precision highp float;
+uniform sampler2D frame;
+uniform vec2 texel;
+in vec2 uv;
+out vec4 color;
+const float kReduceMin = 1.0 / 128.0;
+const float kReduceMul = 1.0 / 8.0;
+const float kSpanMax = 8.0;
+void main() {
+    vec3 luma = vec3(0.299, 0.587, 0.114);
+    float nw = dot(texture(frame, uv + vec2(-1.0, -1.0) * texel).rgb, luma);
+    float ne = dot(texture(frame, uv + vec2(1.0, -1.0) * texel).rgb, luma);
+    float sw = dot(texture(frame, uv + vec2(-1.0, 1.0) * texel).rgb, luma);
+    float se = dot(texture(frame, uv + vec2(1.0, 1.0) * texel).rgb, luma);
+    vec4 centre = texture(frame, uv);
+    float m = dot(centre.rgb, luma);
+    float lo = min(m, min(min(nw, ne), min(sw, se)));
+    float hi = max(m, max(max(nw, ne), max(sw, se)));
+    vec2 dir = vec2(-((nw + ne) - (sw + se)), (nw + sw) - (ne + se));
+    float reduce = max((nw + ne + sw + se) * 0.25 * kReduceMul, kReduceMin);
+    float scale = 1.0 / (min(abs(dir.x), abs(dir.y)) + reduce);
+    dir = clamp(dir * scale, vec2(-kSpanMax), vec2(kSpanMax)) * texel;
+    vec3 a = 0.5 * (texture(frame, uv + dir * (1.0 / 3.0 - 0.5)).rgb + texture(frame, uv + dir * (2.0 / 3.0 - 0.5)).rgb);
+    vec3 b = a * 0.5 + 0.25 * (texture(frame, uv - dir * 0.5).rgb + texture(frame, uv + dir * 0.5).rgb);
+    float lb = dot(b, luma);
+    color = vec4((lb < lo || lb > hi) ? a : b, centre.a);
+})";
+
+GLuint fxaa_program() {
+    thread_local GLuint program = 0;
+    thread_local bool failed = false;
+    if (program || failed) return program;
+    auto compile = [](GLenum type, const char* src) {
+        GLuint sh = glCreateShader(type);
+        glShaderSource(sh, 1, &src, nullptr);
+        glCompileShader(sh);
+        GLint ok = 0;
+        glGetShaderiv(sh, GL_COMPILE_STATUS, &ok);
+        if (!ok) {
+            char log[1024] = {};
+            glGetShaderInfoLog(sh, sizeof log, nullptr, log);
+            std::fprintf(stderr, "[win.apk] FXAA shader: %s\n", log);
+            glDeleteShader(sh);
+            return 0u;
+        }
+        return sh;
+    };
+    GLuint vs = compile(GL_VERTEX_SHADER, kFxaaVertex), fs = compile(GL_FRAGMENT_SHADER, kFxaaFragment);
+    if (vs && fs) {
+        program = glCreateProgram();
+        glAttachShader(program, vs);
+        glAttachShader(program, fs);
+        glLinkProgram(program);
+        GLint ok = 0;
+        glGetProgramiv(program, GL_LINK_STATUS, &ok);
+        if (!ok) {
+            glDeleteProgram(program);
+            program = 0;
+        }
+    }
+    if (vs) glDeleteShader(vs);
+    if (fs) glDeleteShader(fs);
+    failed = !program;
+    std::fprintf(stderr, "[win.apk] FXAA %s\n", program ? "on" : "off: its shader did not build");
+    return program;
+}
+
+// The frame (bw x bh at the bottom left of the window surface) through FXAA,
+// scaled to fit the window (ww x wh), black around it.
+bool fxaa_present(int bw, int bh, int ww, int wh) {
+    const GLuint program = fxaa_program();
+    if (!program) return false;
+    thread_local GLuint tex = 0, fbo = 0, vao = 0;
+    thread_local int tw = 0, th = 0;
+    SavedGl gl;
+    gl.save();
+    GLint sampler = 0;
+    glGetIntegerv(GL_SAMPLER_BINDING, &sampler);
+    if (!tex) {
+        glGenTextures(1, &tex);
+        glGenFramebuffers(1, &fbo);
+        glGenVertexArrays(1, &vao);
+    }
+    glBindTexture(GL_TEXTURE_2D, tex);
+    if (tw != bw || th != bh) {
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, bw, bh, 0, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+        tw = bw;
+        th = bh;
+    }
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, fbo);
+    glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, tex, 0);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, 0);
+    glDisable(GL_SCISSOR_TEST);
+    glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+    glBlitFramebuffer(0, 0, bw, bh, 0, 0, bw, bh, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+    glBindFramebuffer(GL_FRAMEBUFFER, 0);
+    if (bw != ww || bh != wh) {
+        glClearColor(0, 0, 0, 1);
+        glClear(GL_COLOR_BUFFER_BIT);
+    }
+    int dw = ww, dh = static_cast<int>(static_cast<long long>(ww) * bh / bw);
+    if (dh > wh) {
+        dh = wh;
+        dw = static_cast<int>(static_cast<long long>(wh) * bw / bh);
+    }
+    glViewport((ww - dw) / 2, (wh - dh) / 2, dw, dh);
+    glDisable(GL_BLEND);
+    glDisable(GL_DEPTH_TEST);
+    glDisable(GL_CULL_FACE);
+    glDisable(GL_STENCIL_TEST);
+    glUseProgram(program);
+    glBindVertexArray(vao);
+    glBindSampler(0, 0);
+    glUniform1i(glGetUniformLocation(program, "frame"), 0);
+    glUniform2f(glGetUniformLocation(program, "texel"), 1.0f / static_cast<float>(bw), 1.0f / static_cast<float>(bh));
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+    glBindSampler(0, static_cast<GLuint>(sampler));
+    gl.restore();
+    return true;
+}
+
+
+// ---- WINAPK_UPSCALE: FSR 1 or SGSR 1 instead of a plain stretch ----
+// The app's frame (bw x bh at the window surface's corner: its RenderTargetSize,
+// or WINAPK_RENDER_SCALE) is copied to a texture and drawn over the window,
+// letterboxed to its shape, with FSR 1 (EASU, then RCAS sharpening) or SGSR 1.
+// The shaders are AMD's and Qualcomm's (third_party/upscale, from Bunker).
+#include "../../third_party/upscale/upscale_shaders.h"
+
+int upscale_mode() {  // 0 plain, 1 FSR, 2 SGSR
+    static const int m = [] {
+        const char* e = std::getenv("WINAPK_UPSCALE");
+        if (!e) return 0;
+        if (std::strcmp(e, "fsr") == 0) return 1;
+        if (std::strcmp(e, "sgsr") == 0) return 2;
+        return 0;
+    }();
+    return m;
+}
+
+GLuint build_program(const char* vs_src, const char* fs_src, const char* what) {
+    auto build = [&](GLenum type, const char* src) -> GLuint {
+        const GLuint sh = glCreateShader(type);
+        glShaderSource(sh, 1, &src, nullptr);
+        glCompileShader(sh);
+        GLint ok = 0;
+        glGetShaderiv(sh, GL_COMPILE_STATUS, &ok);
+        if (!ok) {
+            char log[1024] = "";
+            glGetShaderInfoLog(sh, sizeof log, nullptr, log);
+            std::fprintf(stderr, "[win.apk] %s shader: %s\n", what, log);
+            glDeleteShader(sh);
+            return 0;
+        }
+        return sh;
+    };
+    const GLuint v = build(GL_VERTEX_SHADER, vs_src), f = build(GL_FRAGMENT_SHADER, fs_src);
+    GLuint p = 0;
+    if (v && f) {
+        p = glCreateProgram();
+        glAttachShader(p, v);
+        glAttachShader(p, f);
+        glLinkProgram(p);
+        GLint ok = 0;
+        glGetProgramiv(p, GL_LINK_STATUS, &ok);
+        if (!ok) {
+            glDeleteProgram(p);
+            p = 0;
+        }
+    }
+    if (v) glDeleteShader(v);
+    if (f) glDeleteShader(f);
+    return p;
+}
+
+bool upscale_present(int bw, int bh, int ww, int wh) {
+    const int mode = upscale_mode();
+    if (!mode) return false;
+    thread_local bool tried = false, failed = false;
+    thread_local GLuint easu = 0, rcas = 0, sgsr = 0, vao = 0, src = 0, src_fbo = 0, mid = 0, mid_fbo = 0;
+    thread_local int sw = 0, sh = 0, mw = 0, mh = 0;
+    if (failed) return false;
+    if (!tried) {
+        tried = true;
+        if (mode == 1) {
+            easu = build_program(kScaleVertex, kEasuFragment, "FSR EASU");
+            rcas = build_program(kScaleVertex, kRcasFragment, "FSR RCAS");
+            failed = !easu || !rcas;
+        } else {
+            sgsr = build_program(kScaleVertex, kSgsrFragment, "SGSR");
+            failed = !sgsr;
+        }
+        std::fprintf(stderr, "[win.apk] upscaling: %s%s\n", mode == 1 ? "FSR 1" : "SGSR 1",
+                     failed ? " unavailable (its shaders did not build), plain stretching instead" : "");
+        if (failed) return false;
+    }
+    SavedGl gl;
+    gl.save();
+    GLint sampler = 0;
+    glGetIntegerv(GL_SAMPLER_BINDING, &sampler);
+    if (!vao) {
+        glGenVertexArrays(1, &vao);
+        glGenTextures(1, &src);
+        glGenFramebuffers(1, &src_fbo);
+    }
+    glBindTexture(GL_TEXTURE_2D, src);
+    if (sw != bw || sh != bh) {
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, bw, bh, 0, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+        sw = bw;
+        sh = bh;
+    }
+    // The app's corner of the window surface into the texture.
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, src_fbo);
+    glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, src, 0);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, 0);
+    glDisable(GL_SCISSOR_TEST);
+    glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+    glBlitFramebuffer(0, 0, bw, bh, 0, 0, bw, bh, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+    int dw = ww, dh = static_cast<int>(static_cast<long long>(ww) * bh / bw);
+    if (dh > wh) {
+        dh = wh;
+        dw = static_cast<int>(static_cast<long long>(wh) * bw / bh);
+    }
+    const int dx = (ww - dw) / 2, dy = (wh - dh) / 2;
+    glDisable(GL_BLEND);
+    glDisable(GL_DEPTH_TEST);
+    glDisable(GL_CULL_FACE);
+    glDisable(GL_STENCIL_TEST);
+    glBindSampler(0, 0);
+    glBindVertexArray(vao);
+    glActiveTexture(GL_TEXTURE0);
+    if (mode == 1) {
+        if (!mid) {
+            glGenTextures(1, &mid);
+            glGenFramebuffers(1, &mid_fbo);
+        }
+        glBindTexture(GL_TEXTURE_2D, mid);
+        if (mw != dw || mh != dh) {
+            glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, dw, dh, 0, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+            mw = dw;
+            mh = dh;
+        }
+        glBindFramebuffer(GL_DRAW_FRAMEBUFFER, mid_fbo);
+        glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, mid, 0);
+        glViewport(0, 0, dw, dh);
+        glUseProgram(easu);
+        glUniform1i(glGetUniformLocation(easu, "image"), 0);
+        glUniform2f(glGetUniformLocation(easu, "inSize"), static_cast<float>(bw), static_cast<float>(bh));
+        glUniform2f(glGetUniformLocation(easu, "outSize"), static_cast<float>(dw), static_cast<float>(dh));
+        glBindTexture(GL_TEXTURE_2D, src);
+        glDrawArrays(GL_TRIANGLES, 0, 3);
+        glBindFramebuffer(GL_FRAMEBUFFER, 0);
+        if (dw != ww || dh != wh) {
+            glClearColor(0, 0, 0, 1);
+            glClear(GL_COLOR_BUFFER_BIT);
+        }
+        glViewport(dx, dy, dw, dh);
+        glUseProgram(rcas);
+        glUniform1i(glGetUniformLocation(rcas, "image"), 0);
+        glUniform1f(glGetUniformLocation(rcas, "sharpness"), 0.87f);  // exp2(-0.2): FSR's usual 0.2 stops
+        glUniform2i(glGetUniformLocation(rcas, "offset"), dx, dy);
+        glBindTexture(GL_TEXTURE_2D, mid);
+        glDrawArrays(GL_TRIANGLES, 0, 3);
+    } else {
+        glBindFramebuffer(GL_FRAMEBUFFER, 0);
+        if (dw != ww || dh != wh) {
+            glClearColor(0, 0, 0, 1);
+            glClear(GL_COLOR_BUFFER_BIT);
+        }
+        glViewport(dx, dy, dw, dh);
+        glUseProgram(sgsr);
+        glUniform1i(glGetUniformLocation(sgsr, "image"), 0);
+        glUniform4f(glGetUniformLocation(sgsr, "viewport"), 1.0f / static_cast<float>(bw), 1.0f / static_cast<float>(bh),
+                    static_cast<float>(bw), static_cast<float>(bh));
+        glBindTexture(GL_TEXTURE_2D, src);
+        glDrawArrays(GL_TRIANGLES, 0, 3);
+    }
+    glBindSampler(0, static_cast<GLuint>(sampler));
+    gl.restore();
+    return true;
+}
+
+// ---- WINAPK_PERF=overlay: the numbers in the top left corner ----
+// GDI draws the text into a bitmap when it changes (once a second); GL draws
+// that over the frame, blended, right before the swap.
+GLuint overlay_program() {
+    thread_local GLuint program = 0;
+    thread_local bool tried = false;
+    if (tried) return program;
+    tried = true;
+    static const char* vs =
+        "#version 300 es\n"
+        "out vec2 uv;\n"
+        "void main() {\n"
+        "  vec2 p = vec2(float(gl_VertexID & 1), float(gl_VertexID >> 1));\n"
+        "  uv = vec2(p.x, 1.0 - p.y);\n"
+        "  gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);\n"
+        "}\n";
+    static const char* fs =
+        "#version 300 es\n"
+        "precision mediump float;\n"
+        "uniform sampler2D text;\n"
+        "in vec2 uv;\n"
+        "out vec4 color;\n"
+        "void main() { color = texture(text, uv); }\n";
+    auto build = [](GLenum type, const char* src) {
+        GLuint sh = glCreateShader(type);
+        glShaderSource(sh, 1, &src, nullptr);
+        glCompileShader(sh);
+        GLint ok = 0;
+        glGetShaderiv(sh, GL_COMPILE_STATUS, &ok);
+        return ok ? sh : 0u;
+    };
+    const GLuint v = build(GL_VERTEX_SHADER, vs), f = build(GL_FRAGMENT_SHADER, fs);
+    if (v && f) {
+        program = glCreateProgram();
+        glAttachShader(program, v);
+        glAttachShader(program, f);
+        glLinkProgram(program);
+        GLint ok = 0;
+        glGetProgramiv(program, GL_LINK_STATUS, &ok);
+        if (!ok) {
+            glDeleteProgram(program);
+            program = 0;
+        }
+    }
+    if (v) glDeleteShader(v);
+    if (f) glDeleteShader(f);
+    if (!program) std::fprintf(stderr, "[win.apk] perf overlay: its shader did not build\n");
+    return program;
+}
+
+void perf_overlay(int ww, int wh) {
+    if (!perf::overlay_shown() || ww <= 0 || wh <= 0) return;
+    const GLuint program = overlay_program();
+    if (!program) return;
+    thread_local GLuint tex = 0, vao = 0;
+    thread_local unsigned shown = ~0u;
+    thread_local int tw = 0, th = 0;
+    SavedGl gl;
+    gl.save();
+    GLint sampler = 0;
+    glGetIntegerv(GL_SAMPLER_BINDING, &sampler);
+    if (!tex) {
+        glGenTextures(1, &tex);
+        glGenVertexArrays(1, &vao);
+    }
+    glBindTexture(GL_TEXTURE_2D, tex);
+    unsigned version = 0;
+    const std::string text = perf::overlay_text(&version);
+    if (version != shown) {
+        shown = version;
+        const int font_h = wh >= 1400 ? 26 : wh >= 1000 ? 20 : 16;
+        int lines = 1;
+        for (char c : text) lines += c == '\n';
+        tw = font_h * 24;
+        th = lines * (font_h + 2) + 8;
+        BITMAPINFO bi = {};
+        bi.bmiHeader.biSize = sizeof bi.bmiHeader;
+        bi.bmiHeader.biWidth = tw;
+        bi.bmiHeader.biHeight = -th;  // top-down
+        bi.bmiHeader.biPlanes = 1;
+        bi.bmiHeader.biBitCount = 32;
+        void* bits = nullptr;
+        HDC dc = CreateCompatibleDC(nullptr);
+        HBITMAP bmp = dc ? CreateDIBSection(dc, &bi, DIB_RGB_COLORS, &bits, nullptr, 0) : nullptr;
+        if (dc && bmp && bits) {
+            HGDIOBJ old_bmp = SelectObject(dc, bmp);
+            HFONT font = CreateFontW(-font_h, 0, 0, 0, FW_BOLD, 0, 0, 0, DEFAULT_CHARSET, 0, 0, NONANTIALIASED_QUALITY,
+                                     FIXED_PITCH, L"Consolas");
+            HGDIOBJ old_font = SelectObject(dc, font);
+            std::memset(bits, 0, static_cast<size_t>(tw) * static_cast<size_t>(th) * 4);
+            SetBkMode(dc, TRANSPARENT);
+            SetTextColor(dc, RGB(255, 255, 255));
+            int y = 4;
+            size_t start = 0;
+            for (size_t i = 0; i <= text.size(); ++i) {
+                if (i == text.size() || text[i] == '\n') {
+                    const std::string line = text.substr(start, i - start);
+                    TextOutA(dc, 6, y, line.c_str(), static_cast<int>(line.size()));
+                    y += font_h + 2;
+                    start = i + 1;
+                }
+            }
+            GdiFlush();
+            // White text on a dark, translucent box (GDI leaves alpha alone).
+            auto* p = static_cast<uint32_t*>(bits);
+            for (size_t i = 0, n = static_cast<size_t>(tw) * static_cast<size_t>(th); i < n; ++i) {
+                const uint32_t lum = p[i] & 0xffu;
+                p[i] = lum ? (0xff000000u | lum << 16 | lum << 8 | lum) : 0xb4000000u;
+            }
+            glPixelStorei(GL_UNPACK_ALIGNMENT, 4);
+            glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, tw, th, 0, GL_RGBA, GL_UNSIGNED_BYTE, bits);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+            SelectObject(dc, old_font);
+            DeleteObject(font);
+            SelectObject(dc, old_bmp);
+        } else {
+            tw = th = 0;
+        }
+        if (bmp) DeleteObject(bmp);
+        if (dc) DeleteDC(dc);
+    }
+    if (tw > 0 && th > 0) {
+        glBindFramebuffer(GL_FRAMEBUFFER, 0);
+        glViewport(8, wh - th - 8, tw, th);
+        glDisable(GL_SCISSOR_TEST);
+        glDisable(GL_DEPTH_TEST);
+        glDisable(GL_CULL_FACE);
+        glDisable(GL_STENCIL_TEST);
+        glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+        glEnable(GL_BLEND);
+        glBlendFuncSeparate(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA, GL_ZERO, GL_ONE);
+        glBlendEquationSeparate(GL_FUNC_ADD, GL_FUNC_ADD);
+        glUseProgram(program);
+        glBindVertexArray(vao);
+        glBindSampler(0, 0);
+        glUniform1i(glGetUniformLocation(program, "text"), 0);
+        glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+        glBindSampler(0, static_cast<GLuint>(sampler));
+    }
+    gl.restore();
+}
