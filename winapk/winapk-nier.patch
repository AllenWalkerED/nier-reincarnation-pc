+// The same for UTF-16 strings, when they are ASCII (paths and URLs are).
+WINAPK_GUEST_ABI jstring guest_new_string(JNIEnv* genv, const jchar* chars, jsize len) {
+    GuestEnv* g = guest_env_from(genv);
+    JNIEnv* env = g ? g->host : genv;
