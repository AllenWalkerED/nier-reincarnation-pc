+// Android paths the guest names, back to the host's for Java: at the start
+// of the string or right after "file://" (a jar: or file: URL). Unity hands
+// AVPro Video "jar:file:///data/app/<pkg>/base.apk!/assets/..." for a movie
+// in the APK; Java read "\\data\\app\\..." on Windows and found nothing.
+std::string host_form(const char* s) {
+    static const std::string root = [] {
+        std::string r = winapk::android_root_utf8();
+        for (char& c : r) {
+            if (c == '\\') c = '/';
+        }
+        return r;
+    }();
+    if (!s || root.empty()) return {};
+    static const char* const kPrefixes[] = {"/data/app/", "/data/data/", "/data/user/", "/sdcard/", "/storage/emulated/"};
+    std::string in(s), out;
+    bool changed = false;
+    size_t i = 0;
+    while (i < in.size()) {
+        const bool boundary = (i >= 7 && in.compare(i - 7, 7, "file://") == 0);
+        bool hit = false;
+        if (boundary) {
+            for (const char* pre : kPrefixes) {
+                const size_t n = std::strlen(pre);
+                if (in.compare(i, n, pre) == 0) {
+                    out += root;
+                    hit = changed = true;
+                    break;
+                }
+            }
+        }
+        out += in[i++];
+        (void)hit;
+    }
+    if (changed) {
+        static std::atomic<int> logged{0};
+        if (logged.fetch_add(1) < 8) std::fprintf(stderr, "[win.apk] jni path to host: %.200s\n", out.c_str());
+    }
+    return changed ? out : std::string();
