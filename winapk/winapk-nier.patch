+// WINAPK_GL_DEPTH_TRACE=1: each distinct depth-related call the app makes,
+// once (what depth the app uses, not how often).
+void depth_trace(const char* fmt, ...) {
+    static const bool on = std::getenv("WINAPK_GL_DEPTH_TRACE") != nullptr;
+    if (!on) return;
+    char line[160];
+    va_list ap;
+    va_start(ap, fmt);
+    std::vsnprintf(line, sizeof line, fmt, ap);
+    va_end(ap);
+    static std::mutex lock;
+    static std::vector<std::string> seen;
+    std::lock_guard<std::mutex> hold(lock);
+    if (seen.size() >= 200) return;
+    for (const std::string& s : seen)
+        if (s == line) return;
+    seen.emplace_back(line);
+    std::fprintf(stderr, "[win.apk] GL depth: %s\n", line);
+}
