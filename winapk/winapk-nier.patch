+// game_effects.cpp -- WINAPK_GAME_EFFECTS_OFF: the game's own graphics effects
+// turned off one by one (NieR Re[in]carnation 3.7.1; Bunker's render_effects.c
+// for Android, run here from the host).
+//
+// The game's performance presets (Dark.Component.PerformanceSetting.Config,
+// LevelConfigs: frame rate, RenderTargetSize, then shadow, reflection,
+// vignette and bloom flags, 12 bytes each) turn its effects on. Each effect
+// chosen off is cleared in every preset, and the preset in use is applied
+// again through the game's own Config.SetLevel(in LevelConfig), found through
+// ContextApi.ActiveContext > Application > PerformanceConfig. SetLevel touches
+// Unity objects, which only Unity's main thread may do: the work runs there,
+// from EventSystem.Update, whose method pointer is pointed at a host function
+// that does it once and then calls the game's own Update every frame (a guest
+// call to a host address is a host call, arm64_guest.h). The lookups run
+// through the game's il2cpp API, guest functions called with arm64::call.
+// Anything missing leaves the game's effects as they are.
+//
+// WINAPK_GAME_EFFECTS_OFF is a list: shadows, reflections, bloom, vignette.
+//
+// Frame timing above 30 fps (Bunker's display_patch.c, done here without
+// touching the game's code, whose translation a write would throw away). The
+// game is built for 30 frames a second, and the same EventSystem.Update hook
+// keeps its speed at any rate:
+//   - Walking and the characters' animation: ActorController.FixedProcess runs
+//     once per drawn frame and steps by Time.fixedDeltaTime, which the game
+//     leaves at 1/30 s, so at 60 frames characters walked and moved twice as
+//     fast. Each frame the step becomes that frame's real time (1/240 to 1/30 s).
+//   - Battles: BattleUpdate.OnStateUpdate advances the battle by one 30 Hz step
+//     (KernelBattle.Process(1.0)) per frame. Its method is pointed at a host
+//     function that lets one step through each time 1/30 s has built up and
+//     none on the frames in between (Bunker: fractional steps crashed the
+//     summon reveal, which runs on the battle code).
+//   - The 30 frame ceiling battles set again (Generator.SetupRenderer:
+//     Application.targetFrameRate = 30) is raised again; WINAPK_FPS_CAP limits.
+//   - Snapping lists (the summon banners): DarkScrollRect counts the list as
+//     arrived within kScrollBorder (0.01) of its row; above 30 fps the last
+//     steps are below a float's precision far down a list, so it never arrives
+//     and the Summon buttons ignore taps. kScrollBorder becomes 1 (Bunker).
+// On when WINAPK_FPS_CAP is above 30 or unlimited; WINAPK_FRAME_TIMING=0 turns
+// it off.
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <type_traits>
+
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+
+#include "native_window.h"
+#include "winapk/arm64_guest.h"
+#include "winapk/linker.h"
+
+namespace winapk::host {
+
+namespace {
+
+enum : int { kShadows = 1, kReflections = 2, kVignette = 4, kBloom = 8 };
+
+int effects_off() {
+    static const int off = [] {
+        const char* e = std::getenv("WINAPK_GAME_EFFECTS_OFF");
+        if (!e) return 0;
+        int m = 0;
+        if (std::strstr(e, "shadow")) m |= kShadows;
+        if (std::strstr(e, "reflection")) m |= kReflections;
+        if (std::strstr(e, "vignette")) m |= kVignette;
+        if (std::strstr(e, "bloom")) m |= kBloom;
+        return m;
+    }();
+    return off;
+}
+
+bool frame_timing_on() {
+    static const bool on = [] {
+        const char* t = std::getenv("WINAPK_FRAME_TIMING");
+        if (t && std::strcmp(t, "0") == 0) return false;
+        const char* cap = std::getenv("WINAPK_FPS_CAP");
+        const int fps = cap ? std::atoi(cap) : 0;
+        return fps <= 0 || fps > 30;  // unlimited, or above the game's own 30
+    }();
+    return on;
+}
+
+// A guest function called from the host, its arguments as 64-bit words.
+template <typename T>
+uint64_t word(T v) {
+    if constexpr (std::is_pointer_v<T> || std::is_null_pointer_v<T>) return static_cast<uint64_t>(reinterpret_cast<uintptr_t>(v));
+    else return static_cast<uint64_t>(v);
+}
+template <typename... A>
+uint64_t g(const void* fn, A... a) {
+    const uint64_t args[] = {word(a)..., 0};
+    return arm64::call(fn, args, sizeof...(A));
+}
+template <typename T>
+T* ptr(uint64_t v) { return reinterpret_cast<T*>(static_cast<uintptr_t>(v)); }
+
+struct Il2cpp {
+    void *domain_get, *domain_get_assemblies, *assembly_get_image, *class_from_name, *class_get_method_from_name,
+        *class_get_methods, *method_get_name, *method_get_param_count, *method_get_param, *type_get_name,
+        *class_get_field_from_name, *field_get_offset, *field_static_get_value, *field_static_set_value,
+        *runtime_class_init, *runtime_invoke;
+} il;
+
+bool resolve() {
+    GuestLinker* linker = GuestLinker::process();
+    if (!linker) return false;
+    std::string err;
+    // Unity loads libil2cpp.so RTLD_LOCAL: its symbols are looked up in it, not in the global scope.
+    GuestLibrary* lib = linker->open("libil2cpp.so", GuestLinker::kRtldNoLoad | GuestLinker::kRtldNow, &err);
+    if (!lib) return false;
+#define LOAD(name)                                                                                    \
+    if (!(il.name = linker->lookup(lib, "il2cpp_" #name, nullptr, &err))) {                          \
+        std::fprintf(stderr, "[win.apk] game effects: il2cpp_%s not found (%s)\n", #name, err.c_str()); \
+        return false;                                                                                 \
+    }
+    LOAD(domain_get) LOAD(domain_get_assemblies) LOAD(assembly_get_image) LOAD(class_from_name)
+    LOAD(class_get_method_from_name) LOAD(class_get_methods) LOAD(method_get_name) LOAD(method_get_param_count)
+    LOAD(method_get_param) LOAD(type_get_name) LOAD(class_get_field_from_name) LOAD(field_get_offset)
+    LOAD(field_static_get_value) LOAD(field_static_set_value) LOAD(runtime_class_init) LOAD(runtime_invoke)
+#undef LOAD
+    return true;
+}
+
+void* find_class(const char* ns, const char* name) {
+    size_t count = 0;
+    void* domain = ptr<void>(g(il.domain_get));
+    if (!domain) return nullptr;
+    void** assemblies = ptr<void*>(g(il.domain_get_assemblies, domain, &count));
+    for (size_t i = 0; assemblies && i < count; ++i) {
+        void* image = ptr<void>(g(il.assembly_get_image, assemblies[i]));
+        void* klass = ptr<void>(g(il.class_from_name, image, ns, name));
+        if (klass) return klass;
+    }
+    return nullptr;
+}
+
+bool offset_of(void* klass, const char* name, size_t* out) {
+    void* field = klass ? ptr<void>(g(il.class_get_field_from_name, klass, name)) : nullptr;
+    if (field) *out = static_cast<size_t>(g(il.field_get_offset, field));
+    return field != nullptr;
+}
+
+// Config.SetLevel(in LevelConfig): the overload whose parameter isn't a PerformanceLevel.
+void* set_level_entry(void* config) {
+    void* iter = nullptr;
+    while (void* method = ptr<void>(g(il.class_get_methods, config, &iter))) {
+        const char* name = ptr<const char>(g(il.method_get_name, method));
+        if (!name || std::strcmp(name, "SetLevel") != 0 || g(il.method_get_param_count, method) != 1) continue;
+        const char* type = ptr<const char>(g(il.type_get_name, ptr<void>(g(il.method_get_param, method, 0))));
+        if (type && std::strstr(type, "LevelConfig")) return method;  // the guest's malloc'd name is left (once)
+    }
+    return nullptr;
+}
+
+void* g_original_update = nullptr;  // EventSystem.Update's own code
+int g_state = 0;                    // 0 trying, 1 done, -1 gave up
+int g_tries = 0;
+
+// On Unity's main thread, once a frame until it is done.
+void apply() {
+    void* config = find_class("Dark.Component.PerformanceSetting", "Config");
+    void* api = find_class("Dark.Kernel", "ContextApi");
+    void* context = find_class("Dark.Kernel", "Context");
+    void* application = find_class("Dark.Kernel", "ApplicationContext");
+    void* levels = config ? ptr<void>(g(il.class_get_field_from_name, config, "LevelConfigs")) : nullptr;
+    void* active = api ? ptr<void>(g(il.class_get_method_from_name, api, "get_ActiveContext", 0)) : nullptr;
+    void* set_level = config ? set_level_entry(config) : nullptr;
+    size_t f_application = 0, f_performance = 0, f_current = 0;
+    if (!levels || !active || !set_level || !offset_of(context, "<Application>k__BackingField", &f_application) ||
+        !offset_of(application, "<PerformanceConfig>k__BackingField", &f_performance) ||
+        !offset_of(config, "_currentLevel", &f_current)) {
+        if (++g_tries > 3600) {
+            g_state = -1;
+            std::fprintf(stderr, "[win.apk] game effects: this game's classes were not found; its effects stay on\n");
+        }
+        return;
+    }
+    // The game's context and performance settings exist once its title screen is up.
+    // A static method's code takes its MethodInfo last: (MethodInfo*) here.
+    uint8_t* ctx = ptr<uint8_t>(g(*static_cast<void**>(active), static_cast<void*>(nullptr)));
+    uint8_t* app = ctx ? *reinterpret_cast<uint8_t**>(ctx + f_application) : nullptr;
+    uint8_t* performance = app ? *reinterpret_cast<uint8_t**>(app + f_performance) : nullptr;
+    if (!performance) return;
+    g(il.runtime_class_init, config);
+    uint8_t* array = nullptr;
+    g(il.field_static_get_value, levels, &array);
+    if (!array) return;
+    const size_t length = *reinterpret_cast<size_t*>(array + 0x18);
+    const int off = effects_off();
+    for (size_t i = 0; i < length; ++i) {
+        uint8_t* flags = array + 0x20 + i * 12 + 8;  // shadow, reflection, vignette, bloom
+        if (off & kShadows) flags[0] = 0;
+        if (off & kReflections) flags[1] = 0;
+        if (off & kVignette) flags[2] = 0;
+        if (off & kBloom) flags[3] = 0;
+    }
+    int32_t level = *reinterpret_cast<int32_t*>(performance + f_current);
+    g_state = 1;
+    if (level == 5) {
+        std::fprintf(stderr, "[win.apk] game effects: off in every preset (power saving now)\n");
+        return;
+    }
+    if (level < 0 || static_cast<size_t>(level) >= length) level = 0;
+    void* exception = nullptr;
+    void* args[] = {array + 0x20 + static_cast<size_t>(level) * 12};
+    g(il.runtime_invoke, set_level, performance, args, &exception);
+    std::fprintf(stderr, "[win.apk] game effects off:%s%s%s%s%s\n", off & kShadows ? " shadows" : "",
+                 off & kReflections ? " reflections" : "", off & kBloom ? " bloom" : "", off & kVignette ? " vignette" : "",
+                 exception ? " (the game refused its preset now: from its next preset change)" : "");
+}
+
+// ---- Low and Power saving at the full frame rate ----
+// Each preset's first field is the rate the game draws at: Unity draws every
+// targetFrameRate / rate frames (Rendering.SetTargetRenderFrameRate,
+// OnDemandRendering.renderFrameInterval). The PC's client takes 240 for both
+// (fps_patch.py: targetFrameRate and UnSavePowerTargetRenderFrameRate), but
+// Low and Power saving take SavePowerTargetRenderFrameRate, 10: one drawn
+// frame in 24, about 2.5 a second at 60. (On the phone, 30/10: 10 a second.)
+// Their rate becomes the others' (preset 3, Middle, the same 540p without
+// effects), and the preset in use is applied again. The launcher caps Power
+// saving's frame rate itself. WINAPK_PRESET_RATE_FIX=0 leaves them.
+bool preset_fix_on() {
+    static const bool on = [] {
+        const char* e = std::getenv("WINAPK_PRESET_RATE_FIX");
+        return !(e && std::strcmp(e, "0") == 0);
+    }();
+    return on;
+}
+int g_fix_state = 0;  // 0 trying, 1 done, -1 gave up
+int g_fix_tries = 0;
+
+void fix_presets() {
+    void* config = find_class("Dark.Component.PerformanceSetting", "Config");
+    void* api = find_class("Dark.Kernel", "ContextApi");
+    void* context = find_class("Dark.Kernel", "Context");
+    void* application = find_class("Dark.Kernel", "ApplicationContext");
+    void* levels = config ? ptr<void>(g(il.class_get_field_from_name, config, "LevelConfigs")) : nullptr;
+    void* active = api ? ptr<void>(g(il.class_get_method_from_name, api, "get_ActiveContext", 0)) : nullptr;
+    void* set_level = config ? set_level_entry(config) : nullptr;
+    size_t f_application = 0, f_performance = 0, f_current = 0;
+    if (!levels || !active || !set_level || !offset_of(context, "<Application>k__BackingField", &f_application) ||
+        !offset_of(application, "<PerformanceConfig>k__BackingField", &f_performance) ||
+        !offset_of(config, "_currentLevel", &f_current)) {
+        if (++g_fix_tries > 3600) {
+            g_fix_state = -1;
+            std::fprintf(stderr, "[win.apk] presets: this game's classes were not found; Low keeps its frame rate\n");
+        }
+        return;
+    }
+    uint8_t* ctx = ptr<uint8_t>(g(*static_cast<void**>(active), static_cast<void*>(nullptr)));
+    uint8_t* app = ctx ? *reinterpret_cast<uint8_t**>(ctx + f_application) : nullptr;
+    uint8_t* performance = app ? *reinterpret_cast<uint8_t**>(app + f_performance) : nullptr;
+    if (!performance) return;
+    g(il.runtime_class_init, config);
+    uint8_t* array = nullptr;
+    g(il.field_static_get_value, levels, &array);
+    if (!array) return;
+    const size_t length = *reinterpret_cast<size_t*>(array + 0x18);
+    g_fix_state = 1;
+    if (length < 6) return;
+    auto rate = [&](size_t i) { return reinterpret_cast<int32_t*>(array + 0x20 + i * 12); };
+    auto target_size = [&](size_t i) { return reinterpret_cast<int32_t*>(array + 0x20 + i * 12 + 4); };
+    const int32_t level = *reinterpret_cast<int32_t*>(performance + f_current);
+    bool current_changed = false;
+    const int32_t full = *rate(3);
+    const int32_t was_low = *rate(4), was_saving = *rate(5);
+    if (full > 0 && (was_low < full || was_saving < full)) {
+        *rate(4) = full;
+        *rate(5) = full;
+        current_changed = level == 4 || level == 5;
+        std::fprintf(stderr, "[win.apk] presets: Low and Power saving draw every frame (rate %d, was %d/%d)\n", full,
+                     was_low, was_saving);
+    }
+    // WINAPK_RENDER_SCALE (the launcher's Render resolution): every preset's
+    // RenderTargetSize becomes DeviceMax (8), the surface the runtime gives
+    // the app (the window at that percentage). The presets ask for fixed sizes
+    // (HD 1152x720 for High, FullHD for Highest, 540 lines
+    // below): Unity then drew that small picture in the corner of the larger
+    // surface, and the render scale had nothing to scale.
+    if (render_scale_percent() > 0) {
+        int changed = 0;
+        for (size_t i = 0; i < length; ++i) {
+            if (*target_size(i) != 8) {
+                *target_size(i) = 8;
+                ++changed;
+                if (static_cast<int32_t>(i) == level) current_changed = true;
+            }
+        }
+        if (changed)
+            std::fprintf(stderr, "[win.apk] presets: the game draws at the window's size (render scale %d%%, %d presets)\n",
+                         render_scale_percent(), changed);
+    }
+    if (current_changed && level >= 0 && static_cast<size_t>(level) < length) {
+        void* exception = nullptr;
+        void* args[] = {array + 0x20 + static_cast<size_t>(level) * 12};
+        g(il.runtime_invoke, set_level, performance, args, &exception);
+        std::fprintf(stderr, "[win.apk] presets: level %d applied again%s\n", level,
+                     exception ? " (the game refused it now: from its next preset change)" : "");
+    }
+}
+
+// ---- frame timing (see the top of the file) ----
+
+double seconds_now() {
+    static LARGE_INTEGER freq = [] { LARGE_INTEGER f; QueryPerformanceFrequency(&f); return f; }();
+    LARGE_INTEGER t;
+    QueryPerformanceCounter(&t);
+    return static_cast<double>(t.QuadPart) / static_cast<double>(freq.QuadPart);
+}
+
+struct FrameTiming {
+    int state = 0;  // 0 looking, 1 running, -1 gave up
+    int tries = 0;
+    void* frame_count = nullptr;      // Time.get_frameCount's code
+    void* set_fixed_delta = nullptr;  // Time.set_fixedDeltaTime (MethodInfo, for runtime_invoke: a float argument)
+    void* get_target = nullptr;       // Application.get_targetFrameRate's code
+    void* set_target = nullptr;       // Application.set_targetFrameRate's code
+    int last_frame = -1;
+    double last_time = 0;
+    float fixed_set = 0;  // the step written last
+    bool raised_logged = false;
+} ft;
+
+// BattleUpdate.OnStateUpdate: the game's code, and the time built up toward the next 30 Hz step.
+void* g_battle_original = nullptr;
+double g_battle_time = 0, g_battle_last = 0;
+unsigned g_battle_frames = 0, g_battle_steps = 0;  // for the WINAPK_PERF line
+
+// BattleUpdate.OnStateUpdate(this, MethodInfo*), as the game calls it: one
+// 30 Hz battle step each time 1/30 s has built up, at most one a frame. A
+// tail hook (arm64_guest.h): the game's code runs as if called directly, or
+// the call returns at once.
+uint64_t battle_update_hook(uint64_t* /*x*/, void* /*ctx*/) {
+    const double now = seconds_now();
+    const double dt = g_battle_last ? now - g_battle_last : 1.0;
+    g_battle_last = now;
+    ++g_battle_frames;
+    if (dt > 0.25) {
+        g_battle_time = 0;  // the first frame of a battle, or after a pause: a step now
+    } else {
+        g_battle_time += 30.0 * dt;
+        if (g_battle_time < 1.0) return 0;
+        // A long frame builds no backlog, as before: one step.
+        g_battle_time = g_battle_time >= 2.0 ? 0.0 : g_battle_time - 1.0;
+    }
+    ++g_battle_steps;
+    return reinterpret_cast<uint64_t>(g_battle_original);
+}
+
+void* method_code(void* klass, const char* name, int args) {
+    void* m = klass ? ptr<void>(g(il.class_get_method_from_name, klass, name, args)) : nullptr;
+    return m ? *static_cast<void**>(m) : nullptr;
+}
+
+// Points every use of `method`'s code at `hook`: its MethodInfo, and the slots
+// of its class's vtable (a virtual call reads those). Returns the game's code.
+void* redirect(void* klass, void* method, void* hook) {
+    void** info = static_cast<void**>(method);
+    void* original = *info;
+    *info = hook;
+    void** slots = static_cast<void**>(klass);
+    int n = 0;
+    for (int i = 0; i < 0x200; ++i) {
+        if (slots[i] == original) {
+            slots[i] = hook;
+            ++n;
+        }
+    }
+    std::fprintf(stderr, "[win.apk] frame timing: battles step 30 times a second (%d vtable slot%s)\n", n, n == 1 ? "" : "s");
+    return original;
+}
+
+// WINAPK_FRAME_TIMING_PARTS: which parts run, for finding one at fault:
+// 1 the physics step, 2 the battle steps, 4 the 30 ceiling raised, 8 the lists. All by default.
+int ft_parts() {
+    static const int parts = [] {
+        const char* p = std::getenv("WINAPK_FRAME_TIMING_PARTS");
+        return p ? std::atoi(p) : 15;
+    }();
+    return parts;
+}
+
+bool frame_timing_setup() {
+    void* time = find_class("UnityEngine", "Time");
+    void* application = find_class("UnityEngine", "Application");
+    ft.frame_count = method_code(time, "get_frameCount", 0);
+    ft.set_fixed_delta = time ? ptr<void>(g(il.class_get_method_from_name, time, "set_fixedDeltaTime", 1)) : nullptr;
+    ft.get_target = method_code(application, "get_targetFrameRate", 0);
+    ft.set_target = method_code(application, "set_targetFrameRate", 1);
+    if (!ft.frame_count || !ft.set_fixed_delta || !ft.get_target || !ft.set_target) return false;
+    // The battle and the lists are the game's own classes, there once its assemblies are.
+    void* battle = find_class("Dark.Game.TurnBattle", "BattleUpdate");
+    void* update = battle ? ptr<void>(g(il.class_get_method_from_name, battle, "OnStateUpdate", 0)) : nullptr;
+    void* scroll = find_class("Dark.View.UserInterface.ScrollView", "DarkScrollRect");
+    void* border = scroll ? ptr<void>(g(il.class_get_field_from_name, scroll, "kScrollBorder")) : nullptr;
+    if (!update || !border) return false;
+    if (ft_parts() & 2) {
+        if (void* hook = arm64::make_tail_hook(&battle_update_hook, nullptr)) g_battle_original = redirect(battle, update, hook);
+    }
+    if (ft_parts() & 8) {
+        g(il.runtime_class_init, scroll);
+        float one = 1.0f;
+        g(il.field_static_set_value, border, &one);
+    }
+    std::fprintf(stderr, "[win.apk] frame timing: parts %d (1 physics step, 2 battle, 4 ceiling, 8 lists)\n", ft_parts());
+    return true;
+}
+
+// On Unity's main thread, from EventSystem.Update: once a frame.
+void frame_tick() {
+    if (ft.state == 0) {
+        if (frame_timing_setup()) {
+            ft.state = 1;
+        } else if (++ft.tries > 3600) {
+            ft.state = -1;
+            std::fprintf(stderr, "[win.apk] frame timing: this game's classes were not found; above 30 fps it runs faster\n");
+        }
+        if (ft.state != 1) return;
+    }
+    if (ft.state != 1) return;
+    const int frame = static_cast<int>(g(ft.frame_count, static_cast<void*>(nullptr)));
+    if (frame == ft.last_frame) return;  // one tick a frame, however many event systems
+    ft.last_frame = frame;
+    const double now = seconds_now();
+    const double dt = ft.last_time ? now - ft.last_time : 1.0 / 30;
+    ft.last_time = now;
+    // WINAPK_PERF: every 10 s, the frames, the physics step and the battle's steps.
+    static const bool perf = std::getenv("WINAPK_PERF") != nullptr;
+    static double window_start = now;
+    static unsigned window_frames = 0;
+    ++window_frames;
+    if (perf && now - window_start >= 10.0) {
+        const double span = now - window_start;
+        std::fprintf(stderr, "[win.apk] frame timing: %.1f frames/s, physics step %.2f ms, battle %.1f updates/s, %.1f steps/s\n",
+                     window_frames / span, ft.fixed_set * 1000.0, g_battle_frames / span, g_battle_steps / span);
+        window_start = now;
+        window_frames = g_battle_frames = g_battle_steps = 0;
+    }
+    float step = static_cast<float>(dt);
+    if (step < 1.0f / 240) step = 1.0f / 240;
+    if (step > 1.0f / 30) step = 1.0f / 30;
+    if ((ft_parts() & 1) && step != ft.fixed_set) {
+        void* exception = nullptr;
+        void* args[] = {&step};
+        g(il.runtime_invoke, ft.set_fixed_delta, static_cast<void*>(nullptr), args, &exception);
+        ft.fixed_set = step;
+    }
+    // Battles set the game's 30 again (Generator.SetupRenderer); power saving's 10 stays.
+    const int target = static_cast<int>(g(ft.get_target, static_cast<void*>(nullptr)));
+    if ((ft_parts() & 4) && target == 30) {
+        g(ft.set_target, 240, static_cast<void*>(nullptr));
+        if (!ft.raised_logged) {
+            ft.raised_logged = true;
+            std::fprintf(stderr, "[win.apk] frame timing: the game's 30 frame ceiling raised (WINAPK_FPS_CAP limits)\n");
+        }
+    }
+}
+
+// EventSystem.Update(this, MethodInfo*), as the game calls it: a tail hook
+// (arm64_guest.h) that does this frame's work and goes on into the game's
+// own Update. It was a host function calling Update from the host: the game's
+// title-screen tap was then lost (a guest call started from the host is a
+// call of its own, under which Update's own handling did not reach the game).
+uint64_t update_hook(uint64_t* /*x*/, void* /*ctx*/) {
+    if (g_state == 0 && effects_off()) apply();
+    if (g_fix_state == 0 && preset_fix_on()) fix_presets();
+    if (frame_timing_on() && !(ft_parts() & 16)) frame_tick();  // 16: the hook alone, for testing
+    return reinterpret_cast<uint64_t>(g_original_update);
+}
+
+}  // namespace
+
+// At the app's swaps (its render thread) until the hook is in.
+void game_effects_poll() {
+    static int stage = 0;  // 0 waiting, 1 installed, -1 not possible
+    static unsigned frames = 0;
+    if (stage != 0 || !(effects_off() || frame_timing_on() || preset_fix_on()) || ++frames % 30 != 0) return;
+    if (!il.domain_get && !resolve()) {
+        if (frames > 30 * 600) stage = -1;
+        return;
+    }
+    static bool said = false;
+    if (!said) {
+        said = true;
+        std::fprintf(stderr, "[win.apk] game hooks: il2cpp found, looking for EventSystem.Update\n");
+    }
+    void* event_system = find_class("UnityEngine.EventSystems", "EventSystem");
+    void* update = event_system ? ptr<void>(g(il.class_get_method_from_name, event_system, "Update", 0)) : nullptr;
+    if (!update) {
+        if (frames > 30 * 600) {
+            stage = -1;
+            std::fprintf(stderr, "[win.apk] game hooks: EventSystem.Update not found; the game's effects and frame timing stay as they are\n");
+        }
+        return;
+    }
+    void* hook = arm64::make_tail_hook(&update_hook, nullptr);
+    if (!hook) {
+        stage = -1;
+        return;
+    }
+    void** pointer = static_cast<void**>(update);  // MethodInfo starts with its code pointer
+    g_original_update = *pointer;
+    *pointer = hook;
+    stage = 1;
+    std::fprintf(stderr, "[win.apk] game hooks: EventSystem.Update hooked (%s%s%s)\n", effects_off() ? "effects " : "",
+                 frame_timing_on() ? "frame timing " : "", preset_fix_on() ? "presets" : "");
+}
+
+}  // namespace winapk::host
diff --git a/windows/host/gl/astc_host.cpp b/windows/host/gl/astc_host.cpp
new file mode 100644
index 0000000..d402fe5
--- /dev/null
+++ b/windows/host/gl/astc_host.cpp
@@ -0,0 +1,73 @@
+// ASTC on a GPU without it: see astc_host.h. The block decoder is
+// texture2ddecoder's (third_party/astcdec, MIT).
+#include "gl/astc_host.h"
+
+#include <algorithm>
+#include <cstdlib>
+#include <thread>
+
+#include "../../third_party/astcdec/astc.h"
+#include "perf_stats.h"
+
+namespace winapk::host {
+
+bool astc_format(unsigned format, int* block_w, int* block_h, bool* srgb) {
+    static const int kBlocks[14][2] = {{4, 4}, {5, 4}, {5, 5}, {6, 5}, {6, 6}, {8, 5}, {8, 6},
+                                       {8, 8}, {10, 5}, {10, 6}, {10, 8}, {10, 10}, {12, 10}, {12, 12}};
+    unsigned i;
+    if (format >= 0x93B0 && format <= 0x93BD) {  // GL_COMPRESSED_RGBA_ASTC_*_KHR
+        i = format - 0x93B0;
+        *srgb = false;
+    } else if (format >= 0x93D0 && format <= 0x93DD) {  // GL_COMPRESSED_SRGB8_ALPHA8_ASTC_*_KHR
+        i = format - 0x93D0;
+        *srgb = true;
+    } else {
+        return false;
+    }
+    *block_w = kBlocks[i][0];
+    *block_h = kBlocks[i][1];
+    return true;
+}
+
+bool astc_decode_rgba(const void* data, size_t size, int w, int h, int bw, int bh, std::vector<uint8_t>* rgba) {
+    if (!data || w <= 0 || h <= 0) return false;
+    const perf::Scope timed(perf::kAstc);
+    const long bx = (w + bw - 1) / bw, by = (h + bh - 1) / bh;
+    if (size < static_cast<size_t>(bx * by * 16)) return false;
+    rgba->resize(static_cast<size_t>(w) * static_cast<size_t>(h) * 4);
+    auto* out = reinterpret_cast<uint32_t*>(rgba->data());
+    const auto* in = static_cast<const uint8_t*>(data);
+    // Bands of block rows, one per thread for a large image.
+    static const unsigned cores = std::max(1u, std::min(8u, std::thread::hardware_concurrency()));
+    const long bands = std::min<long>(by, static_cast<long>(static_cast<long>(w) * h >= 256 * 256 ? cores : 1));
+    auto band = [&](long i) {
+        const long row0 = by * i / bands, row1 = by * (i + 1) / bands;
+        if (row1 <= row0) return;
+        const long y0 = row0 * bh, hh = std::min<long>(h, row1 * bh) - y0;
+        decode_astc(in + row0 * bx * 16, w, hh, bw, bh, out + y0 * w);
+    };
+    if (bands <= 1) {
+        band(0);
+    } else {
+        std::vector<std::thread> threads;
+        for (long i = 1; i < bands; ++i) threads.emplace_back(band, i);
+        band(0);
+        for (auto& t : threads) t.join();
+    }
+    // The decoder writes B, G, R, A bytes; GL takes R, G, B, A.
+    for (size_t i = 0, n = static_cast<size_t>(w) * h; i < n; ++i) {
+        const uint32_t p = out[i];
+        out[i] = (p & 0xff00ff00u) | ((p >> 16) & 0xffu) | ((p & 0xffu) << 16);
+    }
+    return true;
+}
+
+bool astc_emulated() {
+    static const bool on = [] {
+        const char* e = std::getenv("WINAPK_ASTC");
+        return !(e && e[0] == '0');
+    }();
+    return on;
+}
+
+}  // namespace winapk::host
diff --git a/windows/host/gl/astc_host.h b/windows/host/gl/astc_host.h
new file mode 100644
index 0000000..564b3be
--- /dev/null
+++ b/windows/host/gl/astc_host.h
@@ -0,0 +1,26 @@
+// ASTC on a GPU without it (desktop GPUs, through ANGLE): the guest is told
+// GL_KHR_texture_compression_astc_ldr is there, and its compressed uploads are
+// decoded here, in native code on several threads, and uploaded as RGBA8 (or
+// SRGB8_ALPHA8). Without this, Unity finds no ASTC and decodes every texture
+// itself, in arm64 code under translation: loading screens and every menu
+// waited on it.
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace winapk::host {
+
+// An ASTC internal format (KHR, LDR): its block size and whether it is sRGB.
+bool astc_format(unsigned format, int* block_w, int* block_h, bool* srgb);
+
+// One w x h image of ASTC blocks as RGBA8 rows, in the data's row order.
+// False when size is too small for it.
+bool astc_decode_rgba(const void* data, size_t size, int w, int h, int block_w, int block_h,
+                      std::vector<uint8_t>* rgba);
+
+// Whether the guest gets the ASTC emulation (WINAPK_ASTC=0 turns it off).
+bool astc_emulated();
+
+}  // namespace winapk::host
diff --git a/windows/host/gl/fbo_probe.cpp b/windows/host/gl/fbo_probe.cpp
new file mode 100644
index 0000000..70465d0
--- /dev/null
+++ b/windows/host/gl/fbo_probe.cpp
@@ -0,0 +1,414 @@
+// fbo_probe.cpp -- WINAPK_GL_FBO_PROBE=1: where a frame's pixels go.
+//
+// Counts the app's draws per framebuffer (gl_note_draw) and, every three
+// seconds at a swap, logs for each framebuffer drawn to in that frame its
+// color and depth attachments (texture or renderbuffer, size, internal
+// format, samples) and the colors of a block in its middle: whether a
+// render target the 3D went into holds the 3D or is black already. Float
+// targets (R11F_G11F_B10F, RGBA16F) are read as RGBA/FLOAT.
+//
+// WINAPK_GL_FBO_PROBE_DUMP=<dir>: when <dir>\dump.now exists at a probe, the
+// next frame is captured: every draw (framebuffer, program, textures bound,
+// plain uniform values) goes to <dir>\draws.txt, each program's shader
+// sources to <dir>\prog<N>.vs/.fs, and at its swap every framebuffer drawn
+// to as float RGBA rows (bottom row first) to <dir>\fb<N>_<w>x<h>_<fmt>.f32.
+// For diagnosis only; it reads back on the render thread.
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <mutex>
+#include <set>
+#include <string>
+#include <vector>
+
+#include <GLES3/gl32.h>
+#include <GLES2/gl2ext.h>
+
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <windows.h>
+
+namespace winapk::host {
+
+bool fbo_probe_on() {
+    static const bool on = [] {
+        const char* e = std::getenv("WINAPK_GL_FBO_PROBE");
+        return e && e[0] == '1';
+    }();
+    return on;
+}
+
+namespace {
+
+thread_local std::map<GLint, unsigned> t_draws;  // framebuffer -> draws this frame
+thread_local std::map<GLint, std::string> t_kinds;  // framebuffer -> the first draw's kind
+thread_local bool t_capture = false;  // this frame is being captured
+thread_local FILE* t_report = nullptr;
+thread_local unsigned t_seq = 0;
+std::set<GLuint> g_dumped_programs;
+
+const char* dump_dir() {
+    static const char* d = std::getenv("WINAPK_GL_FBO_PROBE_DUMP");
+    return d && *d ? d : nullptr;
+}
+
+void drain() {
+    while (glGetError() != GL_NO_ERROR) {
+    }
+}
+
+std::string attachment(GLenum which, GLint* fmt_out = nullptr) {
+    GLint type = GL_NONE, name = 0;
+    glGetFramebufferAttachmentParameteriv(GL_READ_FRAMEBUFFER, which, GL_FRAMEBUFFER_ATTACHMENT_OBJECT_TYPE, &type);
+    if (type == GL_NONE) return "none";
+    glGetFramebufferAttachmentParameteriv(GL_READ_FRAMEBUFFER, which, GL_FRAMEBUFFER_ATTACHMENT_OBJECT_NAME, &name);
+    char b[200];
+    GLint w = 0, h = 0, fmt = 0, samples = 0;
+    if (type == GL_RENDERBUFFER) {
+        GLint prev = 0;
+        glGetIntegerv(GL_RENDERBUFFER_BINDING, &prev);
+        glBindRenderbuffer(GL_RENDERBUFFER, static_cast<GLuint>(name));
+        glGetRenderbufferParameteriv(GL_RENDERBUFFER, GL_RENDERBUFFER_WIDTH, &w);
+        glGetRenderbufferParameteriv(GL_RENDERBUFFER, GL_RENDERBUFFER_HEIGHT, &h);
+        glGetRenderbufferParameteriv(GL_RENDERBUFFER, GL_RENDERBUFFER_INTERNAL_FORMAT, &fmt);
+        glGetRenderbufferParameteriv(GL_RENDERBUFFER, GL_RENDERBUFFER_SAMPLES, &samples);
+        glBindRenderbuffer(GL_RENDERBUFFER, static_cast<GLuint>(prev));
+        std::snprintf(b, sizeof b, "rb %d %dx%d fmt 0x%x samples %d", name, w, h, fmt, samples);
+    } else if (type == GL_TEXTURE) {
+        GLint level = 0;
+        glGetFramebufferAttachmentParameteriv(GL_READ_FRAMEBUFFER, which, GL_FRAMEBUFFER_ATTACHMENT_TEXTURE_LEVEL, &level);
+        GLint active = 0, prev = 0;
+        glGetIntegerv(GL_ACTIVE_TEXTURE, &active);
+        glActiveTexture(GL_TEXTURE0);
+        glGetIntegerv(GL_TEXTURE_BINDING_2D, &prev);
+        glBindTexture(GL_TEXTURE_2D, static_cast<GLuint>(name));
