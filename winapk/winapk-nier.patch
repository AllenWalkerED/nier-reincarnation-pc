+
+extern "C" WINAPK_GUEST_ABI void winapk_arm64_dispatch(uint64_t pc, CallbackFrame* frame) {
+    using namespace winapk::arm64;
+    ThreadState& ts = thread_state();
+    uint64_t gpr[8];
+    std::memcpy(gpr, frame->gpr, sizeof frame->gpr);
+    gpr[6] = frame->stack_args[0];
+    gpr[7] = frame->stack_args[1];
+    const uint64_t* words = frame->stack_args + 2;
+    const ULONG_PTR at = reinterpret_cast<ULONG_PTR>(words);
+    ULONG_PTR low = 0, high = 0;
+    GetCurrentThreadStackLimits(&low, &high);
+    const size_t left = high > at ? (high - at) / 8 : 0;
+    run_guest(ts, pc, gpr, frame->fpr, words, std::min(kCallbackStackWords, left), &frame->rax, &frame->rdx,
+              &frame->xmm0);
+}
+
+namespace winapk::arm64 {
+
+// WINAPK_GUEST_DUMP=<seconds>: every so often, each guest thread's host call.
+void start_guest_dump() {
+    char buf[16];
+    const DWORD n = GetEnvironmentVariableA("WINAPK_GUEST_DUMP", buf, sizeof buf);
+    if (n == 0 || n >= sizeof buf) return;
+    const int seconds = std::max(1, std::atoi(buf));
+    std::thread([seconds] {
+        const uint64_t exe = reinterpret_cast<uint64_t>(GetModuleHandleW(nullptr));
+        for (;;) {
+            Sleep(static_cast<DWORD>(seconds) * 1000);
+            std::string out = "[win.apk] guest threads:\n";
+            {
+                std::lock_guard<std::mutex> hold(g_stats_lock);
+                for (ThreadState* ts : g_live) {
+                    const uint64_t target = ts->host_target.load(std::memory_order_relaxed);
+                    const uint64_t caller = ts->host_caller.load(std::memory_order_relaxed);
+                    char line[160];
+                    std::snprintf(line, sizeof line, "  tid %lu depth %d host ", ts->thread_id, ts->depth);
+                    out += line;
+                    if (!target) {
+                        out += "-";
+                    } else {
+                        HMODULE mod = nullptr;
+                        char name[MAX_PATH] = "?";
+                        if (GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                                                   GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                                               reinterpret_cast<LPCSTR>(target), &mod)) {
+                            GetModuleFileNameA(mod, name, sizeof name);
+                        }
+                        const char* base = std::strrchr(name, '\\');
+                        std::snprintf(line, sizeof line, "%s+0x%llx", base ? base + 1 : name,
+                                      static_cast<unsigned long long>(target - (mod ? reinterpret_cast<uint64_t>(mod) : exe)));
+                        out += line;
+                    }
+                    out += " from ";
+                    out += caller ? where(caller) : std::string("-");
+                    out += "\n";
+                    // The guest's frame records: [fp] = caller's fp, [fp + 8] = return address.
+                    uint64_t fp = target ? ts->host_fp.load(std::memory_order_relaxed) : 0;
+                    for (int i = 0; i < 16 && fp && !(fp & 15); ++i) {
+                        MEMORY_BASIC_INFORMATION mbi{};
+                        if (!VirtualQuery(reinterpret_cast<const void*>(fp), &mbi, sizeof mbi) ||
+                            mbi.State != MEM_COMMIT || !(mbi.Protect & (PAGE_READWRITE | PAGE_READONLY))) {
+                            break;
+                        }
+                        const uint64_t next = reinterpret_cast<const uint64_t*>(fp)[0];
+                        const uint64_t ret = reinterpret_cast<const uint64_t*>(fp)[1];
+                        if (!ret) break;
+                        out += "      at ";
+                        out += where(ret);
+                        out += "\n";
+                        if (next <= fp) break;
+                        fp = next;
+                    }
+                }
+            }
+            std::fputs(out.c_str(), stderr);
+            std::fflush(stderr);
+        }
+    }).detach();
+}
+
+void init() {
+    static const bool done = [] {
+        start_guest_dump();
+        Hooks h;
+        h.code_range = code_range;
+        h.host_call = host_call;
+        h.full_state_call = full_state_call;
+        h.aot_entry = aot_entry;
+        h.plain_host = plain_host;
+        h.code_written = code_written;
+        h.svc = svc;
+        h.fault = fault;
+        set_hooks(h);
+        g_veh = AddVectoredExceptionHandler(1, execute_fault_handler);
+        register_shim_functions();
+        if (GetEnvironmentVariableA("WINAPK_ARM64_STATS", nullptr, 0) > 0) {
+            set_profiling(true);
+            std::atexit(print_stats);
+        }
+        return true;
+    }();
+    (void)done;
+}
+
+void register_code(const void* start, size_t size) {
+    init();
+    const uint64_t lo = reinterpret_cast<uint64_t>(start);
+    AcquireSRWLockExclusive(&g_ranges_lock);
+    g_ranges.push_back({lo, lo + size});
+    ReleaseSRWLockExclusive(&g_ranges_lock);
+}
+
+void unregister_code(const void* start) {
+    const uint64_t lo = reinterpret_cast<uint64_t>(start);
+    AcquireSRWLockExclusive(&g_ranges_lock);
+    g_ranges.erase(std::remove_if(g_ranges.begin(), g_ranges.end(), [&](const Range& r) { return r.lo == lo; }),
+                   g_ranges.end());
+    ReleaseSRWLockExclusive(&g_ranges_lock);
+}
+
+bool is_guest_code(const void* p) {
+    uint64_t lo, hi;
+    return code_range(reinterpret_cast<uint64_t>(p), &lo, &hi);
+}
+
+void* guest_intrinsic(const char* name) {
+    static const struct {
+        const char* name;
+        Intrinsic kind;
+    } kNames[] = {
+        {"setjmp", kSetjmp}, {"_setjmp", kSetjmp}, {"sigsetjmp", kSigsetjmp},
+        {"longjmp", kLongjmp}, {"_longjmp", kLongjmp}, {"siglongjmp", kLongjmp},
+        {"strtold", kStrtold}, {"strtold_l", kStrtold},
+    };
+    for (const auto& n : kNames) {
+        if (std::strcmp(n.name, name) == 0) return const_cast<uint8_t*>(&g_intrinsics[n.kind]);
+    }
+    return nullptr;
+}
+
+void* make_tail_hook(TailHook fn, void* ctx) {
+    static std::mutex lock;
+    std::lock_guard<std::mutex> hold(lock);
+    const size_t i = g_tail_hook_count.load(std::memory_order_relaxed);
+    if (i >= kTailHooks) return nullptr;
+    g_tail_hooks[i] = {fn, ctx};
+    g_tail_hook_count.store(i + 1, std::memory_order_release);  // the slot first, then the marker counts
+    return const_cast<uint8_t*>(&g_tail_markers[i]);
+}
+
+bool set_engine(Engine e) {
+    if (e == Engine::kJit && !jit_built()) return false;
+    g_engine.store(e);
+    return true;
+}
+
+Engine engine() { return g_engine.load(); }
+
+Stats stats() {
+    std::lock_guard<std::mutex> hold(g_stats_lock);
+    Stats s = g_exited;
+    for (ThreadState* t : g_live) add(s, t->totals());
+    return s;
+}
+
+void print_stats_if_enabled() {
+    if (GetEnvironmentVariableA("WINAPK_ARM64_STATS", nullptr, 0) > 0) print_stats();
+}
+
+void set_profiling(bool on) { g_profiling.store(on); }
+
+uint64_t call(const void* fn, const uint64_t* args, size_t nargs) {
+    init();
+    uint64_t gpr[8] = {};
+    if (nargs > 8) nargs = 8;
+    if (nargs) std::memcpy(gpr, args, 8 * nargs);
+    uint64_t x0 = 0;
+    run_guest(thread_state(), reinterpret_cast<uint64_t>(fn), gpr, nullptr, nullptr, 0, &x0, nullptr, nullptr);
+    return x0;
+}
+
+void set_signal_poll(SignalPoll poll) { g_signal_poll.store(poll, std::memory_order_release); }
+SignalPoll signal_poll() { return g_signal_poll.load(std::memory_order_acquire); }
+
+bool interrupt_thread(uint32_t tid) {
+    std::lock_guard<std::mutex> hold(g_stats_lock);
+    for (ThreadState* ts : g_live) {
+        if (ts->thread_id != tid) continue;
+        for (const auto& jit : ts->jits) jit->interrupt();
+        return true;
+    }
+    return false;
+}
+
+bool in_guest() { return t_state && t_state->depth > 0; }
+
+bool guest_registers(Cpu& out) {
+    if (!in_guest()) return false;
+    ThreadState& ts = *t_state;
+    if (ts.innermost_jit && ts.jits_running > 0) return ts.jits[ts.jits_running - 1]->snapshot(out);
+    out = ts.cpu;  // translated code and the interpreter write their registers to cpu before a host call
+    return true;
+}
+
+uint64_t call_on_stack(const void* fn, const uint64_t* args, size_t nargs, uint64_t sp) {
+    init();
+    uint64_t gpr[8] = {};
+    if (nargs > 8) nargs = 8;
+    if (nargs) std::memcpy(gpr, args, 8 * nargs);
+    uint64_t x0 = 0;
+    run_guest(thread_state(), reinterpret_cast<uint64_t>(fn), gpr, nullptr, nullptr, 0, &x0, nullptr, nullptr,
+              sp & ~uint64_t{15});
+    return x0;
+}
+
+void set_traced_new_string_utf(void* fn) {
+    g_traced_new_string_utf.store(reinterpret_cast<uint64_t>(fn), std::memory_order_relaxed);
+}
+
+std::string guest_backtrace(int depth) {
+    Cpu c;
+    if (!guest_registers(c)) return {};
+    std::string out = where(c.x[30]);
+    uint64_t fp = c.x[29];
+    for (int i = 1; i < depth && fp && !(fp & 15); ++i) {
+        MEMORY_BASIC_INFORMATION mbi{};
+        if (!VirtualQuery(reinterpret_cast<const void*>(fp), &mbi, sizeof mbi) || mbi.State != MEM_COMMIT ||
+            !(mbi.Protect & (PAGE_READWRITE | PAGE_READONLY))) {
+            break;
+        }
+        const uint64_t next = reinterpret_cast<const uint64_t*>(fp)[0];
+        const uint64_t ret = reinterpret_cast<const uint64_t*>(fp)[1];
+        if (!ret) break;
+        out += "; ";
+        out += where(ret);
+        if (next <= fp) break;
+        fp = next;
+    }
+    return out;
+}
+
+bool guest_stack_bounds(uint64_t* lo, uint64_t* hi) {
+    if (!t_state) return false;
+    *lo = reinterpret_cast<uint64_t>(t_state->stack) + kStackGuard;
+    *hi = t_state->stack_top + kStackSlack;
+    return true;
+}
+
+void* host_callable(void* fn) {
+    if (!is_guest_code(fn)) return fn;
+    static std::mutex lock;
+    static std::unordered_map<void*, void*> entries;
+    std::lock_guard<std::mutex> hold(lock);
+    auto it = entries.find(fn);
+    if (it != entries.end()) return it->second;
+    void* entry = make_r10_jump(reinterpret_cast<void*>(&winapk_arm64_sysv_entry), reinterpret_cast<uint64_t>(fn));
+    if (!entry) return fn;  // the fault path still works
+    entries.emplace(fn, entry);
+    return entry;
+}
+
+void register_va_list_function(const void* host_fn, unsigned index) {
+    AcquireSRWLockExclusive(&g_host_functions_lock);
+    g_host_functions[reinterpret_cast<uint64_t>(host_fn)].va_list = static_cast<int>(index);
+    ReleaseSRWLockExclusive(&g_host_functions_lock);
+}
+
+}  // namespace winapk::arm64
