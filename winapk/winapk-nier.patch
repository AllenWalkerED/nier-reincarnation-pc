+        {"Back", 0x0020}, {"Start", 0x0010}, {"LS", 0x0040}, {"RS", 0x0080}, {"DPadUp", 0x0001},
+        {"DPadDown", 0x0002}, {"DPadLeft", 0x0004}, {"DPadRight", 0x0008},
+    };
+    *trigger = n == "LT" ? 1 : n == "RT" ? 2 : 0;
+    for (const auto& k : kPads) {
+        if (n == k.name) return k.bit;
+    }
