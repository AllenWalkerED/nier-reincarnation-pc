+    if (d.state != WheelState::kIdle) {
+        const bool same_dir = (dx * d.slop_x + dy * d.slop_y) >= 0;
+        const bool moved = std::fabs(x0 - d.ax) > kWheelRestartPx || std::fabs(y0 - d.ay) > kWheelRestartPx;
+        if (moved || !same_dir || d.again) {
+            // Somewhere else, or the other way: finish this drag (it still
+            // stops and lifts as usual), then go down again under the pointer
+            // with this notch's travel only.
+            d.nx = x0;
+            d.ny = y0;
+            d.left_x = dx;
+            d.left_y = dy;
+            d.slop_x = slop_x;
+            d.slop_y = slop_y;
+            d.again = true;
+            if (d.state == WheelState::kMoving) {
+                d.state = WheelState::kStill;
+                d.still = 0;
+            } else if (d.state == WheelState::kDown) {
+                d.again = false;  // not moved yet: just take the new travel
+                d.left_x = dx;
+                d.left_y = dy;
+            }
+            return;
+        }
+        d.left_x += dx;
+        d.left_y += dy;
+        if (d.state == WheelState::kStill) d.state = WheelState::kMoving;
+        return;
+    }
+    d = WheelDrag{};
+    d.left_x = dx;
+    d.left_y = dy;
+    d.slop_x = slop_x;
+    d.slop_y = slop_y;
+    d.w = w;
+    d.h = h;
+    wheel_down(d, x0, y0);
+    SetTimer(hwnd, kWheelTimer, 8, nullptr);
+}
+
+void wheel_tick(HWND hwnd) {
+    WheelDrag& d = g_wheel;
+    if (d.state == WheelState::kIdle) {
+        KillTimer(hwnd, kWheelTimer);
+        return;
+    }
+    // One step per game frame; a game that shows no frame for 1.5 s (a load
+    // screen that stopped presenting) gets the steps anyway.
+    const uint64_t frame = perf::app_swaps();
+    const ULONGLONG now = GetTickCount64();
+    if (frame == d.frame && now - d.step_ms < 1500) return;
+    d.frame = frame;
+    d.step_ms = now;
+    switch (d.state) {
+        case WheelState::kIdle:
+            return;
+        case WheelState::kLifted: {
+            const float lx = d.left_x, ly = d.left_y;
+            wheel_down(d, d.nx, d.ny);
+            d.left_x = lx;
+            d.left_y = ly;
+            return;
+        }
+        case WheelState::kDown:
+            d.x += d.slop_x;
+            d.y += d.slop_y;
+            wheel_pointer(2, d.x, d.y);
+            d.state = WheelState::kMoving;
+            return;
+        case WheelState::kMoving: {
+            ++d.frames_moved;
+            const float len = std::sqrt(d.left_x * d.left_x + d.left_y * d.left_y);
+            if (len < 0.5f) {
+                d.left_x = d.left_y = 0;
+                d.state = WheelState::kStill;
+                d.still = 0;
+                wheel_pointer(2, d.x, d.y);
+                return;
+            }
+            // A third of what is left, at least 3 pixels (or the rest).
+            float k = 0.35f;
+            if (len * k < 3.0f) k = std::min(1.0f, 3.0f / len);
+            float nx = d.x + d.left_x * k, ny = d.y + d.left_y * k;
+            const float m = 2.0f;  // keep off the app's very edge
+            const float cx = std::max(m, std::min(d.w - m, nx)), cy = std::max(m, std::min(d.h - m, ny));
+            d.left_x -= cx - d.x;
+            d.left_y -= cy - d.y;
+            d.x = cx;
+            d.y = cy;
+            wheel_pointer(2, d.x, d.y);
+            if (cx != nx || cy != ny) {  // at the edge: lift, then go again under the pointer
+                d.state = WheelState::kStill;
+                d.still = 0;
+                d.again = true;
+            }
+            return;
+        }
+        case WheelState::kStill:
+            ++d.frames_moved;
+            // Still moves: the game sees the finger stop before it lifts.
+            wheel_pointer(2, d.x, d.y);
+            if (++d.still < kWheelStillFrames) return;
+            wheel_pointer(1, d.x, d.y);
+            if (d.again && (std::fabs(d.left_x) >= 0.5f || std::fabs(d.left_y) >= 0.5f)) {
+                // The lift needs a frame of its own before the next press.
+                d.state = WheelState::kLifted;
+                return;
+            }
+            g_wheel = WheelDrag{};
+            KillTimer(hwnd, kWheelTimer);
+            return;
+    }
+}
+
+// Whether the map holds `vk` down (it took its key-down).
+bool map_holds(WPARAM vk) { return g_map.loaded && vk < 256 && g_keys_held[static_cast<int>(vk)]; }
+
+// A key the map takes (true), or one that goes to the app as a key.
+bool map_key(HWND hwnd, bool down, WPARAM vk) {
+    if (!g_map.loaded || vk >= 256) return false;
+    const int k = static_cast<int>(vk);
+    if (k == VK_MENU || k == VK_LMENU || k == VK_RMENU) {
+        return g_finger == Finger::kMove;  // walk/run changes at the next tick; no menu-bar Alt while moving
+    }
+    if (k == g_map.up || k == g_map.left || k == g_map.down || k == g_map.right) {
+        g_keys_held[k] = down;
+        update_move(hwnd);
+        return true;
+    }
+    for (const MapBind& b : g_map.binds) {
+        if (b.vk == k) {
+            if (down && g_keys_held[k]) return true;  // auto-repeat
+            g_keys_held[k] = down;
+            tap(hwnd, &b, down);
+            return true;
+        }
+    }
+    return false;
+}
+
+// The controller, from the UI thread's timer.
+using XInputGetStateFn = DWORD(WINAPI*)(DWORD, XINPUT_STATE*);
+XInputGetStateFn g_xinput = nullptr;
+constexpr UINT_PTR kPadTimer = 0x7a11;
+
+// ---- the controller as a mouse ----
+bool g_pad_mouse = false;  // the controller is a mouse now
+bool g_pad_click = false;  // A holds the mouse's finger down
+float g_mouse_rest_x = 0, g_mouse_rest_y = 0;  // sub-pixel pointer motion carried over
+unsigned g_scroll_ticks = 0;
+
+// The pointer's place in the app (fractions), and whether it is on the app.
+bool cursor_on_app(HWND hwnd, float* fx, float* fy) {
+    POINT p;
+    if (!GetCursorPos(&p)) return false;
+    ScreenToClient(hwnd, &p);
+    const RECT r = client_app_rect(hwnd);
+    if (r.right <= r.left || r.bottom <= r.top || !PtInRect(&r, p)) return false;
+    *fx = static_cast<float>(p.x - r.left) / static_cast<float>(r.right - r.left);
+    *fy = static_cast<float>(p.y - r.top) / static_cast<float>(r.bottom - r.top);
+    return true;
+}
+
+// Lifts whatever finger the touch layout holds (a mode switch).
+void lift_mapped_finger(HWND hwnd) {
+    if (g_finger == Finger::kMove) map_pointer(hwnd, 1, g_cur_x, g_cur_y);
+    if (g_finger == Finger::kTap && g_tap) map_pointer(hwnd, 1, g_tap->x, g_tap->y);
+    g_finger = Finger::kNone;
+    g_tap = nullptr;
+}
+
+void set_pad_mouse(HWND hwnd, bool on) {
+    if (on == g_pad_mouse) return;
+    if (on) {
+        lift_mapped_finger(hwnd);
+        // The pointer starts in the middle of the app unless it is already on it.
+        float fx, fy;
+        if (!cursor_on_app(hwnd, &fx, &fy)) {
+            const RECT r = client_app_rect(hwnd);
+            POINT c{(r.left + r.right) / 2, (r.top + r.bottom) / 2};
+            ClientToScreen(hwnd, &c);
+            SetCursorPos(c.x, c.y);
+        }
+        g_mouse_rest_x = g_mouse_rest_y = 0;
+    } else if (g_pad_click) {
+        float fx = 0.5f, fy = 0.5f;
+        cursor_on_app(hwnd, &fx, &fy);
+        map_pointer(hwnd, 1, fx, fy);
+        g_pad_click = false;
+    }
+    g_pad_mouse = on;
+    std::fprintf(stderr, "[win.apk] controller: %s\n", on ? "mouse" : "touch layout");
+}
+
+// One poll in mouse mode: the left stick moves the pointer (faster the
+// further it is pushed), A clicks and drags, the right stick scrolls.
+void pad_mouse_tick(HWND hwnd, const XINPUT_GAMEPAD& gp, WORD now, WORD changed) {
+    float lx = gp.sThumbLX / 32767.0f, ly = -gp.sThumbLY / 32767.0f;
+    const float mag = std::sqrt(lx * lx + ly * ly);
+    if (mag > 0.15f) {
+        const float m = std::min(1.0f, (mag - 0.15f) / 0.85f);
+        const RECT r = client_app_rect(hwnd);
+        const float px_per_tick = static_cast<float>(r.bottom - r.top) * 0.022f * g_map.mouse_speed * m * m + 0.6f * m;
+        g_mouse_rest_x += lx / mag * px_per_tick;
+        g_mouse_rest_y += ly / mag * px_per_tick;
+        const int dx = static_cast<int>(g_mouse_rest_x), dy = static_cast<int>(g_mouse_rest_y);
+        g_mouse_rest_x -= static_cast<float>(dx);
+        g_mouse_rest_y -= static_cast<float>(dy);
+        if (dx || dy) {
+            POINT p;
+            GetCursorPos(&p);
+            RECT box = r;  // the pointer stays on the app
+            MapWindowPoints(hwnd, nullptr, reinterpret_cast<POINT*>(&box), 2);
+            p.x = std::max(box.left, std::min(box.right - 1, p.x + dx));
+            p.y = std::max(box.top, std::min(box.bottom - 1, p.y + dy));
+            SetCursorPos(p.x, p.y);
+            float fx, fy;
+            if (g_pad_click && cursor_on_app(hwnd, &fx, &fy)) map_pointer(hwnd, 2, fx, fy);
+        }
+    }
+    if (changed & 0x1000) {  // A
+        float fx, fy;
+        if ((now & 0x1000) && !g_pad_click && !g_pointer_down && cursor_on_app(hwnd, &fx, &fy)) {
+            wheel_end(hwnd);
+            map_pointer(hwnd, 0, fx, fy);
+            g_pad_click = true;
+        } else if (!(now & 0x1000) && g_pad_click) {
+            if (!cursor_on_app(hwnd, &fx, &fy)) fx = fy = 0.5f;
+            map_pointer(hwnd, 1, fx, fy);
+            g_pad_click = false;
+        }
+    }
+    // The right stick: a wheel notch at the pointer every few polls.
+    const float ry = gp.sThumbRY / 32767.0f;
+    if (std::fabs(ry) > 0.5f && !g_pad_click && (g_scroll_ticks++ % 6) == 0) {
+        POINT p;
+        GetCursorPos(&p);
+        const int notch = static_cast<int>(WHEEL_DELTA * (ry > 0 ? 1 : -1) * (std::fabs(ry) > 0.9f ? 2 : 1));
+        send_wheel(hwnd, MAKEWPARAM(0, static_cast<WORD>(static_cast<short>(notch))), MAKELPARAM(p.x, p.y), false);
+    } else if (std::fabs(ry) <= 0.5f) {
+        g_scroll_ticks = 0;
+    }
+}
+
+void poll_pad(HWND hwnd) {
+    move_tick(hwnd);
+    XINPUT_STATE st{};
+    if (!g_xinput || g_xinput(0, &st) != ERROR_SUCCESS) {
+        g_stick_x = g_stick_y = 0;
+        return;
+    }
+    const XINPUT_GAMEPAD& gp = st.Gamepad;
+    {
+        // The mouse-mode switch: its button (or trigger) going down.
+        const WORD now = gp.wButtons, changed = static_cast<WORD>(now ^ g_pad_prev);
+        bool toggled = false;
+        if (g_map.mouse_toggle && (changed & g_map.mouse_toggle) && (now & g_map.mouse_toggle)) toggled = true;
+        if (g_map.mouse_toggle_trigger) {
+            const int t = g_map.mouse_toggle_trigger - 1;
+            const BYTE v = t ? gp.bRightTrigger : gp.bLeftTrigger;
+            if (v > 100 && g_trig_prev[t] <= 100) toggled = true;
+        }
+        if (toggled) set_pad_mouse(hwnd, !g_pad_mouse);
+        if (g_pad_mouse) {
+            g_stick_x = g_stick_y = 0;
+            pad_mouse_tick(hwnd, gp, now, changed);
+            if (changed & 0x2000) g_input->key((now & 0x2000) ? 0 : 1, 4, 0, 0);  // B: Back
+            g_pad_prev = now;
+            g_trig_prev[0] = gp.bLeftTrigger;
+            g_trig_prev[1] = gp.bRightTrigger;
+            return;
+        }
+    }
+    const float sx = gp.sThumbLX / 32767.0f, sy = -gp.sThumbLY / 32767.0f;
+    const bool moved = std::fabs(sx - g_stick_x) > 0.02f || std::fabs(sy - g_stick_y) > 0.02f;
+    g_stick_x = std::fabs(sx) < 0.2f ? 0 : sx;
+    g_stick_y = std::fabs(sy) < 0.2f ? 0 : sy;
+    if (moved) update_move(hwnd);
+    const WORD now = gp.wButtons, changed = static_cast<WORD>(now ^ g_pad_prev);
+    if (changed || moved || g_stick_x != 0 || g_stick_y != 0) g_last_input_ms.store(GetTickCount64(), std::memory_order_relaxed);
+    if (changed & 0x2000) g_input->key((now & 0x2000) ? 0 : 1, 4, 0, 0);  // B: Back
+    const BYTE trig[2] = {gp.bLeftTrigger, gp.bRightTrigger};
+    for (const MapBind& b : g_map.binds) {
+        if (b.pad && b.pad == g_map.mouse_toggle) continue;
+        if (b.pad && (changed & b.pad)) tap(hwnd, &b, (now & b.pad) != 0);
+        if (b.trigger) {
+            const int t = b.trigger - 1;
+            const bool was = g_trig_prev[t] > 100, is = trig[t] > 100;
+            if (was != is) tap(hwnd, &b, is);
+        }
+    }
+    g_pad_prev = now;
+    g_trig_prev[0] = trig[0];
+    g_trig_prev[1] = trig[1];
+}
+
+void start_input_map(HWND hwnd) {
+    load_input_map();
+    if (!g_map.loaded) return;
+    HMODULE x = LoadLibraryW(L"xinput1_4.dll");
+    if (!x) x = LoadLibraryW(L"xinput9_1_0.dll");
+    g_xinput = x ? reinterpret_cast<XInputGetStateFn>(reinterpret_cast<void*>(GetProcAddress(x, "XInputGetState"))) : nullptr;
+    SetTimer(hwnd, kPadTimer, 16, nullptr);
+}
+
+// The player's last input (keys, mouse, controller), for WINAPK_IDLE_FPS.
+std::atomic<unsigned long long> g_last_input_ms{0};
+void note_input_message(UINT msg) {
+    if ((msg >= WM_KEYFIRST && msg <= WM_KEYLAST) || (msg >= WM_MOUSEFIRST && msg <= WM_MOUSELAST))
+        g_last_input_ms.store(GetTickCount64(), std::memory_order_relaxed);
+}
