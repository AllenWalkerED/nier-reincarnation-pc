+    // Publish the whole library before the loader or AOT can use it. The
+    // AOT loader checks the code hash before accepting any old translation.
+    const fs::path tmp = winapk::arm64::aot_temp_name(so);
+    std::error_code ec;
+    if (fs::copy_file(so, tmp, ec)) {
+        std::fstream output(tmp, std::ios::binary | std::ios::in | std::ios::out);
+        output.seekp(offset).write(reinterpret_cast<const char*>(&target), sizeof target);
+        output.close();
+        if (output && winapk::arm64::aot_replace(tmp, so)) {
+            std::fprintf(stderr, "[win.apk] title render size: %s\n", scaled ? "DeviceMax" : "HD (Game default)");
+            return;
+        }
+        fs::remove(tmp, ec);
+    }
+    std::fprintf(stderr, "[win.apk] could not set the title render size\n");
+}
