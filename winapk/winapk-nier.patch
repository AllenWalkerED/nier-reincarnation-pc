+// On Vulkan, float literals a hair above FLT_MAX in decimal (Unity's HLSLcc
+// writes FLT_MAX as 3.40282347e+38) become 3.40282346e+38, which is the same
+// float. This ANGLE takes the decimal value as out of range and the literal
+// as infinity, and current Vulkan drivers (NVIDIA 6xx, recent Intel) fold
+// arithmetic on an infinite constant as if it could not happen:
+// Post Processing's color-grading LUT computes sign(x) as
+// saturate(x * 3.40282347e+38 + 0.5) * 2 - 1, which they make -1, so the
+// LUT is black and so is every 3D frame graded through it. The Direct3D 11
+// backend's compiler keeps the old result; it is left alone.
+// WINAPK_GL_FLT_MAX_FIX=0 turns this off. Returns whether src changed.
+bool fix_flt_max_literals(std::string* src) {
+    if (!fix_flt_max_on()) return false;
+    auto ident = [](char c) { return std::isalnum(static_cast<unsigned char>(c)) || c == '_'; };
+    auto digit = [](char c) { return c >= '0' && c <= '9'; };
+    std::string& s = *src;
+    bool changed = false;
+    for (size_t at = 0; (at = s.find("38", at)) != std::string::npos; at += 2) {
+        // ...[digits][.digits](e|E)[+]38 ending here, not inside a name
+        size_t e = at;
+        if (e > 0 && s[e - 1] == '+') --e;
+        if (e == 0 || (s[e - 1] != 'e' && s[e - 1] != 'E')) continue;
+        size_t begin = e - 1;
+        while (begin > 0 && (digit(s[begin - 1]) || s[begin - 1] == '.')) --begin;
+        if (begin == e - 1 || (begin > 0 && ident(s[begin - 1]))) continue;
+        const size_t end = at + 2;
+        if (end < s.size() && ident(s[end]) && s[end] != 'f' && s[end] != 'F') continue;
+        const double v = std::strtod(s.substr(begin, end - begin).c_str(), nullptr);
+        // above FLT_MAX, but still rounding to it (not to infinity)
+        if (!(v > 3.4028234663852886e+38 && v < 3.4028235677973366e+38)) continue;
+        s.replace(begin, end - begin, "3.40282346e+38");
+        at = begin + 12;
+        changed = true;
+    }
+    if (changed) {
+        static std::atomic<bool> told{false};
+        if (!told.exchange(true)) std::fprintf(stderr, "[win.apk] GL: FLT_MAX literals rewritten for Vulkan (WINAPK_GL_FLT_MAX_FIX)\n");
+    }
+    return changed;
+}
+// A shader that samples an external texture samples it as 2D: the
+// extension's #extension line goes and samplerExternalOES is sampler2D.
+WINAPK_GUEST_ABI void guest_glShaderSource(GLuint shader, GLsizei count, const GLchar *const*string, const GLint *length) {
+    std::string src;
+    for (GLsizei i = 0; string && i < count; ++i) {
+        if (!string[i]) continue;
+        if (length && length[i] >= 0) src.append(string[i], static_cast<size_t>(length[i]));
+        else src.append(string[i]);
+    }
+    const bool literals = winapk::host::gl_on_vulkan() && fix_flt_max_literals(&src);
+    // WINAPK_GL_HIGHP=1: every mediump and lowp made highp (a driver that
+    // honours reduced precision computes those in 16 bits).
+    static const bool highp = [] {
+        const char* e = std::getenv("WINAPK_GL_HIGHP");
+        const bool on = e && e[0] == '1';
+        if (on) std::fprintf(stderr, "[win.apk] GL: shaders forced to highp (WINAPK_GL_HIGHP)\n");
+        return on;
+    }();
+    const bool external = src.find("samplerExternalOES") != std::string::npos;
+    if (!external && !literals && !(highp && (src.find("mediump") != std::string::npos || src.find("lowp") != std::string::npos))) {
+        glShaderSource(shader, count, string, length);
+        return;
+    }
+    if (!external && !highp) {
+        const GLchar* one = src.c_str();
+        glShaderSource(shader, 1, &one, nullptr);
+        return;
+    }
+    if (!external) {
+        auto word = [](char c) { return std::isalnum(static_cast<unsigned char>(c)) || c == '_'; };
+        for (const char* q : {"mediump", "lowp"}) {
+            const size_t n = std::strlen(q);
+            for (size_t at = 0; (at = src.find(q, at)) != std::string::npos;) {
+                if ((at > 0 && word(src[at - 1])) || (at + n < src.size() && word(src[at + n]))) {
+                    at += n;
+                    continue;
+                }
+                src.replace(at, n, "highp");
+                at += 5;
+            }
+        }
+        const GLchar* one = src.c_str();
+        glShaderSource(shader, 1, &one, nullptr);
+        return;
+    }
+    std::string out;
+    size_t pos = 0;
+    while (pos < src.size()) {
+        size_t end = src.find('\n', pos);
+        if (end == std::string::npos) end = src.size();
+        std::string line = src.substr(pos, end - pos);
+        if (line.find("#extension") != std::string::npos && line.find("GL_OES_EGL_image_external") != std::string::npos) {
+            line = "";
+        }
+        for (size_t at; (at = line.find("samplerExternalOES")) != std::string::npos;) line.replace(at, 18, "sampler2D");
+        out += line;
+        if (end < src.size()) out += '\n';
+        pos = end + 1;
+    }
+    static int logged = 0;
+    if (logged++ < 4) std::fprintf(stderr, "[win.apk] external-texture shader %u sampled as 2D\n", shader);
+    const GLchar* one = out.c_str();
+    glShaderSource(shader, 1, &one, nullptr);
+}
