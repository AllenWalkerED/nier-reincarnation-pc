+// ANGLE's own state of the features the depth path depends on, from
+// EGL_ANGLE_feature_control: what this GPU and driver actually got.
+void log_angle_features(EGLDisplay d) {
+    using QueryAttrib = EGLBoolean(EGLAPIENTRY*)(EGLDisplay, EGLint, EGLAttrib*);
+    using QueryStringi = const char*(EGLAPIENTRY*)(EGLDisplay, EGLint, EGLint);
+    auto count_of = reinterpret_cast<QueryAttrib>(eglGetProcAddress("eglQueryDisplayAttribANGLE"));
+    auto stringi = reinterpret_cast<QueryStringi>(eglGetProcAddress("eglQueryStringiANGLE"));
+    EGLAttrib n = 0;
+    if (!count_of || !stringi || !count_of(d, 0x3465 /* EGL_FEATURE_COUNT_ANGLE */, &n)) return;
+    std::string line;
+    for (EGLint i = 0; i < static_cast<EGLint>(n); ++i) {
+        const char* name = stringi(d, 0x3460 /* EGL_FEATURE_NAME_ANGLE */, i);
+        const char* status = stringi(d, 0x3464 /* EGL_FEATURE_STATUS_ANGLE */, i);
+        if (!name || !status) continue;
+        for (const char* want : {"supportsDepthClipControl", "supportsDepthClampZeroOne", "supportsExtendedDynamicState",
+                                 "supportsDynamicRendering", "supportsGraphicsPipelineLibrary",
+                                 "preferDrawClearOverVkCmdClearAttachments", "supportsRenderPassLoadStoreOpNone"}) {
+            if (std::strcmp(name, want) == 0) line = line + " " + name + "=" + status;
+        }
+    }
+    std::fprintf(stderr, "[win.apk] GL: ANGLE features:%s\n", line.c_str());
+}
+
+// Appends `list` to the ANGLE feature list `var`, keeping the player's own.
+void add_angle_features(const char* var, const char* list) {
+    std::string all = list;
+    if (const char* own = std::getenv(var)) {
+        if (*own) all = std::string(own) + ":" + all;
+    }
+    SetEnvironmentVariableA(var, all.c_str());
+    _putenv_s(var, all.c_str());
+}
+
+// An NVIDIA RTX 50 series GPU (Blackwell) among the adapters.
+bool has_blackwell(char* name, size_t size) {
+    HMODULE dxgi = LoadLibraryW(L"dxgi.dll");
+    using Create = HRESULT(WINAPI*)(REFIID, void**);
+    auto create = dxgi ? reinterpret_cast<Create>(GetProcAddress(dxgi, "CreateDXGIFactory1")) : nullptr;
+    IDXGIFactory1* factory = nullptr;
+    if (!create || FAILED(create(__uuidof(IDXGIFactory1), reinterpret_cast<void**>(&factory)))) return false;
+    bool found = false;
+    IDXGIAdapter1* adapter = nullptr;
+    for (UINT i = 0; !found && factory->EnumAdapters1(i, &adapter) != DXGI_ERROR_NOT_FOUND; ++i) {
+        DXGI_ADAPTER_DESC1 desc;
+        if (SUCCEEDED(adapter->GetDesc1(&desc)) && desc.VendorId == 0x10DE && desc.DeviceId >= 0x2B00 &&
+            desc.DeviceId < 0x3000) {
+            found = true;
+            WideCharToMultiByte(CP_UTF8, 0, desc.Description, -1, name, static_cast<int>(size), nullptr, nullptr);
+        }
+        adapter->Release();
+    }
+    factory->Release();
+    return found;
+}
