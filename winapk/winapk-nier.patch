+void watch_d3d11(EGLDisplay d) {
+    using QueryDisplay = EGLBoolean(EGLAPIENTRY*)(EGLDisplay, EGLint, EGLAttrib*);
+    using QueryDevice = EGLBoolean(EGLAPIENTRY*)(void*, EGLint, EGLAttrib*);
+    auto query_display = reinterpret_cast<QueryDisplay>(eglGetProcAddress("eglQueryDisplayAttribEXT"));
+    auto query_device = reinterpret_cast<QueryDevice>(eglGetProcAddress("eglQueryDeviceAttribEXT"));
+    EGLAttrib egl_device = 0, d3d = 0;
+    if (!query_display || !query_device || !query_display(d, 0x322C /* EGL_DEVICE_EXT */, &egl_device) ||
+        !query_device(reinterpret_cast<void*>(egl_device), 0x33A1 /* EGL_D3D11_DEVICE_ANGLE */, &d3d) || !d3d) {
+        std::fprintf(stderr, "[win.apk] D3D11: ANGLE did not give its device; no diagnostics\n");
+        return;
+    }
+    auto* device = reinterpret_cast<ID3D11Device*>(d3d);
+    device->AddRef();
+    ID3D11InfoQueue* queue = nullptr;
+    if (SUCCEEDED(device->QueryInterface(__uuidof(ID3D11InfoQueue), reinterpret_cast<void**>(&queue)))) {
+        D3D11_MESSAGE_SEVERITY deny[] = {D3D11_MESSAGE_SEVERITY_INFO, D3D11_MESSAGE_SEVERITY_MESSAGE};
+        D3D11_INFO_QUEUE_FILTER filter{};
+        filter.DenyList.NumSeverities = 2;
+        filter.DenyList.pSeverityList = deny;
+        queue->AddStorageFilterEntries(&filter);
+        queue->SetMessageCountLimit(4096);
+        g_debug_queue = queue;
+        AddVectoredExceptionHandler(1, on_debug_layer_exception);
+        std::fprintf(stderr, "[win.apk] D3D11: debug layer on; its messages are logged when the device is lost or it "
+                             "ends the process\n");
+    } else {
+        std::fprintf(stderr, "[win.apk] D3D11: no debug layer (Graphics Tools not installed?); only device loss is logged\n");
+    }
+    // Only the device is asked (thread-safe); the queue is read when something
+    // happened, not while the app draws.
+    std::thread([device, queue] {
+        std::map<int, unsigned> seen;
+        for (;;) {
+            const HRESULT r = device->GetDeviceRemovedReason();
+            if (r != S_OK) {
+                std::fprintf(stderr, "[win.apk] D3D11: the device was lost: 0x%08lx %s\n", static_cast<unsigned long>(r),
+                             removed_reason(r));
+                if (queue) drain(queue, seen);
+                dump_draws();
+                std::fflush(stderr);
+                return;
+            }
+            std::fflush(stderr);
+            Sleep(200);
+        }
+    }).detach();
+}
