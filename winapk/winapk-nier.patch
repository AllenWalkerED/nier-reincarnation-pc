+                ws();
+                if (*p == ':') ++p;
+                j.obj.emplace_back(k.str, value());
+                ws();
+                if (*p == ',') ++p;
+                else if (*p == '}') { ++p; break; }
+                else break;
+            }
+        } else if (*p == '[') {
+            j.kind = Json::kArr;
+            ++p;
+            for (;;) {
+                ws();
+                if (*p == ']') { ++p; break; }
