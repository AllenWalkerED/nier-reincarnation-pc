+// ---- Android paths for guest code ----------------------------------------------
+// Java here works with host paths: the android root's folders mirror a
+// device's (data\\app\\<pkg>\\base.apk, data\\data\\<pkg>\\files), and
+// getFilesDir() or ApplicationInfo.sourceDir name them "D:\\...". Native code
+// from a device takes a path as absolute only when it starts with '/': Unity
+// reads its APK's entries through "<sourceDir>/assets/..." and lost them (it
+// looked on disk, then said "Not enough storage space to install required
+// resources"), and dropped its files folder. So a Java string that names a
+// place under the root reaches guest code in Android's form, "/data/...",
+// which the shim maps back (bionic/paths.cpp).
+std::string android_form(const char* s) {
+    static const std::string root = winapk::android_root_utf8();
+    if (!s || root.empty()) return {};
+    const size_t n = root.size();
+    if (std::strlen(s) <= n || (s[n] != '\\' && s[n] != '/')) return {};
+    for (size_t i = 0; i < n; ++i) {
+        char a = s[i], b = root[i];
+        if (a == '/') a = '\\';
+        if (b == '/') b = '\\';
+        if (std::tolower(static_cast<unsigned char>(a)) != std::tolower(static_cast<unsigned char>(b))) return {};
+    }
+    std::string out(s + n);
+    for (char& c : out) {
+        if (c == '\\') c = '/';
+    }
+    return out;
+}
+
+// The copies handed out, so that ReleaseStringUTFChars gives the JVM its own.
+std::mutex g_path_copies_lock;
+std::unordered_map<const char*, const char*> g_path_copies;  // copy -> the JVM's chars
+
+WINAPK_GUEST_ABI const char* guest_get_string_utf_chars(JNIEnv* genv, jstring str, jboolean* is_copy) {
+    GuestEnv* g = guest_env_from(genv);
+    JNIEnv* env = g ? g->host : genv;
+    const char* chars = env->GetStringUTFChars(str, is_copy);
+    const std::string android = android_form(chars);
+    if (android.empty()) return chars;
+    char* copy = static_cast<char*>(std::malloc(android.size() + 1));
+    std::memcpy(copy, android.c_str(), android.size() + 1);
+    std::lock_guard<std::mutex> hold(g_path_copies_lock);
+    g_path_copies[copy] = chars;
+    if (is_copy) *is_copy = JNI_TRUE;
+    return copy;
+}
+
+WINAPK_GUEST_ABI void guest_release_string_utf_chars(JNIEnv* genv, jstring str, const char* chars) {
+    GuestEnv* g = guest_env_from(genv);
+    JNIEnv* env = g ? g->host : genv;
+    const char* original = chars;
+    {
+        std::lock_guard<std::mutex> hold(g_path_copies_lock);
+        auto it = g_path_copies.find(chars);
+        if (it != g_path_copies.end()) {
+            original = it->second;
+            g_path_copies.erase(it);
+        }
+    }
+    env->ReleaseStringUTFChars(str, original);
+    if (original != chars) std::free(const_cast<char*>(chars));
