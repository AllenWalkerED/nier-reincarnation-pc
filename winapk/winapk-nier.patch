+// back at every tick, it cost a whole-window glReadPixels each time, which
+// waits for the GPU to finish the app's frame too (measured: 8-17 ms a frame
+// on Direct3D 11, ~11 ms a read on Vulkan).
+std::atomic<unsigned long long> g_direct_last_ms{0};
