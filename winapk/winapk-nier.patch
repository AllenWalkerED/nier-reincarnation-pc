+        MEMORY_BASIC_INFORMATION mbi{};
+        if (!VirtualQuery(reinterpret_cast<const void*>(rsp), &mbi, sizeof(mbi)) || mbi.State != MEM_COMMIT) return;
+        const auto* top = reinterpret_cast<const uint64_t*>(rsp);
+        const auto* end = reinterpret_cast<const uint64_t*>(static_cast<const char*>(mbi.BaseAddress) + mbi.RegionSize);
+        copied = std::min<size_t>(static_cast<size_t>(end - top), stack.size());
+        std::memcpy(stack.data(), top, copied * sizeof(uint64_t));
+    };
+    if (!g_get_description)
+        g_get_description = reinterpret_cast<GetDescription>(
+            reinterpret_cast<void*>(GetProcAddress(GetModuleHandleW(L"kernel32.dll"), "GetThreadDescription")));
+    HANDLE t = OpenThread(THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_LIMITED_INFORMATION, FALSE, tid);
+    if (t && g_get_description) {
+        PWSTR d = nullptr;
+        if (SUCCEEDED(g_get_description(t, &d)) && d) {
+            name = d;
+            LocalFree(d);
+        }
+    }
+    if (context) {
+        const auto* c = static_cast<const CONTEXT*>(context);
+        rip = c->Rip;
+        copy_from(c->Rsp);
+    } else if (t && SuspendThread(t) != static_cast<DWORD>(-1)) {
+        CONTEXT c{};
+        c.ContextFlags = CONTEXT_CONTROL;
+        if (GetThreadContext(t, &c)) {
+            rip = c.Rip;
+            copy_from(c.Rsp);
+        }
+        ResumeThread(t);
+    }
+    if (t) CloseHandle(t);
+    char where[512] = "?", frame[512];
+    if (!describe(reinterpret_cast<const void*>(rip), where, sizeof(where)))
+        name_address(rip, where, sizeof(where), false);
+    std::fprintf(stderr, "[win.apk] thread %lu \"%ls\" at %s\n", tid, name.c_str(), where);
+    int found = 0;
+    for (size_t i = 0; i < copied && found < 32; ++i) {
+        if (!name_address(stack[i], frame, sizeof(frame), true)) continue;  // code only
+        describe(reinterpret_cast<const void*>(stack[i]), frame, sizeof(frame));  // a guest library's name when it has one
