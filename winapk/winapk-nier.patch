+    constexpr std::streamoff library_size = 127359872;
+    constexpr std::streamoff offset = 0x2EC1D04;
+    constexpr uint32_t hd = 0x528000a1;         // mov w1, #5
+    constexpr uint32_t device_max = 0x52800101; // mov w1, #8
