+
+void fbo_probe_link(unsigned int program) {
+    if (!fbo_probe_on() || !dump_dir()) return;
+    GLuint shaders[4] = {};
+    GLsizei count = 0;
+    glGetAttachedShaders(program, 4, &count, shaders);
+    std::vector<std::pair<GLint, std::string>> out;
+    for (GLsizei i = 0; i < count; ++i) {
+        GLint type = 0, len = 0;
+        glGetShaderiv(shaders[i], GL_SHADER_TYPE, &type);
+        glGetShaderiv(shaders[i], GL_SHADER_SOURCE_LENGTH, &len);
+        if (len <= 0) continue;
+        std::string src(static_cast<size_t>(len), '\0');
+        glGetShaderSource(shaders[i], len, nullptr, src.data());
+        src.resize(std::strlen(src.c_str()));
+        out.emplace_back(type, std::move(src));
+    }
+    drain();
+    std::lock_guard<std::mutex> hold(g_sources_lock);
+    g_sources[program] = std::move(out);
+}
+
+void fbo_probe_draw(const char* what) {
+    if (!fbo_probe_on() || !what || std::strcmp(what, "swap") == 0) return;
+    GLint fb = 0;
+    glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &fb);
+    if (t_draws[fb]++ == 0) t_kinds[fb] = what;
+    if (t_capture) capture_draw(fb, what);
+}
+
+void fbo_probe_frame(int win_w, int win_h) {
+    if (!fbo_probe_on()) return;
+    static unsigned long long last = 0;
+    const unsigned long long now = GetTickCount64();
+    const bool captured = t_capture;
+    if (!captured && now - last < 3000) {
+        t_draws.clear();
+        t_kinds.clear();
+        return;
+    }
+    last = now;
+    GLint read_fb = 0, pack_buf = 0, align = 4;
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read_fb);
+    glGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING, &pack_buf);
+    glGetIntegerv(GL_PACK_ALIGNMENT, &align);
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+    glPixelStorei(GL_PACK_ALIGNMENT, 1);
+    t_draws[0] += 0;  // the window, always
+    std::fprintf(stderr, "[probe] ---- frame%s: %zu framebuffers drawn\n", captured ? " (captured)" : "", t_draws.size());
+    for (const auto& [fb, draws] : t_draws) {
+        glBindFramebuffer(GL_READ_FRAMEBUFFER, static_cast<GLuint>(fb));
+        const GLenum status = glCheckFramebufferStatus(GL_READ_FRAMEBUFFER);
+        GLint fmt = 0;
+        std::string color = fb ? attachment(GL_COLOR_ATTACHMENT0, &fmt) : "window";
+        std::string depth = fb ? attachment(GL_DEPTH_ATTACHMENT) : "-";
+        const int w = fb ? size_of(GL_COLOR_ATTACHMENT0, true) : win_w, h = fb ? size_of(GL_COLOR_ATTACHMENT0, false) : win_h;
+        std::string mid = status != GL_FRAMEBUFFER_COMPLETE ? "incomplete" : color == "none" ? "depth only" : middle(w, h);
+        std::fprintf(stderr, "[probe] fb %d: %u draws (first %s), status 0x%x | color %s | depth %s | %s\n", fb, draws,
+                     t_kinds[fb].c_str(), status, color.c_str(), depth.c_str(), mid.c_str());
+        if (captured && status == GL_FRAMEBUFFER_COMPLETE && color != "none") dump_framebuffer(fb, w, h, fmt);
+    }
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, static_cast<GLuint>(read_fb));
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, static_cast<GLuint>(pack_buf));
+    glPixelStorei(GL_PACK_ALIGNMENT, align);
+    drain();
+    t_draws.clear();
+    t_kinds.clear();
+    if (captured) {
+        t_capture = false;
+        if (t_report) std::fclose(t_report);
+        t_report = nullptr;
+        std::fprintf(stderr, "[probe] capture written to %s\n", dump_dir());
+    } else if (dump_dir()) {
+        const std::string trigger = std::string(dump_dir()) + "\\dump.now";
+        if (GetFileAttributesA(trigger.c_str()) != INVALID_FILE_ATTRIBUTES) {
+            DeleteFileA(trigger.c_str());
+            t_report = std::fopen((std::string(dump_dir()) + "\\draws.txt").c_str(), "wb");
+            t_capture = t_report != nullptr;
+            t_seq = 0;
+            std::fprintf(stderr, "[probe] capturing the next frame\n");
+        }
+    }
+}
