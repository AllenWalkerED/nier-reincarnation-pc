+// WINAPK_GL_SHADER_LOG=1: shaders and programs ANGLE did not build, with its log.
+bool shader_log() {
+    static const bool on = std::getenv("WINAPK_GL_SHADER_LOG") != nullptr;
+    return on;
+}
+void shader_failed(const char* what, GLuint id, const char* log) {
+    static std::atomic<int> n{0};
+    if (n++ < 20) std::fprintf(stderr, "[win.apk] GL: %s %u did not build: %.600s\n", what, id, log);
+}
+WINAPK_GUEST_ABI void guest_glCompileShader(GLuint shader) {
+    const perf::Scope timed(perf::kShaderCompile);
+    glCompileShader(shader);
+    if (!shader_log()) return;
+    GLint ok = GL_TRUE;
+    glGetShaderiv(shader, GL_COMPILE_STATUS, &ok);
+    if (ok) return;
+    char log[1024] = "";
+    glGetShaderInfoLog(shader, sizeof log, nullptr, log);
+    shader_failed("shader", shader, log);
+}
