+WINAPK_GUEST_ABI jstring guest_new_string_utf(JNIEnv* genv, const char* utf) {
+    GuestEnv* g = guest_env_from(genv);
+    JNIEnv* env = g ? g->host : genv;
+    const std::string host = host_form(utf);
