+void fault(Cpu& c, uint32_t insn, const char* what) {
+    std::fprintf(stderr, "[win.apk] arm64 guest stopped: %s, instruction 0x%08x at %s (lr %s) on thread %lu, sp 0x%llx\n",
+                 what, insn, where(c.pc).c_str(), where(c.x[30]).c_str(), GetCurrentThreadId(),
+                 static_cast<unsigned long long>(c.sp));
+    for (int i = 0; i < 31; ++i) {
+        std::fprintf(stderr, "[win.apk]   x%d = 0x%llx %s\n", i, static_cast<unsigned long long>(c.x[i]),
+                     where(c.x[i]).c_str());
+    }
+    std::fflush(stderr);
+    std::abort();
+}
