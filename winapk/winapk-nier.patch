-int take_slot() {
-    std::lock_guard<std::mutex> hold(g_slots_lock);
-    for (size_t i = 0; i < kMonitorSlots; ++i) {
-        if (!g_slots_used[i]) {
-            g_slots_used[i] = true;
-            return static_cast<int>(i);
-        }
-    }
-    return -1;
-}
-
-void give_slot(int slot) {
-    std::lock_guard<std::mutex> hold(g_slots_lock);
-    g_slots_used[static_cast<size_t>(slot)] = false;
-}
