+// The ELF a stub copy stands for. Java hands out the stub's path for an app
+// library (ClassLoader.findLibrary, which Unity asks for libil2cpp's path and
+// then dlopens); the translator names the .so in <stub>.source. Empty for any
+// other path.
+std::string stub_source(const char* name) {
+    const std::string source = std::string(name) + ".source";
+    const std::filesystem::path path = std::filesystem::u8path(source);
+    FILE* f = _wfopen(path.c_str(), L"rb");
+    if (!f) return {};
+    std::string so;
+    char buf[1024];
+    for (size_t got; (got = std::fread(buf, 1, sizeof buf, f)) > 0;) so.append(buf, got);
+    std::fclose(f);
+    while (!so.empty() && (so.back() == '\n' || so.back() == '\r')) so.pop_back();
+    // The data folder moved (the whole port copied elsewhere): the .source
+    // still names the old place. The part from "\android\" on is the same
+    // under the data folder the stub is in now (<data>\apps\<app>\...).
+    std::error_code ec;
+    if (!so.empty() && !std::filesystem::exists(std::filesystem::u8path(so), ec)) {
+        const size_t at = so.find("\\android\\");
+        const std::string stub(name);
+        const size_t apps = stub.rfind("\\apps\\");
+        if (at != std::string::npos && apps != std::string::npos) {
+            const std::string moved = stub.substr(0, apps) + so.substr(at);
+            if (std::filesystem::exists(std::filesystem::u8path(moved), ec)) {
+                std::fprintf(stderr, "[win.apk] %s moved: loading it from %s\n", so.c_str(), moved.c_str());
+                return moved;
+            }
+        }
+    }
+    return so;
+}
