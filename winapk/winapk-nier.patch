+// SMAXP/UMAXP/SMINP/UMINP (integer pairwise max and min): what Unity's
+// reductions run, e.g. "umaxp v16.2s, v16.2s, v16.2s". The native build
+// works the same lanes out in C.
+static u64 pw_fold(const u8* r, int n) {
+    u64 h = 1469598103934665603ull;
+    for (int i = 0; i < n; ++i) h = (h ^ r[i]) * 1099511628211ull;
+    return h;
+}
+#if defined(__aarch64__)
+ISA_EXPORT u64 isa_vec_pairwise(u64 a, u64 b, u64 c) {
+    u64 in[4] = {a, b, c, a ^ (b << 1)};
+    u8 out[16 * 6] = {0};
+    __asm__ volatile(
+        "ldr q0, [%[in]]\n"
+        "ldr q1, [%[in], #16]\n"
+        "umaxp v2.2s, v0.2s, v1.2s\n"
+        "str d2, [%[out]]\n"
+        "smaxp v2.4h, v0.4h, v1.4h\n"
+        "str d2, [%[out], #8]\n"
+        "uminp v2.8b, v0.8b, v1.8b\n"
+        "str d2, [%[out], #16]\n"
+        "sminp v2.4s, v0.4s, v1.4s\n"
+        "str q2, [%[out], #32]\n"
+        "umaxp v2.16b, v0.16b, v1.16b\n"
+        "str q2, [%[out], #48]\n"
+        "sminp v2.8h, v0.8h, v1.8h\n"
+        "str q2, [%[out], #64]\n"
+        "umaxp v0.2s, v0.2s, v0.2s\n"  // the reduction idiom: a register paired with itself
+        "str d0, [%[out], #80]\n"
+        :
+        : [in] "r"(in), [out] "r"(out)
+        : "v0", "v1", "v2", "memory");
+    u8 res[88];
+    for (int i = 0; i < 88; ++i) res[i] = out[i];
+    return pw_fold(res, 88);
+}
+#else
+#define PW(T, NAME, OP)                                                                             \
+    static void NAME(const void* x, const void* y, void* d, int bytes) {                          \
+        const T* p = (const T*)x; const T* q = (const T*)y; T* o = (T*)d;                       \
+        const int n = bytes / (int)sizeof(T), half = n / 2;                                     \
+        for (int i = 0; i < half; ++i) o[i] = OP(p[2 * i], p[2 * i + 1]);                       \
+        for (int i = 0; i < half; ++i) o[half + i] = OP(q[2 * i], q[2 * i + 1]);                \
+    }
+#define PMAX(x, y) ((x) > (y) ? (x) : (y))
+#define PMIN(x, y) ((x) < (y) ? (x) : (y))
+PW(u32, pw_umax32, PMAX)
+PW(i16, pw_smax16, PMAX)
+PW(u8, pw_umin8, PMIN)
+PW(i32, pw_smin32, PMIN)
+PW(u8, pw_umax8, PMAX)
+PW(i16, pw_smin16, PMIN)
+ISA_EXPORT u64 isa_vec_pairwise(u64 a, u64 b, u64 c) {
+    u64 in[4] = {a, b, c, a ^ (b << 1)};
+    u8 out[16 * 6] = {0};
+    pw_umax32(&in[0], &in[2], out, 8);
+    pw_smax16(&in[0], &in[2], out + 8, 8);
+    pw_umin8(&in[0], &in[2], out + 16, 8);
+    pw_smin32(&in[0], &in[2], out + 32, 16);
+    pw_umax8(&in[0], &in[2], out + 48, 16);
+    pw_smin16(&in[0], &in[2], out + 64, 16);
+    pw_umax32(&in[0], &in[0], out + 80, 8);
+    u8 res[88];
+    for (int i = 0; i < 88; ++i) res[i] = out[i];
+    return pw_fold(res, 88);
+}
+#endif
