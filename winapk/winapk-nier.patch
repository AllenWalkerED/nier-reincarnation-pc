+// A Buffer argument of a GLES binding, for the length of one GL call. A
+// direct buffer is its address (gl3_buffer_ptr). A heap buffer
+// (IntBuffer.allocate, IntBuffer.wrap) has no address: AOSP's bindings pin its
+// backing array and release it after the call, which carries what GL wrote
+// back (glGen*, glGet*). Here they used to pass a null pointer, and the
+// driver wrote through it (AVPro Video's Java side starts every movie with
+// one: NieR Re[in]carnation crashed at its first cut scene).
+struct Gl3Buf {
+    JNIEnv* env;
+    jarray arr = nullptr;
+    void* base = nullptr;
+    void* ptr = nullptr;
+    Gl3Buf(JNIEnv* e, jobject buf) : env(e) {
+        if (!buf) return;
+        ptr = gl3_buffer_ptr(env, buf);
+        if (ptr) return;
+        jclass cls = env->GetObjectClass(buf);
+        jmethodID has = env->GetMethodID(cls, "hasArray", "()Z");
+        if (!has || !env->CallBooleanMethod(buf, has) || env->ExceptionCheck()) {
+            env->ExceptionClear();
+            env->DeleteLocalRef(cls);
+            return;
+        }
+        jmethodID array = env->GetMethodID(cls, "array", "()Ljava/lang/Object;");
+        jmethodID offset = env->GetMethodID(cls, "arrayOffset", "()I");
+        arr = array ? static_cast<jarray>(env->CallObjectMethod(buf, array)) : nullptr;
+        const jint off = offset ? env->CallIntMethod(buf, offset) : 0;
+        env->DeleteLocalRef(cls);
+        if (env->ExceptionCheck() || !arr) {
+            env->ExceptionClear();
+            arr = nullptr;
+            return;
+        }
+        EnsureBufferCache(env);
+        const jint pos = env->CallIntMethod(buf, gBufCache.mPosition);
+        const int es = InferElemSizeCached(env, buf);
+        base = env->GetPrimitiveArrayCritical(arr, nullptr);
+        if (base) ptr = static_cast<char*>(base) + static_cast<jlong>(off + pos) * es;
+    }
+    ~Gl3Buf() {
+        if (base) env->ReleasePrimitiveArrayCritical(arr, base, 0);
+        if (arr) env->DeleteLocalRef(arr);
+    }
+    Gl3Buf(const Gl3Buf&) = delete;
+    Gl3Buf& operator=(const Gl3Buf&) = delete;
+};
