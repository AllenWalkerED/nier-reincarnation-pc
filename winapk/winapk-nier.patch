+
+// The same in UTF-16: a Java string under the android root, as the guest
+// sees it (true), from the length and the start before the whole string.
+bool android_form16(JNIEnv* env, jstring str, std::u16string* out) {
+    static const std::string root = winapk::android_root_utf8();
+    if (!str || root.empty()) return false;
+    const jsize n = static_cast<jsize>(root.size());
+    const jsize len = env->GetStringLength(str);
+    if (len <= n || len > 32768) return false;
+    jchar head[1024];
+    if (n + 1 > 1024) return false;
+    env->GetStringRegion(str, 0, n + 1, head);
+    if (head[n] != '\\' && head[n] != '/') return false;
+    for (jsize i = 0; i < n; ++i) {
+        jchar a = head[i];
+        char b = root[static_cast<size_t>(i)];
+        if (a >= 0x80) return false;
+        if (a == '/') a = '\\';
+        if (b == '/') b = '\\';
+        if (std::tolower(static_cast<int>(a)) != std::tolower(static_cast<unsigned char>(b))) return false;
+    }
+    out->resize(static_cast<size_t>(len - n));
+    env->GetStringRegion(str, n, len - n, reinterpret_cast<jchar*>(&(*out)[0]));
+    for (char16_t& c : *out) {
+        if (c == u'\\') c = u'/';
+    }
+    return true;
+}
