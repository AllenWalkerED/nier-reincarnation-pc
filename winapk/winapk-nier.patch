+// WINAPK_FPS_CAP: each swap waits for its slot, 1/n s after the last one's.
+// A late frame starts the schedule again from now, never a burst to catch up.
+//
+// WINAPK_IDLE_FPS=<n>: n frames a second at most once the player has given no
+// input for WINAPK_IDLE_SECONDS (default 10): the room or a menu left open
+// draws less, the next key, click or stick movement brings the full rate back.
+long long env_fps(const char* name, long long lo, long long hi) {
+    const char* e = std::getenv(name);
+    const long long v = e ? std::atoll(e) : 0;
+    return v >= lo && v <= hi ? v : 0LL;
+}
+void fps_cap() {
+    static const long long full = env_fps("WINAPK_FPS_CAP", 10, 1000);
+    static const long long idle = env_fps("WINAPK_IDLE_FPS", 5, 240);
+    static const unsigned long long idle_after = [] {
+        const long long s = env_fps("WINAPK_IDLE_SECONDS", 2, 3600);
+        return static_cast<unsigned long long>(s ? s : 10) * 1000ull;
+    }();
+    long long cap = full;
+    if (idle) {
+        const unsigned long long last = last_input_ms(), now_ms = GetTickCount64();
+        const bool is_idle = now_ms - (last ? last : now_ms) >= idle_after;
+        static thread_local bool was_idle = false;
+        if (is_idle != was_idle) {
+            was_idle = is_idle;
+            std::fprintf(stderr, "[win.apk] idle frame limit: %s\n", is_idle ? "on" : "off (input)");
+        }
+        if (is_idle && (!cap || idle < cap)) cap = idle;
+    }
+    if (!cap) return;
+    static LARGE_INTEGER freq = [] {
+        LARGE_INTEGER f;
+        QueryPerformanceFrequency(&f);
+        return f;
+    }();
+    static thread_local HANDLE timer =
+        CreateWaitableTimerExW(nullptr, nullptr, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION, TIMER_ALL_ACCESS);
+    static thread_local long long next = 0, last_period = 0;
+    const long long period = freq.QuadPart / cap;
+    if (period != last_period) {  // the limit changed (idle): start from now
+        last_period = period;
+        next = 0;
+    }
+    LARGE_INTEGER now;
+    QueryPerformanceCounter(&now);
+    if (next == 0 || now.QuadPart > next + period) {
+        next = now.QuadPart + period;
+        return;
+    }
+    const long long wait = next - now.QuadPart;
+    if (wait > 0) {
+        const long long ticks100ns = wait * 10000000LL / freq.QuadPart;
+        if (timer && ticks100ns > 5000) {  // sleep to ~0.5 ms before, then spin the rest
+            LARGE_INTEGER due;
+            due.QuadPart = -(ticks100ns - 5000);
+            if (SetWaitableTimer(timer, &due, 0, nullptr, nullptr, FALSE)) WaitForSingleObject(timer, INFINITE);
+        }
+        do {
+            YieldProcessor();
+            QueryPerformanceCounter(&now);
+        } while (now.QuadPart < next);
+    }
+    next += period;
+}
