+struct JsonParser {
+    const char* p;
+    void ws() {
+        while (*p == ' ' || *p == '\n' || *p == '\r' || *p == '\t') ++p;
+    }
+    Json value() {
+        ws();
+        Json j;
+        if (*p == '{') {
+            j.kind = Json::kObj;
+            ++p;
+            for (;;) {
+                ws();
+                if (*p == '}') { ++p; break; }
