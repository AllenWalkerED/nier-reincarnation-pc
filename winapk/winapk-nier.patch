+// WINAPK_FRAME_DUMP=<file.bmp>: see the top of patch; writes the frame as
+// 32-bit BGRA, rows in the order gl_read_current gives them.
+void dump_frame(const uint32_t* argb, int w, int h) {
+    static const char* path = std::getenv("WINAPK_FRAME_DUMP");
+    if (!path || !argb || w <= 0 || h <= 0) return;
+    static std::atomic<uint64_t> frames{0};
+    static std::atomic<unsigned long long> last{0};
+    const uint64_t n = ++frames;
+    const unsigned long long now = GetTickCount64();
+    unsigned long long prev = last.load();
+    if (now - prev < 5000 || !last.compare_exchange_strong(prev, now)) return;
+    FILE* f = std::fopen(path, "wb");
+    if (!f) return;
+    const uint32_t size = static_cast<uint32_t>(w) * static_cast<uint32_t>(h) * 4;
+    const uint32_t file_header[3] = {54 + size, 0, 54};
+    const int32_t info[10] = {40, w, -h, (32 << 16) | 1, 0, static_cast<int32_t>(size), 0, 0, 0, 0};
+    std::fwrite("BM", 1, 2, f);
+    std::fwrite(file_header, 4, 3, f);
+    std::fwrite(info, 4, 10, f);
+    std::fwrite(argb, 1, size, f);
+    std::fclose(f);
+    std::fprintf(stderr, "[win.apk] frame %llu (%dx%d) written to %s\n", static_cast<unsigned long long>(n), w, h, path);
+}
