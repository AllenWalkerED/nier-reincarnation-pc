+                      h, fmt, samples);
+    } else {
+        std::snprintf(b, sizeof b, "type 0x%x", type);
+    }
+    if (fmt_out) *fmt_out = fmt;
+    return b;
+}
+
+// Reads x,y,w,h of the read framebuffer as float RGBA: as RGBA/FLOAT when the
+// implementation reads it as anything but bytes, else as RGBA8. Returns the
+// GL error and how it read.
+GLenum read_rgba(int x, int y, int w, int h, std::vector<float>* out, const char** how) {
+    GLint type = GL_UNSIGNED_BYTE;
+    glGetIntegerv(GL_IMPLEMENTATION_COLOR_READ_TYPE, &type);
+    const size_t n = static_cast<size_t>(w) * h * 4;
+    out->assign(n, 0.0f);
+    drain();
+    if (type != GL_UNSIGNED_BYTE) {
+        glReadPixels(x, y, w, h, GL_RGBA, GL_FLOAT, out->data());
+        if (glGetError() == GL_NO_ERROR) {
+            *how = "float";
+            return GL_NO_ERROR;
+        }
+    }
+    std::vector<unsigned char> bytes(n);
+    glReadPixels(x, y, w, h, GL_RGBA, GL_UNSIGNED_BYTE, bytes.data());
+    const GLenum err = glGetError();
+    if (err != GL_NO_ERROR) {
+        *how = "none";
+        return err;
+    }
+    for (size_t i = 0; i < n; ++i) (*out)[i] = bytes[i] / 255.0f;
+    *how = "rgba8";
+    return GL_NO_ERROR;
+}
+
+// The middle 32x32 of the read framebuffer: average and largest value per
+// channel, and how many pixels are not black.
+std::string middle(int w, int h) {
+    if (w <= 0 || h <= 0) {
+        GLint vp[4];
+        glGetIntegerv(GL_VIEWPORT, vp);
+        w = vp[2];
+        h = vp[3];
+    }
+    const int n = std::min(32, std::min(w, h)), x = w / 2 - n / 2, y = h / 2 - n / 2;
+    std::vector<float> px;
+    const char* how = "";
+    const GLenum err = read_rgba(x, y, n, n, &px, &how);
+    char b[256];
+    if (err != GL_NO_ERROR) {
+        std::snprintf(b, sizeof b, "read failed 0x%x", err);
+        return b;
+    }
+    double sum[4] = {}, mx[4] = {-1e30, -1e30, -1e30, -1e30}, mn[4] = {1e30, 1e30, 1e30, 1e30};
+    int lit = 0, bad = 0;
+    for (int i = 0; i < n * n; ++i) {
+        float c[4];
+        for (int k = 0; k < 4; ++k) {
+            c[k] = px[static_cast<size_t>(i) * 4 + k];
+            if (!std::isfinite(c[k])) {
+                ++bad;
+                c[k] = 0;
+            }
+            sum[k] += c[k];
+            if (c[k] > mx[k]) mx[k] = c[k];
+            if (c[k] < mn[k]) mn[k] = c[k];
+        }
+        if (c[0] + c[1] + c[2] > 0.02f) ++lit;
+    }
+    const int t = n * n;
+    std::snprintf(b, sizeof b,
+                  "middle avg %.3f %.3f %.3f a %.3f, min %.3f %.3f %.3f, max %.3f %.3f %.3f, lit %d/%d%s (read %s)",
+                  sum[0] / t, sum[1] / t, sum[2] / t, sum[3] / t, mn[0], mn[1], mn[2], mx[0], mx[1], mx[2], lit, t,
+                  bad ? " NaN/inf!" : "", how);
+    if (bad) std::snprintf(b + std::strlen(b), sizeof b - std::strlen(b), " bad %d", bad);
+    return b;
+}
+
+int size_of(GLenum which, bool want_w) {
+    GLint type = GL_NONE, name = 0, v = 0;
+    glGetFramebufferAttachmentParameteriv(GL_READ_FRAMEBUFFER, which, GL_FRAMEBUFFER_ATTACHMENT_OBJECT_TYPE, &type);
+    glGetFramebufferAttachmentParameteriv(GL_READ_FRAMEBUFFER, which, GL_FRAMEBUFFER_ATTACHMENT_OBJECT_NAME, &name);
+    if (type == GL_RENDERBUFFER) {
+        GLint prev = 0;
+        glGetIntegerv(GL_RENDERBUFFER_BINDING, &prev);
+        glBindRenderbuffer(GL_RENDERBUFFER, static_cast<GLuint>(name));
+        glGetRenderbufferParameteriv(GL_RENDERBUFFER, want_w ? GL_RENDERBUFFER_WIDTH : GL_RENDERBUFFER_HEIGHT, &v);
+        glBindRenderbuffer(GL_RENDERBUFFER, static_cast<GLuint>(prev));
+    } else if (type == GL_TEXTURE) {
+        GLint active = 0, prev = 0, level = 0;
+        glGetFramebufferAttachmentParameteriv(GL_READ_FRAMEBUFFER, which, GL_FRAMEBUFFER_ATTACHMENT_TEXTURE_LEVEL, &level);
+        glGetIntegerv(GL_ACTIVE_TEXTURE, &active);
+        glActiveTexture(GL_TEXTURE0);
+        glGetIntegerv(GL_TEXTURE_BINDING_2D, &prev);
+        glBindTexture(GL_TEXTURE_2D, static_cast<GLuint>(name));
+        glGetTexLevelParameteriv(GL_TEXTURE_2D, level, want_w ? GL_TEXTURE_WIDTH : GL_TEXTURE_HEIGHT, &v);
+        glBindTexture(GL_TEXTURE_2D, static_cast<GLuint>(prev));
+        glActiveTexture(static_cast<GLenum>(active));
+    }
+    drain();
+    return v;
+}
+
+std::mutex g_sources_lock;
+std::map<GLuint, std::vector<std::pair<GLint, std::string>>> g_sources;  // program -> (type, source)
+
+void dump_program(GLuint prog) {
+    if (!prog || !g_dumped_programs.insert(prog).second) return;
+    {
+        std::lock_guard<std::mutex> hold(g_sources_lock);
+        auto it = g_sources.find(prog);
+        if (it != g_sources.end()) {
+            for (const auto& [type, src] : it->second) {
+                const char* ext = type == GL_VERTEX_SHADER ? "vs" : type == GL_FRAGMENT_SHADER ? "fs" : "cs";
+                const std::string path = std::string(dump_dir()) + "\\prog" + std::to_string(prog) + "." + ext;
+                if (FILE* f = std::fopen(path.c_str(), "wb")) {
+                    std::fwrite(src.data(), 1, src.size(), f);
+                    std::fclose(f);
+                }
+            }
+            return;
+        }
+    }
+    GLuint shaders[4] = {};
+    GLsizei count = 0;
+    glGetAttachedShaders(prog, 4, &count, shaders);
+    for (GLsizei i = 0; i < count; ++i) {
+        GLint type = 0, len = 0;
+        glGetShaderiv(shaders[i], GL_SHADER_TYPE, &type);
+        glGetShaderiv(shaders[i], GL_SHADER_SOURCE_LENGTH, &len);
+        if (len <= 0) continue;
+        std::string src(static_cast<size_t>(len), '\0');
+        glGetShaderSource(shaders[i], len, nullptr, src.data());
+        src.resize(std::strlen(src.c_str()));
+        const char* ext = type == GL_VERTEX_SHADER ? "vs" : type == GL_FRAGMENT_SHADER ? "fs" : "cs";
+        const std::string path = std::string(dump_dir()) + "\\prog" + std::to_string(prog) + "." + ext;
+        if (FILE* f = std::fopen(path.c_str(), "wb")) {
+            std::fwrite(src.data(), 1, src.size(), f);
+            std::fclose(f);
+        }
+    }
+    drain();
+}
+
+// One captured draw: framebuffer, program, the textures bound on the units
+// its samplers use, and its plain (non-block) uniforms.
+void capture_draw(GLint fb, const char* what) {
+    if (!t_report) return;
+    GLint prog = 0, vp[4] = {};
+    glGetIntegerv(GL_CURRENT_PROGRAM, &prog);
+    glGetIntegerv(GL_VIEWPORT, vp);
+    GLboolean blend = glIsEnabled(GL_BLEND), depth = glIsEnabled(GL_DEPTH_TEST);
+    GLboolean mask[4] = {};
+    glGetBooleanv(GL_COLOR_WRITEMASK, mask);
+    std::fprintf(t_report, "draw %u fb %d %s prog %d viewport %d,%d %dx%d blend %d depth %d mask %d%d%d%d\n", t_seq++,
+                 fb, what, prog, vp[0], vp[1], vp[2], vp[3], blend, depth, mask[0], mask[1], mask[2], mask[3]);
+    if (!prog) return;
+    dump_program(static_cast<GLuint>(prog));
+    if (t_draws[fb] > 6) return;  // the full state only for the first draws per framebuffer
+    GLint uniforms = 0;
+    glGetProgramiv(static_cast<GLuint>(prog), GL_ACTIVE_UNIFORMS, &uniforms);
+    GLint active = 0;
+    glGetIntegerv(GL_ACTIVE_TEXTURE, &active);
+    for (GLint i = 0; i < uniforms && i < 64; ++i) {
+        char name[128] = "";
+        GLint size = 0;
+        GLenum type = 0;
+        glGetActiveUniform(static_cast<GLuint>(prog), static_cast<GLuint>(i), sizeof name, nullptr, &size, &type, name);
+        const GLint loc = glGetUniformLocation(static_cast<GLuint>(prog), name);
+        if (loc < 0) continue;  // in a uniform block
+        std::string line = std::string("    ") + name;
+        char b[96];
+        if (type == GL_SAMPLER_2D || type == GL_SAMPLER_3D || type == GL_SAMPLER_CUBE || type == GL_SAMPLER_2D_SHADOW ||
+            type == GL_SAMPLER_2D_ARRAY) {
+            GLint unit = 0, tex = 0;
+            glGetUniformiv(static_cast<GLuint>(prog), loc, &unit);
+            glActiveTexture(GL_TEXTURE0 + static_cast<GLenum>(unit));
+            const GLenum binding = type == GL_SAMPLER_3D     ? GL_TEXTURE_BINDING_3D
+                                   : type == GL_SAMPLER_CUBE ? GL_TEXTURE_BINDING_CUBE_MAP
+                                   : type == GL_SAMPLER_2D_ARRAY ? GL_TEXTURE_BINDING_2D_ARRAY
+                                                                 : GL_TEXTURE_BINDING_2D;
+            glGetIntegerv(binding, &tex);
+            std::snprintf(b, sizeof b, " sampler(0x%x) unit %d tex %d", type, unit, tex);
+            line += b;
+        } else if (type == GL_FLOAT || type == GL_FLOAT_VEC2 || type == GL_FLOAT_VEC3 || type == GL_FLOAT_VEC4 ||
+                   type == GL_FLOAT_MAT4) {
+            const int comps = type == GL_FLOAT ? 1 : type == GL_FLOAT_VEC2 ? 2 : type == GL_FLOAT_VEC3 ? 3 : type == GL_FLOAT_VEC4 ? 4 : 16;
+            const int elems = std::min<GLint>(size, 8);
+            for (int e = 0; e < elems; ++e) {
+                GLint l = loc;
+                if (e > 0) {
+                    std::string n = name;
+                    if (n.size() > 3 && n.compare(n.size() - 3, 3, "[0]") == 0) n.resize(n.size() - 3);
+                    l = glGetUniformLocation(static_cast<GLuint>(prog), (n + "[" + std::to_string(e) + "]").c_str());
+                    if (l < 0) break;
+                }
+                float v[16] = {};
+                glGetUniformfv(static_cast<GLuint>(prog), l, v);
+                line += " (";
+                for (int k = 0; k < comps; ++k) {
+                    std::snprintf(b, sizeof b, "%s%g", k ? " " : "", v[k]);
+                    line += b;
+                }
+                line += ")";
+            }
+        } else {
+            GLint v[4] = {};
+            glGetUniformiv(static_cast<GLuint>(prog), loc, v);
+            std::snprintf(b, sizeof b, " type 0x%x int %d %d %d %d", type, v[0], v[1], v[2], v[3]);
+            line += b;
+        }
+        std::fprintf(t_report, "%s\n", line.c_str());
+    }
+    glActiveTexture(static_cast<GLenum>(active));
+    drain();
+}
+
+void dump_framebuffer(GLint fb, int w, int h, GLint fmt) {
+    if (w <= 0 || h <= 0) return;
+    std::vector<float> px;
+    const char* how = "";
+    if (read_rgba(0, 0, w, h, &px, &how) != GL_NO_ERROR) return;
+    char path[MAX_PATH];
+    std::snprintf(path, sizeof path, "%s\\fb%d_%dx%d_%x.f32", dump_dir(), fb, w, h, fmt);
+    if (FILE* f = std::fopen(path, "wb")) {
+        std::fwrite(px.data(), sizeof(float), px.size(), f);
+        std::fclose(f);
+    }
+}
