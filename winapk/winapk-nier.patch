+// True when on: the caller sets g_vk_compat once the Vulkan display is up.
+bool apply_vk_compat() {
+    const char* mode = std::getenv("WINAPK_VK_COMPAT");
+    const std::string m = mode ? mode : "auto";
+    if (m == "off") return false;
+    char gpu[256] = "every GPU";
+    if (m != "on" && !has_blackwell(gpu, sizeof gpu)) return false;
+    std::string off = kVkCompatFeatures, parts;
+    for (const auto& [part, list] : {std::pair{"DYNSTATE", kVkCompatDynState}, std::pair{"CLIP", kVkCompatClip},
+                                     std::pair{"CLAMP", kVkCompatClamp},
+                                     std::pair{"STOREOP", kVkCompatStoreOp}}) {
+        if (!vk_compat_part(part)) continue;
+        off = off + ":" + list;
+        parts = parts + " " + part;
+    }
+    add_angle_features("ANGLE_FEATURE_OVERRIDES_DISABLED", off.c_str());
+    if (vk_compat_part("DRAWCLEAR")) {
+        add_angle_features("ANGLE_FEATURE_OVERRIDES_ENABLED", kVkCompatDrawClear);
+        parts += " DRAWCLEAR";
+    }
+    for (const char* part : {"DEPTH32F", "INVALIDATE", "HIDECLIP"}) {
+        if (vk_compat_part(part)) parts = parts + " " + part;
+    }
+    std::fprintf(stderr, "[win.apk] GL: Vulkan compatibility on (%s): newer driver features off; depth path:%s\n", gpu,
+                 parts.empty() ? " (none)" : parts.c_str());
+    return true;
+}
