+        if (AotFn fn = aot_lookup(ts.cpu.pc)) {
+            ++ts.stats.aot_entries;
+            // Done is a return; only one to stop_pc ends the call. A guest
+            // function that returns somewhere else (an exception's landing
+            // pad, a longjmp) goes on from there.
+            const bool outer = ts.innermost_jit;
+            ts.innermost_jit = false;
+            const uint32_t st = aot_run(fn, &ts.cpu);
+            ts.innermost_jit = outer;
+            if (st == kAotDone && ts.cpu.pc == ts.cpu.stop_pc) return;
+            ++ts.stats.aot_bails;  // on from ts.cpu.pc
+            aot_place_stats(2, ts.cpu.pc);
+        }
+    }
+    if (engine != Engine::kInterpreter && jit_built()) {
+        if (ts.jits_running == ts.jits.size() && !ts.jit_failed) {
+            std::unique_ptr<JitEngine> jit = make_jit_engine(ts.cpu, ts.jits.empty());
