+        g_map.mx = static_cast<float>(mv->number("x", g_map.mx));
+        g_map.my = static_cast<float>(mv->number("y", g_map.my));
+        g_map.radius = static_cast<float>(mv->number("radius", g_map.radius));
+        if (const Json* keys = mv->at("keys")) {
+            g_map.up = static_cast<int>(keys->number("up", g_map.up));
+            g_map.left = static_cast<int>(keys->number("left", g_map.left));
+            g_map.down = static_cast<int>(keys->number("down", g_map.down));
+            g_map.right = static_cast<int>(keys->number("right", g_map.right));
+        }
+    }
