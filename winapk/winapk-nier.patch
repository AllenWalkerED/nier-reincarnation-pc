+// ---- CPU by thread ----------------------------------------------------------
+
+using GetDescFn = HRESULT(WINAPI*)(HANDLE, PWSTR*);
+
+std::string thread_name(HANDLE h, DWORD tid) {
+    static const GetDescFn get = reinterpret_cast<GetDescFn>(
+        reinterpret_cast<void*>(GetProcAddress(GetModuleHandleW(L"kernel32.dll"), "GetThreadDescription")));
+    std::string name;
+    PWSTR w = nullptr;
+    if (get && SUCCEEDED(get(h, &w)) && w) {
+        char buf[128];
+        const int n = WideCharToMultiByte(CP_UTF8, 0, w, -1, buf, sizeof buf, nullptr, nullptr);
+        if (n > 1) name.assign(buf, static_cast<size_t>(n - 1));
+        LocalFree(w);
+    }
+    if (name.empty()) name = "tid" + std::to_string(tid);
+    return name;
+}
+
+uint64_t ft64(const FILETIME& f) { return (static_cast<uint64_t>(f.dwHighDateTime) << 32) | f.dwLowDateTime; }
+
+struct ThreadCpu {
+    std::string name;
+    double pct;  // of one core
+};
+
+// The busiest threads since the last call, and the process's CPU (of all cores).
+std::vector<ThreadCpu> sample_threads(double dt_s, double* proc_pct) {
+    static const bool threads_on = [] {  // WINAPK_PERF_THREADS=0: the process's CPU only
+        const char* e = std::getenv("WINAPK_PERF_THREADS");
+        return !(e && e[0] == '0');
+    }();
+    static std::map<DWORD, uint64_t> last;  // tid -> 100 ns of CPU
+    static uint64_t last_proc = 0;
+    std::map<DWORD, uint64_t> now;
+    std::vector<ThreadCpu> busy;
+    const DWORD pid = GetCurrentProcessId();
+    HANDLE snap = threads_on ? CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0) : INVALID_HANDLE_VALUE;
+    if (snap != INVALID_HANDLE_VALUE) {
+        THREADENTRY32 te;
+        te.dwSize = sizeof te;
+        for (BOOL ok = Thread32First(snap, &te); ok; ok = Thread32Next(snap, &te)) {
+            if (te.th32OwnerProcessID != pid) continue;
+            HANDLE h = OpenThread(THREAD_QUERY_LIMITED_INFORMATION, FALSE, te.th32ThreadID);
+            if (!h) continue;
+            FILETIME c, e, k, u;
+            if (GetThreadTimes(h, &c, &e, &k, &u)) {
+                const uint64_t t = ft64(k) + ft64(u);
+                now[te.th32ThreadID] = t;
+                auto it = last.find(te.th32ThreadID);
+                const uint64_t d = it == last.end() ? 0 : t - it->second;
+                const double pct = static_cast<double>(d) / 1e7 / dt_s * 100.0;
+                if (pct >= 3.0) busy.push_back({thread_name(h, te.th32ThreadID), pct});
+            }
+            CloseHandle(h);
+        }
+        CloseHandle(snap);
+    }
+    last.swap(now);
+    FILETIME c, e, k, u;
+    GetProcessTimes(GetCurrentProcess(), &c, &e, &k, &u);
+    const uint64_t p = ft64(k) + ft64(u);
+    static const unsigned cores = std::max(1u, std::thread::hardware_concurrency());
+    *proc_pct = last_proc ? static_cast<double>(p - last_proc) / 1e7 / dt_s * 100.0 / cores : 0;
+    last_proc = p;
+    std::sort(busy.begin(), busy.end(), [](const ThreadCpu& a, const ThreadCpu& b) { return a.pct > b.pct; });
+    return busy;
+}
+
+// ---- GPU (Windows' "GPU Engine" counters for this process) -------------------
+
+struct Gpu {
+    PDH_HQUERY query = nullptr;
+    PDH_HCOUNTER counter = nullptr;
+    bool ok = false;
+    Gpu() {
+        // WINAPK_PERF_GPU=0: no Windows performance counters in this process.
+        const char* e = std::getenv("WINAPK_PERF_GPU");
+        if (e && e[0] == '0') return;
+        if (PdhOpenQueryW(nullptr, 0, &query) != ERROR_SUCCESS) return;
+        if (PdhAddEnglishCounterW(query, L"\\GPU Engine(*)\\Utilization Percentage", 0, &counter) != ERROR_SUCCESS)
+            return;
+        ok = PdhCollectQueryData(query) == ERROR_SUCCESS;
+    }
+    // This process's busiest 3D engine, and its busiest engine of any kind, in %.
+    bool sample(double* d3, double* any) {
+        *d3 = *any = 0;
+        if (!ok || PdhCollectQueryData(query) != ERROR_SUCCESS) return false;
+        DWORD bytes = 0, items = 0;
+        if (PdhGetFormattedCounterArrayW(counter, PDH_FMT_DOUBLE, &bytes, &items, nullptr) != PDH_MORE_DATA) return false;
+        std::vector<unsigned char> buf(bytes);
+        auto* arr = reinterpret_cast<PDH_FMT_COUNTERVALUE_ITEM_W*>(buf.data());
+        if (PdhGetFormattedCounterArrayW(counter, PDH_FMT_DOUBLE, &bytes, &items, arr) != ERROR_SUCCESS) return false;
+        wchar_t tag[32];
+        std::swprintf(tag, 32, L"pid_%lu_", GetCurrentProcessId());
+        // Engines are per adapter and per engine index: sum per instance name
+        // without the pid part would mix them, so take the busiest.
+        for (DWORD i = 0; i < items; ++i) {
+            const wchar_t* n = arr[i].szName;
+            if (!n || !std::wcsstr(n, tag) || arr[i].FmtValue.CStatus != ERROR_SUCCESS) continue;
+            const double v = arr[i].FmtValue.doubleValue;
+            *any = std::max(*any, v);
+            if (std::wcsstr(n, L"engtype_3D")) *d3 = std::max(*d3, v);
+        }
+        return true;
+    }
+};
+
+// ---- frame times -------------------------------------------------------------
+
+struct FrameStats {
+    double avg = 0, p50 = 0, p95 = 0, p99 = 0, max = 0, low1 = 0;
+    size_t n = 0, over33 = 0, over50 = 0;
+};
+
+FrameStats stats(std::vector<float> v) {
+    FrameStats s;
+    s.n = v.size();
+    if (v.empty()) return s;
+    double sum = 0;
+    for (float f : v) {
+        sum += f;
+        if (f > 33.4f) ++s.over33;
+        if (f > 50.0f) ++s.over50;
+    }
+    s.avg = sum / static_cast<double>(v.size());
+    std::sort(v.begin(), v.end());
+    auto pct = [&](double p) { return v[std::min(v.size() - 1, static_cast<size_t>(p * static_cast<double>(v.size())))]; };
+    s.p50 = pct(0.50);
+    s.p95 = pct(0.95);
+    s.p99 = pct(0.99);
+    s.max = v.back();
+    // 1% low: the frame rate of the slowest 1% of frames.
+    const size_t k = std::max<size_t>(1, v.size() / 100);
+    double slow = 0;
+    for (size_t i = v.size() - k; i < v.size(); ++i) slow += v[i];
+    s.low1 = 1000.0 / (slow / static_cast<double>(k));
+    return s;
+}
+
+std::string top_threads(const std::vector<ThreadCpu>& t, size_t n) {
+    std::string s;
+    char b[160];
+    for (size_t i = 0; i < t.size() && i < n; ++i) {
+        std::snprintf(b, sizeof b, "%s%s %.0f%%", i ? ", " : "", t[i].name.c_str(), t[i].pct);
+        s += b;
+    }
+    return s;
+}
+
+
+// ---- F7: where the game's threads spend their time (a sampling profiler) ----
+//
+// 100 times a second for 5 s, each thread of interest is suspended just long
+// enough to copy its instruction pointer and the top of its stack (nothing is
+// allocated meanwhile: it may hold the heap's lock); the addresses are named
+// afterwards. Per thread, the most frequent "where" (the instruction and the
+// first return addresses found on the stack) is logged: a waiting thread shows
+// what it waits in, a busy one what it runs.
+struct Region {
+    uint64_t base = 0, end = 0;
+    std::string name;  // empty: not code
+};
+
+const Region& region_of(uint64_t a, std::vector<Region>& cache) {
+    static const Region none;
+    for (const Region& r : cache) {
+        if (a >= r.base && a < r.end) return r;
+    }
+    MEMORY_BASIC_INFORMATION mbi{};
+    if (!a || !VirtualQuery(reinterpret_cast<const void*>(a), &mbi, sizeof mbi) || mbi.State != MEM_COMMIT) return none;
+    const DWORD exec = PAGE_EXECUTE | PAGE_EXECUTE_READ | PAGE_EXECUTE_READWRITE | PAGE_EXECUTE_WRITECOPY;
+    Region r;
+    r.base = reinterpret_cast<uint64_t>(mbi.BaseAddress);
+    r.end = r.base + mbi.RegionSize;
+    if (mbi.Protect & exec) {
+        const auto alloc = reinterpret_cast<uint64_t>(mbi.AllocationBase);
+        if (mbi.Type == MEM_IMAGE) {
+            wchar_t path[MAX_PATH];
+            const DWORD len = K32GetMappedFileNameW(GetCurrentProcess(), mbi.AllocationBase, path, MAX_PATH);
+            const wchar_t* nm = path;
+            for (DWORD i = 0; i < len; ++i)
+                if (path[i] == L'\\') nm = path + i + 1;
+            for (; nm < path + len; ++nm) r.name += *nm < 128 ? static_cast<char>(*nm) : '?';
+            r.base = alloc;  // offsets from the image's base
+        } else {
+            char b[48];
+            std::snprintf(b, sizeof b, "code@%llx", static_cast<unsigned long long>(alloc));
+            r.name = b;
+            r.base = alloc;
+        }
+        // The whole allocation, so later lookups hit the cache.
+        MEMORY_BASIC_INFORMATION m2{};
+        uint64_t q = alloc;
+        while (VirtualQuery(reinterpret_cast<const void*>(q), &m2, sizeof m2) &&
+               reinterpret_cast<uint64_t>(m2.AllocationBase) == alloc && m2.RegionSize)
+            q += m2.RegionSize;
+        r.end = q;
+    }
+    cache.push_back(r);
+    return cache.back();
+}
+
+std::string where(uint64_t a, std::vector<Region>& cache) {
+    const Region& r = region_of(a, cache);
+    if (r.name.empty()) return "";
+    char b[160];
+    std::snprintf(b, sizeof b, "%s+0x%llx", r.name.c_str(), static_cast<unsigned long long>(a - r.base));
+    return b;
+}
+
+
+// The kernel's view of a thread (NtQuerySystemInformation, class 5): its state
+// and, when waiting, why -- without touching the thread.
+struct SysThread {
+    LARGE_INTEGER kernel, user, create;
+    ULONG wait_time;
+    PVOID start;
+    struct {
+        HANDLE process, thread;
+    } cid;
+    LONG priority, base_priority;
+    ULONG switches, state, wait_reason;
+};
+struct SysProcess {
+    ULONG next, threads;
+    BYTE reserved1[48];
+    UNICODE_STRING name;
+    LONG base_priority;
+    HANDLE pid, parent;
+    ULONG handles, session;
+    ULONG_PTR reserved2;
+    SIZE_T peak_virtual, virtual_size;
+    ULONG faults;
+    SIZE_T peak_ws, ws, quota[4], pagefile, peak_pagefile, private_bytes;
+    LARGE_INTEGER io[6];
+    SysThread thread[1];
+};
+using NtQsiFn = LONG(NTAPI*)(ULONG, PVOID, ULONG, PULONG);
+
+// "Running", "Ready", or "Wait:<reason>" for each thread id asked.
+void thread_states(const std::vector<DWORD>& tids, std::vector<std::string>* out_states) {
+    static const NtQsiFn qsi = reinterpret_cast<NtQsiFn>(
+        reinterpret_cast<void*>(GetProcAddress(GetModuleHandleW(L"ntdll.dll"), "NtQuerySystemInformation")));
+    static std::vector<unsigned char> buf(1 << 20);
+    out_states->assign(tids.size(), "?");
+    if (!qsi) return;
+    ULONG need = 0;
+    LONG st;
+    while ((st = qsi(5, buf.data(), static_cast<ULONG>(buf.size()), &need)) == static_cast<LONG>(0xC0000004L))
+        buf.resize(buf.size() * 2);
+    if (st < 0) return;
+    static const char* kReasons[] = {"Executive", "FreePage", "PageIn", "PoolAlloc", "Delay", "SUSPENDED", "UserRequest",
+                                     "WrExecutive", "WrFreePage", "WrPageIn", "WrPoolAlloc", "WrDelay", "WrSuspended",
+                                     "WrUserRequest", "WrEventPair", "WrQueue", "WrLpcReceive", "WrLpcReply",
+                                     "WrVirtualMemory", "WrPageOut", "WrRendezvous", "WrKeyedEvent", "WrTerminated",
+                                     "WrProcessInSwap", "WrCpuRateControl", "WrCalloutStack", "WrKernel", "WrResource",
+                                     "WrPushLock", "WrMutex", "WrQuantumEnd", "WrDispatchInt", "WrPreempted",
+                                     "WrYieldExecution", "WrFastMutex", "WrGuardedMutex", "WrRundown", "WrAlertByThreadId",
+                                     "WrDeferredPreempt"};
+    const auto pid = static_cast<uintptr_t>(GetCurrentProcessId());
+    for (size_t off = 0;;) {
+        const auto* pr = reinterpret_cast<const SysProcess*>(buf.data() + off);
+        if (reinterpret_cast<uintptr_t>(pr->pid) == pid) {
+            for (ULONG i = 0; i < pr->threads; ++i) {
+                const SysThread& t = pr->thread[i];
+                const auto tid = static_cast<DWORD>(reinterpret_cast<uintptr_t>(t.cid.thread));
+                for (size_t k = 0; k < tids.size(); ++k) {
+                    if (tids[k] != tid) continue;
+                    if (t.state == 2) (*out_states)[k] = "Running";
+                    else if (t.state == 1 || t.state == 3 || t.state == 7) (*out_states)[k] = "Ready";
+                    else if (t.state == 5)
+                        (*out_states)[k] = std::string("Wait:") +
+                            (t.wait_reason < sizeof kReasons / sizeof *kReasons ? kReasons[t.wait_reason] : "other");
+                    else (*out_states)[k] = "state" + std::to_string(t.state);
+                }
+            }
+            return;
+        }
+        if (!pr->next) return;
+        off += pr->next;
+    }
+}
+
+bool interesting(const std::string& n) {
+    return n == "UnityMain" || n == "UnityGfxDeviceW" || n.rfind("0xdd", 0) == 0 || n == "winapk-render" ||
+           n == "main" || n == "UnityChoreograp" || n.find("Choreographer") != std::string::npos;
+}
+
+DWORD WINAPI sampler(void*) {
+    struct Target {
+        DWORD tid;
+        HANDLE h;
+        std::string name;
+    };
+    std::vector<Target> targets;
+    HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+    if (snap != INVALID_HANDLE_VALUE) {
+        THREADENTRY32 te;
+        te.dwSize = sizeof te;
+        for (BOOL ok = Thread32First(snap, &te); ok; ok = Thread32Next(snap, &te)) {
+            if (te.th32OwnerProcessID != GetCurrentProcessId() || te.th32ThreadID == GetCurrentThreadId()) continue;
+            HANDLE h = OpenThread(THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_LIMITED_INFORMATION, FALSE,
+                                  te.th32ThreadID);
+            if (!h) continue;
+            const std::string n = thread_name(h, te.th32ThreadID);
+            ULONG64 c0 = 0;
+            QueryThreadCycleTime(h, &c0);
+            if (interesting(n) || n == "Job.Worker 0" || c0 > 50000000000ull)
+                targets.push_back({te.th32ThreadID, h, n});
+            else CloseHandle(h);
+        }
+        CloseHandle(snap);
+    }
+    out("sampling %zu threads for 10 s (F7)", targets.size());
+    constexpr int kSamples = 1000, kDepth = 384;
+    struct Sample {
+        uint64_t rip;
+        uint64_t stack[kDepth];
+        size_t n;
+        bool ran;
+    };
+    std::vector<DWORD> tids;
+    for (const Target& t : targets) tids.push_back(t.tid);
+    std::vector<std::map<std::string, int>> states(targets.size());
+    std::vector<std::string> now_states;
+    std::vector<std::vector<Sample>> samples(targets.size(), std::vector<Sample>(kSamples));
+    std::vector<int> taken(targets.size(), 0);
+    for (int i = 0; i < kSamples; ++i) {
+        thread_states(tids, &now_states);
+        for (size_t t = 0; t < targets.size(); ++t) {
+            ++states[t][now_states[t]];
+            samples[t][static_cast<size_t>(taken[t])].ran = now_states[t] == "Running";
+            Sample& sm = samples[t][static_cast<size_t>(taken[t])];
+            sm.n = 0;
+            sm.rip = 0;
+
+            if (SuspendThread(targets[t].h) == static_cast<DWORD>(-1)) continue;
+            CONTEXT c{};
+            c.ContextFlags = CONTEXT_CONTROL;
+            if (GetThreadContext(targets[t].h, &c)) {
+                sm.rip = c.Rip;
+                MEMORY_BASIC_INFORMATION mbi{};
+                if (VirtualQuery(reinterpret_cast<const void*>(c.Rsp), &mbi, sizeof mbi) && mbi.State == MEM_COMMIT) {
+                    const auto* top = reinterpret_cast<const uint64_t*>(c.Rsp);
+                    const auto* end =
+                        reinterpret_cast<const uint64_t*>(static_cast<const char*>(mbi.BaseAddress) + mbi.RegionSize);
+                    sm.n = std::min<size_t>(static_cast<size_t>(end - top), kDepth);
+                    std::memcpy(sm.stack, top, sm.n * sizeof(uint64_t));
+                }
+            }
+            ResumeThread(targets[t].h);
+            if (sm.rip) ++taken[t];
+        }
+        Sleep(10);
+    }
+    std::vector<Region> cache;
+    for (size_t t = 0; t < targets.size(); ++t) {
+        std::map<std::string, int> leaf, sig;
+        int ran = 0;
+        for (int i = 0; i < taken[t]; ++i) {
+            const Sample& sm = samples[t][static_cast<size_t>(i)];
+            ran += sm.ran;
+            const std::string l = (sm.ran ? "RUN " : "idle ") + where(sm.rip, cache);
+            ++leaf[l];
+            std::string chain = l;
+            int found = 0;
+            for (size_t k = 0; k < sm.n && found < 5; ++k) {
+                const std::string w = where(sm.stack[k], cache);
+                if (w.empty()) continue;
+                chain += " < " + w;
+                ++found;
+            }
+            ++sig[chain];
+        }
+        auto top = [&](const std::map<std::string, int>& m, size_t n, const char* label) {
+            std::vector<std::pair<std::string, int>> v(m.begin(), m.end());
+            std::sort(v.begin(), v.end(), [](const auto& a, const auto& b) { return a.second > b.second; });
+            for (size_t i = 0; i < v.size() && i < n; ++i)
+                out("sample %s %s %d%%: %s", targets[t].name.c_str(), label, v[i].second * 100 / std::max(1, taken[t]),
+                    v[i].first.c_str());
+        };
+        std::string st;
+        {
+            std::vector<std::pair<std::string, int>> v(states[t].begin(), states[t].end());
+            std::sort(v.begin(), v.end(), [](const auto& a, const auto& b) { return a.second > b.second; });
+            for (const auto& [k, c] : v) st += " " + k + " " + std::to_string(c * 100 / kSamples) + "%";
+        }
+        out("sample %s (tid %lu): %d samples | state:%s", targets[t].name.c_str(), targets[t].tid, taken[t], st.c_str());
+        (void)ran;
+        // Where the running samples are, by module (AOT code, JIT code "code@", the runtime, the system).
+        std::map<std::string, int> modules;
+        int running = 0;
+        for (int i = 0; i < taken[t]; ++i) {
+            const Sample& sm = samples[t][static_cast<size_t>(i)];
+            if (!sm.ran) continue;
+            ++running;
+            const Region& r = region_of(sm.rip, cache);
+            std::string m = r.name.empty() ? "?" : r.name;
+            if (m.rfind("code@", 0) == 0) m = "code@ (JIT)";
+            ++modules[m];
+        }
+        if (running) {
+            std::vector<std::pair<std::string, int>> v(modules.begin(), modules.end());
+            std::sort(v.begin(), v.end(), [](const auto& a, const auto& b) { return a.second > b.second; });
+            std::string line;
+            for (size_t i = 0; i < v.size() && i < 10; ++i)
+                line += " " + v[i].first + " " + std::to_string(v[i].second * 100 / running) + "%";
+            out("sample %s running by module (%d samples):%s", targets[t].name.c_str(), running, line.c_str());
+        }
+        // Every running sample's place, for symbolizing afterwards (WINAPK_PERF_FILE + ".samples";
+        // without it, logs\perf.samples in the working folder when there is one: the launcher's).
+        const char* pf = std::getenv("WINAPK_PERF_FILE");
+        const std::string samples_path = pf ? std::string(pf) + ".samples"
+                                            : (GetFileAttributesA("logs") != INVALID_FILE_ATTRIBUTES ? "logs\\perf.samples" : "");
+        if (!samples_path.empty()) {
+            if (FILE* f = std::fopen(samples_path.c_str(), "a")) {
+                for (int i = 0; i < taken[t]; ++i) {
+                    const Sample& sm = samples[t][static_cast<size_t>(i)];
+                    if (!sm.ran) continue;
+                    std::string chain = where(sm.rip, cache);
+                    int found = 0;
+                    for (size_t k = 0; k < sm.n && found < 8; ++k) {
+                        const std::string w = where(sm.stack[k], cache);
+                        if (w.empty()) continue;
+                        chain += " " + w;
+                        ++found;
+                    }
+                    std::fprintf(f, "%s\t%s\n", targets[t].name.c_str(), chain.c_str());
+                }
+                std::fclose(f);
+            }
+        }
+        top(leaf, 6, "leaf");
+        top(sig, 6, "stack");
+        CloseHandle(targets[t].h);
+    }
+    out("sampling done");
+    return 0;
+}
+
+void end_capture_locked(const char* why) {
+    if (!g_capturing) return;
+    g_capturing = false;
+    const FrameStats f = stats(g_capture);
+    const double secs = ms(ticks() - g_capture_t0) / 1000.0;
+    const double r = std::max(1.0, g_sums.reports);
+    const double fr = std::max(1.0, g_sums.frames);
+    std::vector<ThreadCpu> th;
+    for (const auto& [name, sum] : g_sums.threads) th.push_back({name, sum / r});
+    std::sort(th.begin(), th.end(), [](const ThreadCpu& a, const ThreadCpu& b) { return a.pct > b.pct; });
+    out("capture #%d (%s) %.1fs %s | %dx%d drawn, window %dx%d | %s | fps %.1f, frame ms avg %.2f p50 %.2f p95 %.2f "
+        "p99 %.2f max %.1f, 1%% low %.1f fps, >33ms %zu, >50ms %zu of %zu | cpu %.0f%% gpu3D %.0f%% | per frame: swap "
+        "%.2f ms, GL lock wait %.2f ms | shaders %llu compiled + %llu linked (%.0f ms) | astc %llu (%.0f ms) | threads: %s",
+        g_capture_n, why, secs, g_renderer.c_str(), g_app_w, g_app_h, g_win_w, g_win_h,
+        std::getenv("WINAPK_ANGLE_BACKEND") ? std::getenv("WINAPK_ANGLE_BACKEND") : "vulkan",
+        f.avg > 0 ? 1000.0 / f.avg : 0.0, f.avg, f.p50, f.p95, f.p99, f.max, f.low1, f.over33, f.over50, f.n,
+        g_sums.cpu / r, g_sums.gpu / r, g_sums.swap_ms / fr, g_sums.lock_ms / fr,
+        static_cast<unsigned long long>(g_sums.compiles), static_cast<unsigned long long>(g_sums.links),
+        g_sums.compile_ms, static_cast<unsigned long long>(g_sums.astc), g_sums.astc_ms, top_threads(th, 8).c_str());
+    if (!g_sums.lock_threads.empty()) {
+        auto top = [&](const std::map<std::string, double>& m, size_t n, bool waits) {
+            std::vector<std::pair<std::string, double>> v(m.begin(), m.end());
+            std::sort(v.begin(), v.end(), [](const auto& a, const auto& b) { return a.second > b.second; });
+            std::string s;
+            char b[200];
+            for (size_t i = 0; i < v.size() && i < n; ++i) {
+                std::snprintf(b, sizeof b, "%s%s %.1f", i ? ", " : "", v[i].first.c_str(), v[i].second / fr);
+                s += b;
+            }
+            (void)waits;
+            return s;
+        };
+        out("capture #%d GL lock, ms per frame | held by thread: %s | waited by thread: %s | held by function: %s",
+            g_capture_n, top(g_sums.lock_threads, 6, false).c_str(), top(g_sums.lock_thread_wait, 6, true).c_str(),
+            top(g_sums.lock_fns, 12, false).c_str());
+    }
+}
+
+void start_capture_locked() {
+    g_capturing = true;
+    g_capture.clear();
+    g_capture_t0 = ticks();
+    g_sums = CaptureSums{};
+    out("capture #%d started", ++g_capture_n);
+}
+
+void reporter() {
+    Gpu gpu;
+    uint64_t prev_time[kCounterCount] = {}, prev_count[kCounterCount] = {};
+    uint64_t prev_lock = 0, prev_waits = 0;
+    uint64_t t_prev = ticks();
+    double dummy;
+    sample_threads(1.0, &dummy);
+    static const double capture_len = [] {
+        const char* e = std::getenv("WINAPK_PERF_CAPTURE");
+        const double v = e ? std::atof(e) : 30.0;
+        return v > 0 ? v : 30.0;
+    }();
+    static const double capture_at = [] {
+        const char* e = std::getenv("WINAPK_PERF_CAPTURE_AT");
+        return e ? std::atof(e) : -1.0;
+    }();
+    bool auto_started = false;
+    for (;;) {
+        Sleep(1000);
+        const uint64_t t = ticks();
+        const double dt = ms(t - t_prev) / 1000.0;
+        t_prev = t;
+        uint64_t dtime[kCounterCount], dcount[kCounterCount];
+        for (int i = 0; i < kCounterCount; ++i) {
+            const uint64_t a = g_time[i].load(), b = g_count[i].load();
+            dtime[i] = a - prev_time[i];
+            dcount[i] = b - prev_count[i];
+            prev_time[i] = a;
+            prev_count[i] = b;
+        }
+        const uint64_t lk = g_gl_lock_wait_ticks.load(), wt = g_gl_lock_waits.load();
+        const uint64_t dlock = lk - prev_lock, dwaits = wt - prev_waits;
+        prev_lock = lk;
+        prev_waits = wt;
+        double proc = 0, g3d = 0, gany = 0;
+        const auto threads = sample_threads(dt, &proc);
+        const bool have_gpu = gpu.sample(&g3d, &gany);
+        std::vector<GlLockUse> lock_threads, lock_fns;
+        if (g_gl_serialize) gl_lock_take_stats(&lock_threads, &lock_fns);
+
+        std::lock_guard<std::mutex> hold(g_lock);
+        std::vector<float> frames;
+        frames.swap(g_frames);
+        const FrameStats f = stats(frames);
+        const double nf = std::max<double>(1, static_cast<double>(f.n));
+        char gpus[64];
+        if (have_gpu) std::snprintf(gpus, sizeof gpus, "gpu 3D %.0f%% (any engine %.0f%%)", g3d, gany);
+        else std::snprintf(gpus, sizeof gpus, "gpu n/a");
+        out("fps %.1f | frame ms avg %.2f p95 %.2f max %.1f >33ms %zu | per frame: swap %.2f cap %.2f lock %.2f ms (%llu "
+            "waits) video %.2f | shaders %llu+%llu (%.0f ms) progbin %llu | astc %llu (%.0f ms, uploads %.0f ms) | cpu "
+            "%.0f%% | %s | %s",
+            static_cast<double>(f.n) / dt, f.avg, f.p95, f.max, f.over33, ms(dtime[kSwap]) / nf, ms(dtime[kCapWait]) / nf,
+            ms(dlock) / nf, static_cast<unsigned long long>(dwaits), ms(dtime[kVideoPump]) / nf,
+            static_cast<unsigned long long>(dcount[kShaderCompile]), static_cast<unsigned long long>(dcount[kShaderLink]),
+            ms(dtime[kShaderCompile] + dtime[kShaderLink] + dtime[kProgramBinary]),
+            static_cast<unsigned long long>(dcount[kProgramBinary]), static_cast<unsigned long long>(dcount[kAstc]),
+            ms(dtime[kAstc]), ms(dtime[kTexUpload]), proc, gpus, top_threads(threads, 6).c_str());
+
+        if (!lock_threads.empty()) {
+            std::string a, b;
+            char buf[200];
+            for (size_t i = 0; i < lock_threads.size() && i < 5; ++i) {
+                std::snprintf(buf, sizeof buf, "%s%s held %.0f waited %.0f ms (%llu calls)", i ? ", " : "",
+                              lock_threads[i].name, lock_threads[i].hold_ms, lock_threads[i].wait_ms,
+                              static_cast<unsigned long long>(lock_threads[i].calls));
+                a += buf;
+            }
+            for (size_t i = 0; i < lock_fns.size() && i < 8; ++i) {
+                std::snprintf(buf, sizeof buf, "%s%s %.1f ms/%llu", i ? ", " : "", lock_fns[i].name, lock_fns[i].hold_ms,
+                              static_cast<unsigned long long>(lock_fns[i].calls));
+                b += buf;
+            }
+            out("GL lock in %.1fs | threads: %s | functions: %s", dt, a.c_str(), b.c_str());
+        }
+        if (g_capturing) {
+            for (const auto& u : lock_threads) {
+                g_sums.lock_threads[u.name] += u.hold_ms;
+                g_sums.lock_thread_wait[u.name] += u.wait_ms;
+            }
+            for (const auto& u : lock_fns) g_sums.lock_fns[u.name] += u.hold_ms;
+            g_sums.reports += 1;
+            g_sums.frames += static_cast<double>(f.n);
+            g_sums.cpu += proc;
+            g_sums.gpu += g3d;
+            g_sums.lock_ms += ms(dlock);
+            g_sums.swap_ms += ms(dtime[kSwap]);
+            g_sums.compiles += dcount[kShaderCompile];
+            g_sums.links += dcount[kShaderLink];
+            g_sums.compile_ms += ms(dtime[kShaderCompile] + dtime[kShaderLink] + dtime[kProgramBinary]);
+            g_sums.astc += dcount[kAstc];
+            g_sums.astc_ms += ms(dtime[kAstc]);
+            for (const auto& th : threads) g_sums.threads[th.name] += th.pct;
+            if (ms(t - g_capture_t0) / 1000.0 >= capture_len) end_capture_locked("timed");
+        } else if (!auto_started && capture_at >= 0 && g_first_frame &&
+                   ms(t - g_first_frame) / 1000.0 >= capture_at) {
+            auto_started = true;
+            start_capture_locked();
+        }
+
+        char b[512];
+        std::string text;
+        std::snprintf(b, sizeof b, "%.0f fps  %.1f ms (p95 %.1f, max %.0f)\n", static_cast<double>(f.n) / dt, f.avg,
+                      f.p95, f.max);
+        text += b;
+        std::snprintf(b, sizeof b, "CPU %.0f%%   GPU %s\n", proc, have_gpu ? (std::to_string(static_cast<int>(g3d)) + "%").c_str() : "n/a");
+        text += b;
+        std::snprintf(b, sizeof b, "swap %.1f  lock %.1f ms/f  shaders %llu  astc %llu\n", ms(dtime[kSwap]) / nf,
+                      ms(dlock) / nf, static_cast<unsigned long long>(dcount[kShaderCompile] + dcount[kShaderLink]),
+                      static_cast<unsigned long long>(dcount[kAstc]));
+        text += b;
+        for (size_t i = 0; i < threads.size() && i < 4; ++i) {
+            std::snprintf(b, sizeof b, "%.24s %.0f%%\n", threads[i].name.c_str(), threads[i].pct);
+            text += b;
+        }
+        std::snprintf(b, sizeof b, "%dx%d -> %dx%d  %s%s", g_app_w, g_app_h, g_win_w, g_win_h,
+                      std::getenv("WINAPK_ANGLE_BACKEND") ? std::getenv("WINAPK_ANGLE_BACKEND") : "vulkan",
+                      g_capturing ? "  [capturing F8]" : "");
+        text += b;
+        g_text = text;
+        ++g_text_version;
+    }
+}
+
+// ---- WINAPK_PERF_SPIKES=<ms>: what Unity's main thread did during each long frame ----
+// A thread samples the main thread every 2 ms into a ring (time, rip, the top
+// of its stack); each frame longer than <ms> (frame() notes it) gets its own
+// samples written out, "spike <n> <ms>\t<places>" per sample, to
+// WINAPK_PERF_FILE.spikes or logs\perf.spikes: the stalls alone, not mixed
+// with smooth frames as F7's ten seconds are.
+double spike_ms() {
+    static const double v = [] {
+        // On with WINAPK_PERF at 150 ms unless set (0: off).
+        const char* e = std::getenv("WINAPK_PERF_SPIKES");
+        return e ? std::atof(e) : 150.0;
+    }();
+    return v;
+}
+
+constexpr size_t kSpikeRing = 4096, kSpikeDepth = 256;
+struct SpikeSample {
+    uint64_t t, rip;
+    size_t n;
+    uint64_t stack[kSpikeDepth];
+};
+std::mutex g_spike_lock;
+std::vector<std::pair<uint64_t, uint64_t>> g_spikes;  // long frames not written yet: [start, end] ticks
+
+DWORD WINAPI spike_sampler(void*) {
+    HANDLE target = nullptr;
+    while (!target) {  // Unity's main thread, once it has its name
+        HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+        if (snap != INVALID_HANDLE_VALUE) {
+            THREADENTRY32 te;
+            te.dwSize = sizeof te;
+            for (BOOL ok = Thread32First(snap, &te); ok && !target; ok = Thread32Next(snap, &te)) {
+                if (te.th32OwnerProcessID != GetCurrentProcessId()) continue;
+                HANDLE h = OpenThread(THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_LIMITED_INFORMATION, FALSE,
+                                      te.th32ThreadID);
+                if (!h) continue;
+                const std::string n = thread_name(h, te.th32ThreadID);
+                if (n.rfind("0xdd", 0) == 0 || n == "UnityMain") target = h;
+                else CloseHandle(h);
+            }
+            CloseHandle(snap);
+        }
+        if (!target) Sleep(1000);
+    }
+    const char* pf = std::getenv("WINAPK_PERF_FILE");
+    const std::string path = pf ? std::string(pf) + ".spikes" : "logs\\perf.spikes";
+    out("spike sampler on: frames over %.0f ms -> %s", spike_ms(), path.c_str());
+    std::vector<SpikeSample> ring(kSpikeRing);
+    size_t next = 0, count = 0;
+    std::vector<Region> cache;
+    int written = 0;
+    for (;;) {
+        SpikeSample& s = ring[next];
+        s.n = 0;
+        s.rip = 0;
+        if (SuspendThread(target) != static_cast<DWORD>(-1)) {
+            CONTEXT c{};
+            c.ContextFlags = CONTEXT_CONTROL;
+            if (GetThreadContext(target, &c)) {
+                s.rip = c.Rip;
+                MEMORY_BASIC_INFORMATION mbi{};
+                if (VirtualQuery(reinterpret_cast<const void*>(c.Rsp), &mbi, sizeof mbi) && mbi.State == MEM_COMMIT) {
+                    const auto* top = reinterpret_cast<const uint64_t*>(c.Rsp);
+                    const auto* end =
+                        reinterpret_cast<const uint64_t*>(static_cast<const char*>(mbi.BaseAddress) + mbi.RegionSize);
+                    s.n = std::min<size_t>(static_cast<size_t>(end - top), kSpikeDepth);
+                    std::memcpy(s.stack, top, s.n * sizeof(uint64_t));
+                }
+            }
+            ResumeThread(target);
+        }
+        s.t = ticks();
+        next = (next + 1) % kSpikeRing;
+        count = std::min(count + 1, kSpikeRing);
+        std::vector<std::pair<uint64_t, uint64_t>> due;
+        {
+            std::lock_guard<std::mutex> hold(g_spike_lock);
+            for (auto it = g_spikes.begin(); it != g_spikes.end();) {
+                if (it->second <= s.t) {
+                    due.push_back(*it);
+                    it = g_spikes.erase(it);
+                } else {
+                    ++it;
+                }
+            }
+        }
+        if (!due.empty()) {
+            if (FILE* f = std::fopen(path.c_str(), "a")) {
+                for (const auto& d : due) {
+                    ++written;
+                    const double len = ms(d.second - d.first);
+                    for (size_t k = 0; k < count; ++k) {
+                        const SpikeSample& sm = ring[(next + kSpikeRing - count + k) % kSpikeRing];
+                        if (!sm.rip || sm.t < d.first || sm.t > d.second) continue;
+                        std::string chain = where(sm.rip, cache);
+                        int found = 0;
+                        for (size_t j = 0; j < sm.n && found < 12; ++j) {
+                            const std::string w = where(sm.stack[j], cache);
+                            if (w.empty()) continue;
+                            chain += " " + w;
+                            ++found;
+                        }
+                        std::fprintf(f, "spike %d %.0f\t%s\n", written, len, chain.c_str());
+                    }
+                }
+                std::fclose(f);
+            }
+        }
+        Sleep(2);
+    }
+}
+
+}  // namespace
+
+bool on() { return mode() != 0; }
+
+namespace {
+std::atomic<uint64_t> g_app_swaps{0};
+}
+void count_swap() { g_app_swaps.fetch_add(1, std::memory_order_relaxed); }
+uint64_t app_swaps() { return g_app_swaps.load(std::memory_order_relaxed); }
+
+uint64_t ticks() {
+    LARGE_INTEGER t;
+    QueryPerformanceCounter(&t);
+    return static_cast<uint64_t>(t.QuadPart);
+}
+
+void add(Counter c, uint64_t dt) {
+    g_time[c].fetch_add(dt, std::memory_order_relaxed);
+    g_count[c].fetch_add(1, std::memory_order_relaxed);
+}
+
+void frame(int app_w, int app_h, int win_w, int win_h) {
+    if (!on()) return;
+    static std::once_flag started;
+    std::call_once(started, [] {
+        g_overlay = mode() == 2;
+        std::thread(reporter).detach();
+        if (spike_ms() > 0) {
+            if (HANDLE h = CreateThread(nullptr, 1 << 20, spike_sampler, nullptr, 0, nullptr)) CloseHandle(h);
+        }
+        out("on: F9 overlay, F8 capture (WINAPK_PERF_CAPTURE=%s s)",
+            std::getenv("WINAPK_PERF_CAPTURE") ? std::getenv("WINAPK_PERF_CAPTURE") : "30");
+    });
+    const uint64_t t = ticks();
+    std::lock_guard<std::mutex> hold(g_lock);
+    if (g_last_frame) {
+        const float d = static_cast<float>(ms(t - g_last_frame));
+        g_frames.push_back(d);
+        if (spike_ms() > 0 && d > spike_ms()) {
+            std::lock_guard<std::mutex> hold_spikes(g_spike_lock);
+            if (g_spikes.size() < 64) g_spikes.push_back({g_last_frame, t});
+        }
+        if (g_capturing) g_capture.push_back(d);
+    } else {
+        g_first_frame = t;
+    }
+    g_last_frame = t;
+    g_app_w = app_w;
+    g_app_h = app_h;
+    g_win_w = win_w;
+    g_win_h = win_h;
+}
+
+void note_renderer(const char* renderer, const char* version) {
+    if (!on()) return;
+    std::lock_guard<std::mutex> hold(g_lock);
+    if (!g_renderer.empty()) return;
+    g_renderer = renderer ? renderer : "?";
+    g_version = version ? version : "?";
+    out("renderer: %s | %s", g_renderer.c_str(), g_version.c_str());
+}
+
+bool overlay_shown() { return on() && g_overlay.load(std::memory_order_relaxed); }
+
+std::string overlay_text(unsigned* version) {
+    std::lock_guard<std::mutex> hold(g_lock);
+    *version = g_text_version;
+    return g_text;
+}
+
+bool key(unsigned vk) {
+    if (!on()) return false;
+    if (vk == VK_F9) {
+        g_overlay = !g_overlay.load();
+        return true;
+    }
+    if (vk == VK_F7) {
+        static std::atomic<bool> busy{false};
+        if (!busy.exchange(true)) {
+            if (HANDLE t = CreateThread(nullptr, 1 << 20, [](void*) -> DWORD {
+                    sampler(nullptr);
+                    return 0;
+                }, nullptr, 0, nullptr))
+                CloseHandle(t);
+            // One run at a time; another F7 after it ends.
+            std::thread([] {
+                Sleep(12000);
+                busy = false;
+            }).detach();
+        }
+        return true;
+    }
+    if (vk == VK_F8) {
+        std::lock_guard<std::mutex> hold(g_lock);
+        if (g_capturing) end_capture_locked("F8");
+        else start_capture_locked();
+        return true;
+    }
+    return false;
+}
