@@ -596,3 +596,15 @@ EXPORT uint64_t flow_litmus(uint64_t rounds) {
     pthread_join(t, 0);
     return both_zero;
 }
+
+// A loop calling a write barrier of another library through a pointer, with
+// values kept in registers across the calls (x19-x22 hold i, n, acc, arr).
+typedef void (*StoreBarrier)(void* obj, void** field, void* value);
+EXPORT uint64_t flow_store_loop(StoreBarrier store, void** arr, uint64_t n) {
+    uint64_t acc = 7;
+    for (uint64_t i = 0; i < n; ++i) {
+        store(0, &arr[i], (void*)(i * 3 + 1));
+        acc = acc * 31 + (uint64_t)arr[i] + i;
+    }
+    return acc;
+}
