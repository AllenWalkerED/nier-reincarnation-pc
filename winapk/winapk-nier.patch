+// Alt+Enter: borderless over the monitor, or back to the window it was (a
+// window of the phone's shape when the game started full screen). The app
+// follows the new size, as when the user resizes the window.
+void set_fullscreen(HWND hwnd, bool on) {
+    if (on == g_fullscreen) return;
+    g_fitting = true;  // the passing sizes of the style change do not reach the app
+    if (on) {
+        if (IsZoomed(hwnd)) ShowWindow(hwnd, SW_RESTORE);
+        GetWindowRect(hwnd, &g_windowed_rect);
+        MONITORINFO mi{};
+        mi.cbSize = sizeof(mi);
+        GetMonitorInfoW(MonitorFromWindow(hwnd, MONITOR_DEFAULTTONEAREST), &mi);
+        g_fullscreen = true;
+        SetWindowLongPtrW(hwnd, GWL_STYLE, (GetWindowLongPtrW(hwnd, GWL_STYLE) & ~WS_OVERLAPPEDWINDOW) | WS_POPUP);
+        const RECT m = mi.rcMonitor;
+        SetWindowPos(hwnd, HWND_TOP, m.left, m.top, m.right - m.left, m.bottom - m.top,
+                     SWP_FRAMECHANGED | SWP_NOOWNERZORDER | SWP_SHOWWINDOW);
+    } else {
+        g_fullscreen = false;
+        SetWindowLongPtrW(hwnd, GWL_STYLE, (GetWindowLongPtrW(hwnd, GWL_STYLE) & ~WS_POPUP) | kStyle);
+        if (g_windowed_rect.right > g_windowed_rect.left) {
+            const RECT& r = g_windowed_rect;
+            SetWindowPos(hwnd, nullptr, r.left, r.top, r.right - r.left, r.bottom - r.top,
+                         SWP_FRAMECHANGED | SWP_NOZORDER | SWP_NOOWNERZORDER);
+        } else {
+            SetWindowPos(hwnd, nullptr, 0, 0, 0, 0, SWP_FRAMECHANGED | SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER);
+            const HMONITOR mon = MonitorFromWindow(hwnd, MONITOR_DEFAULTTONEAREST);
+            fit_window(hwnd, mon, window_dpi(hwnd), nullptr, true);
+        }
+    }
+    g_fitting = false;
+    follow_client(hwnd);
+    place_game_child(hwnd);
+    InvalidateRect(hwnd, nullptr, FALSE);
+    std::fprintf(stderr, "[win.apk] Alt+Enter: %s\n", on ? "full screen" : "window");
+}
