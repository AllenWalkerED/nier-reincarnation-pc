+    static const bool keep_reading = [] {
+        const char* e = std::getenv("WINAPK_FRAMEWORK_READBACK");
+        return e && e[0] == '1';
+    }();
+    if (keep_reading) return false;
+    const unsigned long long last = g_direct_last_ms.load();
+    return last != 0 && GetTickCount64() - last < 500;
