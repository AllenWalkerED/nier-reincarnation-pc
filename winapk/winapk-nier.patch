+// ---- Direct3D 11 diagnostics (WINAPK_D3D11_DEBUG=1) ----
+// ANGLE makes its device with the debug layer (Windows' Graphics Tools); a
+// thread passes the layer's warnings and errors to the log, and when the GPU
+// gives up on the device (a hang the driver reset, TDR) it logs why and the
+// last draws the app made (gl_note_draw) before it.
+bool d3d11_debug() {
+    static const bool on = std::getenv("WINAPK_D3D11_DEBUG") != nullptr;
+    return on;
+}
+
+struct DrawNote {
+    unsigned long long seq;
+    unsigned long thread;
+    const char* what;
+    GLenum mode;
+    GLsizei count, instances;
+    GLint program, framebuffer;
+};
+constexpr size_t kDrawRing = 128;
+DrawNote g_draws[kDrawRing];
+std::atomic<unsigned long long> g_draw_seq{0};
+
+void dump_draws() {
+    const unsigned long long last = g_draw_seq.load();
+    const unsigned long long first = last > kDrawRing ? last - kDrawRing : 0;
+    std::fprintf(stderr, "[win.apk] D3D11: the app's last %llu draws before the device was lost (oldest first):\n",
+                 last - first);
+    for (unsigned long long s = first; s < last; ++s) {
+        const DrawNote& d = g_draws[s % kDrawRing];
+        if (std::strcmp(d.what, "swap") == 0) {
+            std::fprintf(stderr, "[win.apk]   #%llu [%lu] eglSwapBuffers\n", d.seq, d.thread);
+        } else {
+            std::fprintf(stderr, "[win.apk]   #%llu [%lu] %s mode=0x%x count=%d instances=%d program=%d fbo=%d\n", d.seq,
+                         d.thread, d.what, d.mode, d.count, d.instances, d.program, d.framebuffer);
+        }
+    }
+}
+
+const char* removed_reason(HRESULT r) {
+    switch (static_cast<unsigned long>(r)) {
+        case 0x887A0006: return "DXGI_ERROR_DEVICE_HUNG (a command took too long: the driver reset the GPU)";
+        case 0x887A0005: return "DXGI_ERROR_DEVICE_REMOVED";
+        case 0x887A0007: return "DXGI_ERROR_DEVICE_RESET (a bad command)";
+        case 0x887A0020: return "DXGI_ERROR_DRIVER_INTERNAL_ERROR";
+        case 0x887A0001: return "DXGI_ERROR_INVALID_CALL";
+        default: return "another error";
+    }
+}
+
+// Passes the stored debug messages on, each kind (message id) 5 times, then
+// every 1000th. Returns how many there were.
+size_t drain(ID3D11InfoQueue* q, std::map<int, unsigned>& seen) {
+    const UINT64 n = q->GetNumStoredMessagesAllowedByRetrievalFilter();
+    std::vector<char> buf;
+    for (UINT64 i = 0; i < n; ++i) {
+        SIZE_T len = 0;
+        if (FAILED(q->GetMessage(i, nullptr, &len)) || len == 0) continue;
+        buf.resize(len);
+        auto* m = reinterpret_cast<D3D11_MESSAGE*>(buf.data());
+        if (FAILED(q->GetMessage(i, m, &len))) continue;
+        const unsigned times = ++seen[m->ID];
+        if (times > 5 && times % 1000 != 0) continue;
+        static const char* kSeverity[] = {"CORRUPTION", "ERROR", "WARNING", "INFO", "MESSAGE"};
+        std::fprintf(stderr, "[win.apk] D3D11 debug: %s #%d%s: %.*s\n",
+                     m->Severity <= D3D11_MESSAGE_SEVERITY_MESSAGE ? kSeverity[m->Severity] : "?", m->ID,
+                     times > 5 ? " (repeated)" : "", static_cast<int>(m->DescriptionByteLength), m->pDescription);
+    }
+    q->ClearStoredMessages();
+    return static_cast<size_t>(n);
+}
+
+// The debug layer ends the process with exception 0x87D (0x87A from DXGI)
+// when it finds misuse it calls CORRUPTION, such as two threads in one device
+// context at once. Before that: the message (the exception's parameters, as
+// OutputDebugString's: a length and the text) and the queue's stored ones.
+ID3D11InfoQueue* g_debug_queue = nullptr;
+std::atomic<bool> g_debug_reported{false};
+
+void print_message_param(const EXCEPTION_RECORD* r) {
+    for (DWORD i = 0; i < r->NumberParameters && i < EXCEPTION_MAXIMUM_PARAMETERS; ++i)
+        std::fprintf(stderr, "[win.apk] D3D11 debug:   parameter %lu = 0x%llx\n", i,
+                     static_cast<unsigned long long>(r->ExceptionInformation[i]));
+    for (DWORD i = 0; i < r->NumberParameters && i < EXCEPTION_MAXIMUM_PARAMETERS; ++i) {
+        const auto* p = reinterpret_cast<const char*>(r->ExceptionInformation[i]);
+        MEMORY_BASIC_INFORMATION mbi{};
+        if (!p || !VirtualQuery(p, &mbi, sizeof(mbi)) || mbi.State != MEM_COMMIT || (mbi.Protect & PAGE_NOACCESS) ||
+            (mbi.Protect & PAGE_GUARD))
+            continue;
+        const size_t room = static_cast<size_t>(static_cast<const char*>(mbi.BaseAddress) + mbi.RegionSize - p);
+        size_t n = 0;
+        while (n < room && n < 2048 && p[n] >= 0x09 && static_cast<unsigned char>(p[n]) < 0x7f) ++n;
+        if (n >= 8) std::fprintf(stderr, "[win.apk] D3D11 debug:   text: %.*s\n", static_cast<int>(n), p);
+    }
+}
+
+LONG CALLBACK on_debug_layer_exception(EXCEPTION_POINTERS* e) {
+    const DWORD code = e->ExceptionRecord->ExceptionCode;
+    if (code != 0x87D && code != 0x87A) return EXCEPTION_CONTINUE_SEARCH;
+    if (!g_debug_reported.exchange(true)) {
+        std::fprintf(stderr, "[win.apk] D3D11 debug: exception 0x%lx on thread %lu: the debug layer ends the process\n",
+                     code, GetCurrentThreadId());
+        print_message_param(e->ExceptionRecord);
+        // "... 10340 and 18372 are the implicated thread ids.": both stacks.
+        unsigned long a = 0, b = 0;
+        for (DWORD i = 0; i < e->ExceptionRecord->NumberParameters; ++i) {
+            const auto* text = reinterpret_cast<const char*>(e->ExceptionRecord->ExceptionInformation[i]);
+            MEMORY_BASIC_INFORMATION mbi{};
+            if (!text || !VirtualQuery(text, &mbi, sizeof(mbi)) || mbi.State != MEM_COMMIT) continue;
+            if (const char* at = std::strstr(text, " are the implicated thread ids")) {
+                // Back over "<a> and <b>".
+                const char* p = at;
+                while (p > text && p[-1] >= '0' && p[-1] <= '9') --p;
+                p -= std::strlen(" and ");
+                while (p > text && p[-1] >= '0' && p[-1] <= '9') --p;
+                if (p > text) std::sscanf(p, "%lu and %lu", &a, &b);
+                break;
+            }
+        }
+        const unsigned long self = GetCurrentThreadId();
+        winapk::host::log_thread_stack(self, e->ContextRecord);
+        for (unsigned long other : {a, b}) {
+            if (other && other != self) winapk::host::log_thread_stack(other, nullptr);
+        }
+        if (g_debug_queue) {
+            std::map<int, unsigned> seen;
+            drain(g_debug_queue, seen);
+        }
+        dump_draws();
+        std::fflush(stderr);
+    }
+    return EXCEPTION_CONTINUE_SEARCH;
+}
