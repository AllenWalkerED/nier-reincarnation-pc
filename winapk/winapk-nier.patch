+// WINAPK_GL_FLT_MAX_FIX=0 turns off fix_flt_max_literals and the binary tag.
+bool fix_flt_max_on() {
+    static const bool on = [] {
+        const char* e = std::getenv("WINAPK_GL_FLT_MAX_FIX");
+        return !(e && e[0] == '0');
+    }();
+    return on;
+}
+// Program binaries the app keeps (Unity's UnityShaderCache) carry a tag on
+// Vulkan: binaries linked before fix_flt_max_literals (guest_glShaderSource),
+// or on the other backend, have none and fail to load, so the app builds
+// them again from source once and keeps the new ones. The length the app
+// is told (GL_PROGRAM_BINARY_LENGTH) includes the tag.
+constexpr char kBinaryTag[8] = {'w', 'a', 'p', 'k', 'v', 'k', 'f', '1'};
+bool tag_binaries() { return winapk::host::gl_on_vulkan() && fix_flt_max_on(); }
+void get_program_binary(GLuint program, GLsizei bufSize, GLsizei *length, GLenum *binaryFormat, void *binary) {
+    if (!tag_binaries()) {
+        glGetProgramBinary(program, bufSize, length, binaryFormat, binary);
+        return;
+    }
+    GLint real = 0;
+    glGetProgramiv(program, GL_PROGRAM_BINARY_LENGTH, &real);
+    if (real <= 0 || bufSize < real + static_cast<GLsizei>(sizeof kBinaryTag)) {
+        glGetProgramBinary(program, bufSize, length, binaryFormat, binary);  // untagged: built again next time
+        return;
+    }
+    GLsizei got = 0;
+    glGetProgramBinary(program, real, &got, binaryFormat, binary);
+    if (got > 0) {
+        std::memcpy(static_cast<char*>(binary) + got, kBinaryTag, sizeof kBinaryTag);
+        got += static_cast<GLsizei>(sizeof kBinaryTag);
+    }
+    if (length) *length = got;
+}
+void program_binary(GLuint program, GLenum binaryFormat, const void *binary, GLsizei length) {
+    if (!tag_binaries()) {
+        glProgramBinary(program, binaryFormat, binary, length);
+        return;
+    }
+    const GLsizei n = static_cast<GLsizei>(sizeof kBinaryTag);
+    const bool tagged = binary && length >= n && std::memcmp(static_cast<const char*>(binary) + length - n, kBinaryTag, n) == 0;
+    // An untagged binary loads as an empty one: the program is not linked
+    // and the app compiles it.
+    glProgramBinary(program, binaryFormat, binary, tagged ? length - n : 0);
+}
+WINAPK_GUEST_ABI void guest_glGetProgramBinary(GLuint program, GLsizei bufSize, GLsizei *length, GLenum *binaryFormat, void *binary) { get_program_binary(program, bufSize, length, binaryFormat, binary); }
